// ─── POST Resolve: Add Driver (เพิ่มคนขับให้รถ) ───
//    ⚠️ แก้บั๊กรอบใหญ่: เดิมพยายามแกล้งสร้างแถวสแกน (PayrollScanRows) แล้วเรียก
//    processDay() ให้ไปประมวลผลใหม่ทั้งวัน โดยหวังว่าตัวจับคู่อัตโนมัติ (เช็คเวลา,
//    เช็ค VehicleDriverMap, เช็ค shiftCode ฯลฯ) จะไปสร้างเที่ยวรถให้เอง — วิธีนี้เปราะบาง
//    มาก มีจุดพังได้หลายจุด (ตามที่เจอมาแล้ว 3 รอบ) และไม่ตรงกับที่ "เพิ่มรถเข้ารอบ"
//    ทำอยู่แล้ว (เรียก PayrollEngine.addVehicleTrip สร้างเที่ยวรถตรง ๆ ทันที ไม่พึ่งการ
//    ประมวลผลใหม่เลย) ตอนนี้เปลี่ยนมาใช้วิธีเดียวกัน: สร้าง/อัปเดตเที่ยวรถตรง ๆ
//    แล้วย้ายพนักงานที่ค้างอยู่ในกลุ่มนี้เข้าเที่ยวทันที (แบบเดียวกับปุ่ม "+ เพิ่มพนักงาน")
router.post('/unassigned-riders/resolve-add-driver', async (req, res) => {
    try {
        const { vehicleId, operationDate, shiftTypeId, cardId, userId } = req.body;

        if (!vehicleId || !operationDate || !shiftTypeId || !cardId) {
            return badRequest(res, 'Missing required fields: vehicleId, operationDate, shiftTypeId, cardId');
        }

        // ✅ 1. ตรวจสอบว่าคนขับนี้เป็นคนขับของรถคันนี้จริง (จาก VehicleDriverMap — ตารางเดียวกับที่
        //    payrollEngine.js ใช้จับคู่รถ/คนขับตอนประมวลผลไฟล์สแกนจริง เพื่อให้ผลตรงกันเสมอ)
        const checkDriver = await executeQuery(`
            SELECT vdm.vehicleId FROM VehicleDriverMap vdm
            INNER JOIN Vehicles v ON v.id = vdm.vehicleId
            WHERE vdm.vehicleId = @vehicleId AND vdm.cardId = @cardId
              AND vdm.isDeleted = 0 AND v.status = 'active'
        `, { vehicleId, cardId });

        if (checkDriver.recordset.length === 0) {
            return badRequest(res, 'คนขับคนนี้ยังไม่ได้ถูกกำหนดให้รถคันนี้ในหน้า "กำหนดคนขับรถ" กรุณาไปเพิ่มที่นั่นก่อน');
        }

        // ✅ 2. หาเที่ยวรถของ (วันที่, รอบ, รถ) นี้ก่อน — ถ้ามีอยู่แล้ว (เช่น ถูกสร้างจากไฟล์สแกน
        //    แต่ driverCardId ยังว่าง) ให้แค่เติมคนขับเข้าไป ถ้ายังไม่มีเลยให้สร้างใหม่พร้อมคนขับทันที
        const tripResult = await executeQuery(`
            SELECT id FROM PayrollVehicleTrips
            WHERE operationDate = @operationDate AND shiftTypeId = @shiftTypeId
              AND vehicleId = @vehicleId AND status != 'deleted'
        `, { operationDate, shiftTypeId, vehicleId });

        let tripId;
        if (tripResult.recordset.length > 0) {
            tripId = tripResult.recordset[0].id;
            await PayrollEngine.updateAssignment(tripId, { driverCardId: cardId, userId: userId || 'admin' });
        } else {
            const createdTrip = await PayrollEngine.addVehicleTrip({
                operationDate,
                shiftTypeId: parseInt(shiftTypeId),
                vehicleId: parseInt(vehicleId),
                driverCardId: cardId,
                createdBy: userId || 'admin'
            });
            tripId = createdTrip.id;
        }

        // ✅ 3. ย้ายพนักงานที่ค้างอยู่ในกลุ่มนี้ (วันเดียวกัน รอบเดียวกัน รอรถคันนี้) เข้าเที่ยวที่เพิ่งสร้าง/อัปเดตทันที
        //    ใช้ resolveUnassignedRider ตัวเดียวกับที่ปุ่ม "+ เพิ่มพนักงาน" ใช้ ไม่ต้องพึ่ง processDay เลย
        const pendingRiders = await executeQuery(`
            SELECT id FROM PayrollUnassignedRiders
            WHERE operationDate = @operationDate AND shiftTypeId = @shiftTypeId
              AND expectedVehicleId = @vehicleId AND status = 'pending'
        `, { operationDate, shiftTypeId, vehicleId });

        let movedCount = 0;
        for (const row of pendingRiders.recordset) {
            try {
                await PayrollEngine.resolveUnassignedRider(row.id, vehicleId, userId || 'admin');
                movedCount++;
            } catch (moveErr) {
                console.warn(`⚠️ resolve-add-driver: ย้ายพนักงาน (unassignedId=${row.id}) เข้ารถไม่สำเร็จ:`, moveErr.message);
            }
        }

        success(res, { tripId, movedCount }, `เพิ่มคนขับสำเร็จ${movedCount > 0 ? ` และย้ายพนักงาน ${movedCount} คนเข้ารถแล้ว` : ''}`);
    } catch (err) {
        console.error('❌ POST /api/payroll/unassigned-riders/resolve-add-driver error:', err);
        error(res, err.message);
    }
});

// ─── POST Resolve: Move (ย้ายพนักงานไปรถอื่น) ───
// ⚠️ แก้บั๊ก: เดิมแค่ UPDATE expectedVehicleId + status ของแถว PayrollUnassignedRiders
//    แล้วเรียก PayrollEngine.processDay(operationDate, {}, {}) โดยส่ง employeeMap/driverMap
//    เป็น {} ว่างเปล่า (ผิด signature — processDay ต้องการแผนที่จริงจาก DB) และในทางปฏิบัติ
//    ก็ไม่มีผลอะไรเลยอยู่ดี เพราะแถว PayrollScanRows ของวันนั้นถูก mark 'matched' ไปแล้ว
//    ตั้งแต่ import ครั้งแรก — ผลคือพนักงานที่ "ย้าย" หายไปจาก banner "ยังไม่ถูกจัดขึ้นรถ"
//    (เพราะ status ไม่ใช่ pending แล้ว) แต่ไม่เคยถูกสร้างแถวจริงใน PayrollTripEmployees
//    ของรถปลายทางเลย คือหายไปเฉยๆ ไม่ได้ถูกจัดรถจริง
//    ตอนนี้เปลี่ยนมาใช้ PayrollEngine.resolveUnassignedRider() ตัวเดียวกับปุ่ม
//    "+ เพิ่มพนักงาน" และ resolve-add-driver ด้านบน เพื่อสร้างแถวจริงในรถปลายทางทันที
router.post('/unassigned-riders/resolve-move', async (req, res) => {
    try {
        const { vehicleId, operationDate, shiftTypeId, targetVehicleId, userId } = req.body;

        if (!operationDate || !shiftTypeId || !targetVehicleId) {
            return badRequest(res, 'Missing required fields');
        }

        // ✅ 1. ตรวจสอบว่ารถปลายทางมีเที่ยวอยู่แล้วในรอบนี้ (ถ้ายังไม่มีเที่ยว ยังย้ายเข้าไปไม่ได้)
        const targetTrip = await executeQuery(`
            SELECT id FROM PayrollVehicleTrips 
            WHERE operationDate = @operationDate 
            AND shiftTypeId = @shiftTypeId 
            AND vehicleId = @targetVehicleId
            AND status != 'deleted'
        `, { operationDate, shiftTypeId, targetVehicleId });

        if (targetTrip.recordset.length === 0) {
            return badRequest(res, 'รถปลายทางยังไม่มีเที่ยวรถในรอบนี้ กรุณา "เพิ่มรถเข้ารอบ" หรือ "เพิ่มคนขับ" ให้รถคันนั้นก่อน');
        }

        // ✅ 2. หาพนักงานที่รอย้ายจริง (วันเดียวกัน รอบเดียวกัน รอรถต้นทางคันนี้ และยัง pending)
        let query = `
            SELECT id FROM PayrollUnassignedRiders
            WHERE operationDate = @operationDate AND shiftTypeId = @shiftTypeId AND status = 'pending'
        `;
        const params = { operationDate, shiftTypeId };
        if (vehicleId) {
            query += ' AND expectedVehicleId = @vehicleId';
            params.vehicleId = vehicleId;
        } else {
            query += ' AND expectedVehicleId IS NULL';
        }

        const pendingRiders = await executeQuery(query, params);

        if (pendingRiders.recordset.length === 0) {
            return badRequest(res, 'ไม่พบพนักงานที่รอย้ายในกลุ่มนี้ (อาจถูกจัดการไปแล้ว)');
        }

        // ✅ 3. ย้ายทีละคนด้วย resolveUnassignedRider ตัวจริง (สร้างแถวใน PayrollTripEmployees
        //    ของรถปลายทาง + ปิดสถานะ pending) แทนการ UPDATE เฉยๆ แบบเดิม
        let movedCount = 0;
        const failures = [];
        for (const row of pendingRiders.recordset) {
            try {
                await PayrollEngine.resolveUnassignedRider(row.id, targetVehicleId, userId || 'admin');
                movedCount++;
            } catch (moveErr) {
                console.warn(`⚠️ resolve-move: ย้ายพนักงาน (unassignedId=${row.id}) ไม่สำเร็จ:`, moveErr.message);
                failures.push(moveErr.message);
            }
        }

        if (movedCount === 0) {
            return badRequest(res, failures[0] || 'ย้ายพนักงานไม่สำเร็จ');
        }

        success(res, { movedCount }, `ย้ายพนักงาน ${movedCount} คน ไปรถปลายทางสำเร็จ`);
    } catch (err) {
        console.error('❌ POST /api/payroll/unassigned-riders/resolve-move error:', err);
        error(res, err.message);
    }
});

// ─── PUT Ignore: ลบคนออกจากแบนเนอร์ "ยังไม่ถูกจัดขึ้นรถ" โดยไม่จัดรถให้ (เหมือน unmatched/:id/ignore) ───
router.put('/unassigned-riders/:id/ignore', async (req, res) => {
    try {
        const id = parseInt(req.params.id);
        if (isNaN(id)) {
            return badRequest(res, 'Invalid id');
        }
        const result = await PayrollEngine.ignoreUnassignedRider(id);
        success(res, result, 'ลบออกจากรายการแล้ว');
    } catch (err) {
        console.error('❌ PUT /api/payroll/unassigned-riders/:id/ignore error:', err);
        error(res, err.message);
    }
});

// ─── GET Vehicle Rates ───
router.get('/vehicle-rates', async (req, res) => {
    try {
        const { vehicleId, shiftCode, isActive } = req.query;
        let query = `
            SELECT vr.*, 
                   v.displayNumber, v.plate, v.driver,
                   st.shiftName
            FROM PayrollVehicleRates vr
            INNER JOIN Vehicles v ON vr.vehicleId = v.id
            LEFT JOIN PayrollShiftTypes st ON vr.shiftCode = st.shiftCode
            WHERE 1=1
        `;
        const params = {};

        if (vehicleId) { 
            query += ' AND vr.vehicleId = @vehicleId'; 
            params.vehicleId = parseInt(vehicleId); 
        }
        if (shiftCode) { 
            query += ' AND vr.shiftCode = @shiftCode'; 
            params.shiftCode = shiftCode; 
        }
        if (isActive !== undefined) { 
            query += ' AND vr.isActive = @isActive'; 
            params.isActive = isActive === 'true' ? 1 : 0; 
        }

        query += ' ORDER BY vr.vehicleId, vr.shiftCode, vr.tripCount';
        const result = await executeQuery(query, params);
        success(res, result.recordset);
    } catch (err) {
        console.error('❌ GET /api/payroll/vehicle-rates error:', err);
        error(res, err.message);
    }
});

// ─── POST Vehicle Rates ───
router.post('/vehicle-rates', async (req, res) => {
    try {
        const { vehicleId, shiftCode, tripCount, rate, effectiveDate, userId } = req.body;

        if (!vehicleId || !shiftCode || rate === undefined) {
            return badRequest(res, 'Missing required fields: vehicleId, shiftCode, rate');
        }

        const effectiveDateValue = effectiveDate || new Date().toISOString().split('T')[0];

        // ✅ 1. ปิดอันเก่า
        await executeQuery(`
            UPDATE PayrollVehicleRates SET 
                isActive = 0,
                updatedAt = GETDATE()
            WHERE vehicleId = @vehicleId 
            AND shiftCode = @shiftCode 
            AND tripCount = @tripCount
            AND isActive = 1
        `, { 
            vehicleId: parseInt(vehicleId), 
            shiftCode, 
            tripCount: tripCount || null 
        });

        // ✅ 2. เพิ่มอันใหม่
        const result = await executeQuery(`
            INSERT INTO PayrollVehicleRates (
                vehicleId, shiftCode, tripCount, rate, effectiveDate, isActive
            ) OUTPUT INSERTED.id
            VALUES (
                @vehicleId, @shiftCode, @tripCount, @rate, @effectiveDate, 1
            )
        `, {
            vehicleId: parseInt(vehicleId),
            shiftCode,
            tripCount: tripCount || null,
            rate: parseFloat(rate),
            effectiveDate: effectiveDateValue
        });

        const newId = result.recordset[0].id;

        // ✅ 3. Audit Log
        await executeQuery(`
            INSERT INTO PayrollAuditLogs (tableName, recordId, fieldName, newValue, action, userId)
            VALUES ('PayrollVehicleRates', @recordId, 'rate', @rate, 'INSERT', @userId)
        `, { recordId: newId, rate: parseFloat(rate), userId: userId || 'system' });

        const inserted = await executeQuery(
            `SELECT * FROM PayrollVehicleRates WHERE id = @id`,
            { id: newId }
        );

        success(res, inserted.recordset[0], 'บันทึกราคารถสำเร็จ');
    } catch (err) {
        console.error('❌ POST /api/payroll/vehicle-rates error:', err);
        error(res, err.message);
    }
});

// ─── DELETE Vehicle Rate ───
router.delete('/vehicle-rates/:id', async (req, res) => {
    try {
        const id = parseInt(req.params.id);
        if (isNaN(id)) {
            return badRequest(res, 'Invalid id');
        }

        await executeQuery(`
            UPDATE PayrollVehicleRates SET isActive = 0, updatedAt = GETDATE()
            WHERE id = @id
        `, { id });

        success(res, null, 'ลบราคารถสำเร็จ');
    } catch (err) {
        console.error('❌ DELETE /api/payroll/vehicle-rates/:id error:', err);
        error(res, err.message);
    }
});
module.exports = router;
