const path = require('path');
const fs = require('fs');
const os = require('os');

const { success, error, created, notFound, badRequest } = require('../utils/response');
const { executeQuery } = require('../db');  // ✅ เพิ่มบรรทัดนี้
const PayrollEngine = require('../services/payrollEngine');

// ─── Multer ───
// เก็บไฟล์อัปโหลดไว้ใน temp ของระบบ ไม่ใช่ใต้ api/ เพราะ nodemon จะเห็น
// การสร้าง/ลบไฟล์แล้ว restart server ระหว่างที่ผู้ใช้กำลังนำเข้า
const payrollUploadDir = path.join(os.tmpdir(), 'ga-dashboard-payroll-uploads');
if (!fs.existsSync(payrollUploadDir)) {
    fs.mkdirSync(payrollUploadDir, { recursive: true });
}

const upload = multer({
    dest: payrollUploadDir,
    fileFilter: (req, file, cb) => {
        const ext = path.extname(file.originalname).toLowerCase();
        if (ext === '.xlsx' || ext === '.xls') {
            cb(null, true);
        } else {
            cb(new Error('เฉพาะไฟล์ Excel (.xlsx, .xls) เท่านั้น'));
        }
    },
    limits: { fileSize: 10 * 1024 * 1024 }
});

// ─── 1. นำเข้า Excel ───
router.post('/import', upload.single('file'), async (req, res) => {
    try {
        if (!req.file) {
            return badRequest(res, 'กรุณาอัปโหลดไฟล์ Excel');
        }

        const filePath = req.file.path;
        const filename = req.file.originalname;
        const importedBy = req.body.importedBy || 'system';
        const sourceType = req.body.sourceType || 'employee_file';

        const result = await PayrollEngine.importExcel(filePath, filename, importedBy, sourceType);

        if (fs.existsSync(filePath)) {
            fs.unlinkSync(filePath);
        }

        success(res, result, 'นำเข้าไฟล์สำเร็จ');
    } catch (err) {
        console.error('❌ POST /api/payroll/import error:', err);
        if (req.file && fs.existsSync(req.file.path)) {
            fs.unlinkSync(req.file.path);
        }
        error(res, err.message);
    }
});
