router.get('/settings', async (req, res) => {
    try {
        const { type } = req.query;
        
        // ✅ ถ้ามี type=shift ให้ส่งเฉพาะ shiftTypes
        if (type === 'shift') {
            const result = await executeQuery(`
                SELECT * FROM PayrollShiftTypes ORDER BY displayOrder
            `);
            return success(res, result.recordset);
        }
        
        // ✅ ถ้ามี type=rate ให้ส่งเฉพาะ rates
        if (type === 'rate') {
            const result = await executeQuery(`
                SELECT * FROM PayrollRateSettings WHERE isActive = 1 ORDER BY shiftCode
            `);
            return success(res, result.recordset);
        }

        // ✅ ถ้าไม่มี type ให้ส่งทั้งสอง
        const shiftTypes = await executeQuery(`
            SELECT * FROM PayrollShiftTypes ORDER BY displayOrder
        `);
        const rates = await executeQuery(`
            SELECT * FROM PayrollRateSettings WHERE isActive = 1 ORDER BY shiftCode
        `);

        success(res, {
            shiftTypes: shiftTypes.recordset,
            rates: rates.recordset
        });
    } catch (err) {
        console.error('❌ GET /api/payroll/settings error:', err);
        error(res, err.message);
    }
});

// ─── 20a. เพิ่มรอบใหม่ (Custom Shift Type) ───
//    ⚠️ ต้อง insert คู่กัน 2 ตาราง: PayrollShiftTypes (metadata ของรอบ)
//    และ PayrollRateSettings (ราคาจริงที่ addVehicleTrip() ใช้ตอนคำนวณ —
//    ถ้า insert แค่ PayrollShiftTypes เฉยๆ รอบใหม่จะได้ fareUsed = 0 เสมอ)
router.post('/shift-types', async (req, res) => {
    try {
        const { shiftName, startTime, endTime, fareType, defaultRate } = req.body;

        if (!shiftName || !startTime || !endTime || !fareType) {
            return badRequest(res, 'Missing required fields: shiftName, startTime, endTime, fareType');
        }
        const allowedFareTypes = ['perHead', 'flatByVehicle', 'perTrip'];
        if (!allowedFareTypes.includes(fareType)) {
            return badRequest(res, `fareType ต้องเป็นหนึ่งใน: ${allowedFareTypes.join(', ')}`);
        }

        const rate = parseFloat(defaultRate) || 0;

        // ✅ สร้าง shiftCode อัตโนมัติ (ไม่ซ้ำ) จากชื่อรอบ + timestamp
        const slug = shiftName
            .trim()
            .toUpperCase()
            .replace(/[^A-Z0-9ก-๙]+/g, '_')
            .replace(/^_+|_+$/g, '')
            .slice(0, 30) || 'CUSTOM';
        const shiftCode = `${slug}_${Date.now()}`;

        const orderResult = await executeQuery(`
            SELECT ISNULL(MAX(displayOrder), 0) AS maxOrder FROM PayrollShiftTypes
        `);
        const displayOrder = (orderResult.recordset[0].maxOrder || 0) + 1;

        const shiftResult = await executeQuery(`
            INSERT INTO PayrollShiftTypes (
                shiftCode, shiftName, startTime, endTime, fareType, defaultRate, isActive, displayOrder
            )
            OUTPUT INSERTED.id
            VALUES (
                @shiftCode, @shiftName, @startTime, @endTime, @fareType, @defaultRate, 1, @displayOrder
            )
        `, { shiftCode, shiftName, startTime, endTime, fareType, defaultRate: rate, displayOrder });

        const shiftTypeId = shiftResult.recordset[0].id;

        await executeQuery(`
            INSERT INTO PayrollRateSettings (shiftCode, rateType, rate, effectiveFrom, isActive)
            VALUES (@shiftCode, @rateType, @rate, CAST(GETDATE() AS DATE), 1)
        `, { shiftCode, rateType: fareType, rate });

        created(res, { id: shiftTypeId, shiftCode, shiftName, startTime, endTime, fareType, defaultRate: rate, displayOrder }, 'สร้างรอบใหม่สำเร็จ');
    } catch (err) {
        console.error('❌ POST /api/payroll/shift-types error:', err);
        error(res, err.message);
    }
});

// ─── แก้ไขรอบ (ชื่อ และ/หรือ วิธีคิดราคา/อัตรา) ───
router.patch('/shift-types/:id', async (req, res) => {
    try {
        const id = parseInt(req.params.id);
        if (isNaN(id)) return badRequest(res, 'Invalid id');

        const { shiftName, fareType, defaultRate } = req.body || {};
        const hasShiftName = shiftName !== undefined && shiftName !== null && String(shiftName).trim() !== '';
        const hasFareType = fareType !== undefined && fareType !== null && String(fareType).trim() !== '';
        const hasDefaultRate = defaultRate !== undefined && defaultRate !== null && String(defaultRate).trim() !== '';

        if (!hasShiftName && !hasFareType && !hasDefaultRate) {
            return badRequest(res, 'ต้องระบุอย่างน้อยหนึ่งอย่าง: shiftName, fareType, defaultRate');
        }

        const existing = await executeQuery('SELECT * FROM PayrollShiftTypes WHERE id = @id', { id });
        const shift = existing.recordset[0];
        if (!shift) return notFound(res, 'Shift type not found');

        const updates = [];
        const params = { id };

        // ✅ เปลี่ยนชื่อ — จำกัดเฉพาะรอบที่สร้างเอง (built-in ห้ามเปลี่ยนชื่อ) เหมือนเดิม
        if (hasShiftName) {
            if (!/_\d{10,}$/.test(shift.shiftCode || '')) {
                return badRequest(res, 'แก้ไขชื่อได้เฉพาะรอบที่สร้างเอง');
            }
            updates.push('shiftName = @shiftName');
            params.shiftName = String(shiftName).trim();
        }

        // ✅ เปลี่ยนวิธีคิดราคา/อัตรา — ใช้ได้ทุกรอบ รวมถึง built-in (ตรงกับที่หน้าบ้านตั้งใจไว้)
        if (hasFareType) {
            const allowedFareTypes = ['perHead', 'flatByVehicle', 'perTrip'];
            if (!allowedFareTypes.includes(fareType)) {
                return badRequest(res, `fareType ต้องเป็นหนึ่งใน: ${allowedFareTypes.join(', ')}`);
            }
            updates.push('fareType = @fareType');
            params.fareType = fareType;
        }

        if (hasDefaultRate) {
            const rate = parseFloat(defaultRate);
            if (isNaN(rate) || rate < 0) return badRequest(res, 'defaultRate ต้องเป็นตัวเลขไม่ติดลบ');
            updates.push('defaultRate = @defaultRate');
            params.defaultRate = rate;
        }

        await executeQuery(`UPDATE PayrollShiftTypes SET ${updates.join(', ')} WHERE id = @id`, params);

        // ✅ Sync ไปที่ PayrollRateSettings ด้วย — นี่คือตารางที่ processFlatByVehicleShift
        //    ใช้ดึงราคาจริงตอนคำนวณ (ดู POST /shift-types ด้านบน) ถ้าไม่ sync ตรงนี้
        //    แก้ราคาในหน้าจอแล้วจะไม่มีผลกับการคำนวณจริง
        if (hasFareType || hasDefaultRate) {
            const finalFareType = hasFareType ? fareType : shift.fareType;
            const finalRate = hasDefaultRate ? parseFloat(defaultRate) : (shift.defaultRate || 0);

            await executeQuery(`
                UPDATE PayrollRateSettings SET isActive = 0
                WHERE shiftCode = @shiftCode AND isActive = 1
            `, { shiftCode: shift.shiftCode });

            await executeQuery(`
                INSERT INTO PayrollRateSettings (shiftCode, rateType, rate, effectiveFrom, isActive)
                VALUES (@shiftCode, @rateType, @rate, CAST(GETDATE() AS DATE), 1)
            `, { shiftCode: shift.shiftCode, rateType: finalFareType, rate: finalRate });
        }

        const updated = await executeQuery('SELECT * FROM PayrollShiftTypes WHERE id = @id', { id });
        success(res, updated.recordset[0], 'แก้ไขรอบสำเร็จ');
    } catch (err) {
        console.error('❌ PATCH /api/payroll/shift-types/:id error:', err);
        error(res, err.message);
    }
});

// ─── ลบรอบที่สร้างเอง (ต้องยังไม่ถูกใช้งาน) ───
router.delete('/shift-types/:id', async (req, res) => {
    try {
        const id = parseInt(req.params.id);
        if (isNaN(id)) return badRequest(res, 'Invalid id');

        const existing = await executeQuery('SELECT * FROM PayrollShiftTypes WHERE id = @id', { id });
        const shift = existing.recordset[0];
        if (!shift) return notFound(res, 'Shift type not found');
        if (!/_\d{10,}$/.test(shift.shiftCode || '')) return badRequest(res, 'ลบได้เฉพาะรอบที่สร้างเอง');

        const usage = await executeQuery(`
            SELECT
                (SELECT COUNT(*) FROM PayrollVehicleTrips WHERE shiftTypeId = @id) +
                (SELECT COUNT(*) FROM PayrollUnassignedRiders WHERE shiftTypeId = @id) AS total
        `, { id });
        if (usage.recordset[0]?.total > 0) {
            return badRequest(res, 'ลบรอบนี้ไม่ได้ เพราะมีรถหรือพนักงานถูกผูกกับรอบแล้ว');
        }

        await executeQuery('DELETE FROM PayrollRateSettings WHERE shiftCode = @shiftCode', { shiftCode: shift.shiftCode });
        await executeQuery('DELETE FROM PayrollShiftTypes WHERE id = @id', { id });
        success(res, { id }, 'ลบรอบสำเร็จ');
    } catch (err) {
        console.error('❌ DELETE /api/payroll/shift-types/:id error:', err);
        error(res, err.message);
    }
});
