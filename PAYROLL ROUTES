        const params = {};

        if (date) {
            query += ' AND operationDate = @date';
            params.date = date;
        }
        if (startDate && endDate) {
            query += ' AND operationDate BETWEEN @startDate AND @endDate';
            params.startDate = startDate;
            params.endDate = endDate;
        }
        if (status) {
            query += ' AND status = @status';
            params.status = status;
        }

        query += ' ORDER BY operationDate DESC';
        const result = await require('../db').executeQuery(query, params);
        success(res, result.recordset);
    } catch (err) {
        console.error('❌ GET /api/payroll/operation-days error:', err);
        error(res, err.message);
    }
});

// ─── 10. ดึง Vehicle Trips (✅ เพิ่ม) ───
router.get('/vehicle-trips', async (req, res) => {
    try {
        const { operationDate, startDate, endDate, vehicleId, status } = req.query;
        let query = `
            SELECT vt.*, st.shiftCode, st.shiftName, st.fareType as shiftFareType,
                   v.displayNumber, v.plate,
                   v.driver AS defaultDriverName,
                   de.name AS confirmedDriverName
            FROM PayrollVehicleTrips vt
            INNER JOIN PayrollShiftTypes st ON vt.shiftTypeId = st.id
            INNER JOIN Vehicles v ON vt.vehicleId = v.id
            LEFT JOIN Employees de ON vt.driverCardId COLLATE DATABASE_DEFAULT = de.cardId COLLATE DATABASE_DEFAULT AND de.isDriver = 1
            WHERE vt.status != 'deleted'
        `;
        const params = {};

        if (operationDate) {
            query += ' AND vt.operationDate = @operationDate';
            params.operationDate = operationDate;
        }
        if (startDate && endDate) {
            query += ' AND vt.operationDate BETWEEN @startDate AND @endDate';
            params.startDate = startDate;
            params.endDate = endDate;
        }
        if (vehicleId) {
            query += ' AND vt.vehicleId = @vehicleId';
            params.vehicleId = parseInt(vehicleId);
        }
        if (status) {
            query += ' AND vt.status = @status';
            params.status = status;
        }

        query += ' ORDER BY vt.operationDate DESC, st.displayOrder';
        const result = await require('../db').executeQuery(query, params);
        success(res, result.recordset);
    } catch (err) {
        console.error('❌ GET /api/payroll/vehicle-trips error:', err);
        error(res, err.message);
    }
});

