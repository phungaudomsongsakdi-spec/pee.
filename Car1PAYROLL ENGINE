    for (const row of pendingRows) {
        await executeQuery(`
            UPDATE PayrollScanRows SET processedStatus = 'matched'
            WHERE id = @id
        `, { id: row.id });
    }

    return {
        matched: newEmployees.length + newDrivers.length,
        unmatched: unmatched.length,
        warnings: []
    };
}
    // ─── CLASSIFY ROWS ───
    static async classifyRows(rows, employeeMap, driverMap) {
        const employees = [];
        const drivers = [];
        const unmatched = [];

        for (const row of rows) {
            const cardId = row.cardId ? row.cardId.trim() : '';
            const fullName = [row.firstName, row.lastName].filter(Boolean).join(' ').trim();

            // ✅ ตรวจสอบคนขับ: ใช้ cardId
            let driverData = null;
            if (cardId && driverMap[cardId]) {
                driverData = driverMap[cardId];
            }

            if (driverData) {
                drivers.push({
                    ...row,
                    driver: driverData,
                    vehicleId: driverData.vehicleId,
                    vehicleDisplayNumber: driverData.displayNumber,
                    plate: driverData.plate,
                    personType: 'driver'
                });
                await executeQuery(`
                    UPDATE PayrollScanRows SET 
                        personType = 'driver',
                        matchedDriverId = @driverId,
                        processedStatus = 'matched'
                    WHERE id = @rowId
                `, { driverId: driverData.employeeId, rowId: row.id });
                // ✅ แถวนี้เพิ่งเจอตัวตน (อาจเคยเป็น 'unmatched' มาก่อน) — ปิดรายการ
                //    ที่ค้างอยู่ในแท็บ Unmatched ของ cardId เดียวกันไปด้วยเลย ไม่ต้อง
                //    รอให้แอดมินไปกด "สร้างพนักงาน" ในแท็บ Unmatched อีกที
                if (cardId) await this.closeUnmatchedByCardId(cardId, driverData.employeeId);
                continue;
            }

            // ✅ ตรวจสอบพนักงานทั่วไป
            if (cardId && employeeMap[cardId]) {
                const employee = employeeMap[cardId];
                employees.push({
                    ...row,
                    employee: employee,
                    personType: 'employee'
                });
                await executeQuery(`
                    UPDATE PayrollScanRows SET 
                        personType = 'employee',
                        matchedEmployeeId = @empId,
                        processedStatus = 'matched'
                    WHERE id = @rowId
                `, { empId: employee.id, rowId: row.id });
                // ✅ เช่นเดียวกับฝั่งคนขับด้านบน — ปิด Unmatched ของ cardId นี้ทันที
                if (cardId) await this.closeUnmatchedByCardId(cardId, employee.id);
                continue;
            }

            // ❌ ไม่รู้จัก
            unmatched.push(row);
            await executeQuery(`
                UPDATE PayrollScanRows SET 
                    personType = 'unmatched',
                    processedStatus = 'unmatched'
                WHERE id = @rowId
            `, { rowId: row.id });
        }

        return { employees, drivers, unmatched };
    }

   // ─── CLASSIFY BY SHIFT ───
static classifyByShift(employees, drivers) {
    const shifts = {};

    for (const emp of employees) {
        // ✅ ใช้ scanTime อย่างเดียว
        let shiftCode = this.getShiftByTime(emp.scanTime);
        if (shiftCode === 'UNKNOWN') {
            shiftCode = 'D';
        }
        
        if (!shifts[shiftCode]) {
            shifts[shiftCode] = { shiftCode, employees: [], drivers: [] };
        }
        shifts[shiftCode].employees.push(emp);
    }

    for (const driver of drivers) {
        let shiftCode = this.getShiftByTime(driver.scanTime);
        if (shiftCode === 'UNKNOWN') {
            shiftCode = 'D';
        }
        
        if (!shifts[shiftCode]) {
            shifts[shiftCode] = { shiftCode, employees: [], drivers: [] };
        }
        shifts[shiftCode].drivers.push(driver);
    }

    return shifts;
}

    // ─── GET SHIFT FROM EXCEL ───
    static getShiftFromExcel(shiftRaw) {
        if (!shiftRaw) return null;
        
        const s = String(shiftRaw).trim().toUpperCase();
        
        const shiftMap = {
            'D': 'D',
            'D1': 'D',
            'D1S': 'D',
            'D2': 'EVENING_17',
            'D3': 'NIGHT_20',
            'D6': 'NIGHT_20',
            'N': 'N',
            'N1': 'N',
            'N2': 'NIGHT_20',
            'S': 'EVENING_17',
            'S1': 'EVENING_17',
            'S2': 'NIGHT_20',
            'เข้าเช้า': 'D',
            'ออกกะ': 'N',
            'เข้า 16:00': 'EVENING_IN_16',
            'ออก 16:00': 'EVENING_OUT_16',
            '17:00': 'EVENING_17',
            '20:00': 'NIGHT_20',
            'รอบ 17': 'EVENING_17',
            'รอบ 20': 'NIGHT_20',
        };
        
        if (/^\d+$/.test(s)) {
            return shiftMap[`D${s}`] || null;
        }
        
        for (const [key, value] of Object.entries(shiftMap)) {
            if (s.includes(key) || key.includes(s)) {
                return value;
            }
        }
        
        return null;
    }

    // ─── GET SHIFT BY TIME ───
    static getShiftByTime(time) {
        const t = this.toHHMM(time);
        if (!t) return 'UNKNOWN';
        
        if (t >= '06:00' && t <= '07:59') return 'D';
        if (t >= '08:00' && t <= '09:00') return 'N';
        if (t >= '15:00' && t <= '15:59') return 'EVENING_IN_16';
        if (t >= '16:00' && t <= '16:30') return 'EVENING_OUT_16';
        if (t >= '16:30' && t <= '17:30') return 'EVENING_17';
        if (t >= '19:00' && t <= '20:59') return 'NIGHT_20';
        
        return 'UNKNOWN';
    }

    // ─── PROCESS SHIFT ───
    static async processShift(date, shiftCode, shiftData) {
        if (shiftCode === 'UNKNOWN') {
            console.warn(`⚠️ ข้ามรอบ UNKNOWN สำหรับวันที่ ${date}`);
            return;
        }
        
        const shiftType = await executeQuery(`
            SELECT * FROM PayrollShiftTypes WHERE shiftCode = @shiftCode
        `, { shiftCode });

        if (shiftType.recordset.length === 0) {
            console.warn(`⚠️ ไม่พบ ShiftType: ${shiftCode}`);
            return;
        }

        const shift = shiftType.recordset[0];
        const { employees, drivers } = shiftData;

        console.log(`   🕐 รอบ ${shiftCode}: พนักงาน ${employees.length} คน, คนขับ ${drivers.length} คน`);

        const activeDrivers = drivers.filter(d => 
            this.isInTimeRange(d.scanTime, shift.startTime, shift.endTime)
        );

        if (activeDrivers.length === 0 && employees.length > 0) {
            console.warn(`⚠️ ไม่มีคนขับในรอบ ${shiftCode}`);
        }

        switch (shift.fareType) {
            case 'perHead':
                await this.processPerHeadShift(date, shift, employees, activeDrivers);
                break;
            case 'flatByVehicle':
                await this.processFlatByVehicleShift(date, shift, employees, activeDrivers);
                break;
            case 'perTrip':
                // ⚠️ แก้บั๊ก: เดิมถ้ามีพนักงานแต่ไม่มีคนขับ active ในรอบนี้
                //    จะสลับไปคิดเงินแบบ processPerHeadShift ซึ่งดึง
                //    employee.fare มาคิดแทน — รอบ 20:00 ต้องคิดเงินจาก
                //    รถ/คนขับที่สแกนล้วนๆ (PayrollVehicleRates ตาม
                //    vehicleId + tripCount) ไม่เกี่ยวกับพนักงานเลย ถ้าไม่มี
                //    คนขับสแกนในรอบนี้ ก็ไม่ต้องสร้างเที่ยว/ไม่คิดเงิน แค่นั้น
                await this.processNight20Shift(date, shift, drivers);
                break;
            default:
                console.warn(`⚠️ ไม่รู้จัก fareType: ${shift.fareType}`);
        }
    }

    // ─── เช็คว่ามีเที่ยวรถของ (วันที่, รอบ, รถ) นี้อยู่แล้วหรือยัง ───
    //    ⚠️ แก้บั๊ก: ตอน force reprocess จะลบเฉพาะเที่ยวที่ createdBy='system'
    //    เพื่อไม่ให้ไปทับการแก้ไขที่แอดมินทำเองใน UI (createdBy อื่น) — แต่ INSERT
    //    เดิมไม่เคยเช็คก่อนว่ามีแถวซ้ำอยู่ไหม พอ reprocess เจอวันที่มีการแก้มือไว้
    //    ก็จะพยายาม INSERT ซ้ำคีย์ (operationDate, shiftTypeId, vehicleId) เดิม
    //    ชน unique index UX_VehicleTrips_NoDupe แล้ว throw error หยุดการประมวลผล
    //    ของ import ทั้งไฟล์ทันที (วันที่ถัดไปในไฟล์เดียวกันไม่ถูกประมวลผลต่อเลย)
    //    ตอนนี้เช็คก่อน INSERT ทุกจุด ถ้ามีแถวอยู่แล้ว (ไม่ว่าใครสร้าง) ให้ข้าม
    //    เที่ยวนั้นไปเงียบๆ แทนการ throw — ป้องกันการแก้มือไม่ให้ถูกประมวลผลทับ
    //    และไม่ทำให้ทั้ง import ล้มเพราะรถคันเดียว
    static async tripExists(date, shiftTypeId, vehicleId) {
        const result = await executeQuery(`
            SELECT TOP 1 id FROM PayrollVehicleTrips
            WHERE operationDate = @date AND shiftTypeId = @shiftTypeId
              AND vehicleId = @vehicleId AND status != 'deleted'
        `, { date, shiftTypeId, vehicleId });
        return result.recordset.length > 0;
    }

 // ─── PROCESS PER HEAD SHIFT ───
static async processPerHeadShift(date, shift, employees, activeDrivers) {
    const vehiclesResult = await executeQuery(`
        SELECT id, vehicleNumber, displayNumber
        FROM Vehicles
        WHERE status = 'active'
    `);
    const vehiclesByNumber = new Map();
    for (const vehicle of vehiclesResult.recordset) {
        // id เทียบแบบตัวเลขล้วนตรงๆ (ไม่ใช่ "เบอร์แสดงผล" จึงไม่ normalize)
        const idKey = String(vehicle.id || '').trim();
        if (idKey) vehiclesByNumber.set(idKey, vehicle.id);
        for (const value of [vehicle.vehicleNumber, vehicle.displayNumber]) {
            const key = normalizeVehicleKey(value);
            if (key) vehiclesByNumber.set(key, vehicle.id);
        }
    }

    // ✅ สร้าง Map คนขับตามรถ
    // ⚠️ แก้บั๊ก: เดิมเรียก findVehicleByDriver(cardId) ซึ่ง join ด้วยชื่อ
    //    (Vehicles.driver = Employees.name) แยกจากวิธีที่ driverMap ใช้
    //    (Employees.defaultVehicleId) — ถ้าชื่อใน Vehicles กับ Employees
    //    ไม่ตรงกันเป๊ะ (เว้นวรรค/คำนำหน้า/ชื่อเล่น) คนขับจะหลุดไปเงียบๆ
    //    ตอนนี้ใช้ d.vehicleId ที่แนบมากับ driver object อยู่แล้วแทน
    //    (มาจาก defaultVehicleId เหมือน driverMap เป๊ะๆ ไม่ต้อง query ซ้ำ)
    const driverByVehicle = {};
    for (const d of activeDrivers) {
        if (d.vehicleId) {
            driverByVehicle[d.vehicleId] = d;
        } else {
            console.warn(`⚠️ คนขับ ${d.cardId} ไม่มี defaultVehicleId ในระบบจัดการพนักงาน`);
        }
    }

    const vehicleGroups = {};
    const unassigned = [];

    // ✅ กันคนที่ถูกจัดเข้ารถของรอบ/วันนี้ไปแล้วจริงๆ (มีแถวใน PayrollTripEmployees
    //    อยู่แล้ว) ไม่ให้ถูกประเมินใหม่แล้วเหวี่ยงไปกอง "ยังไม่ถูกจัดขึ้นรถ" ซ้ำ
    //    เวลาฟังก์ชันนี้ถูกเรียกซ้ำ (เช่น import ไฟล์เดิมซ้ำ) — เหมือนกับที่
    //    assignRidersToTrips() กันไว้ด้วย alreadyAssignedCardIds อยู่แล้ว แต่ฝั่ง
    //    perHead นี้ไม่เคยมีการเช็คนี้มาก่อนเลย
    const alreadySeatedRes = await executeQuery(`
        SELECT te.cardId FROM PayrollTripEmployees te
        INNER JOIN PayrollVehicleTrips vt ON te.vehicleTripId = vt.id
        WHERE vt.operationDate = @date AND vt.shiftTypeId = @shiftTypeId
          AND te.isDriver = 0 AND vt.status != 'deleted'
    `, { date, shiftTypeId: shift.id });
    const alreadySeatedCardIds = new Set(
        alreadySeatedRes.recordset.map(r => (r.cardId || '').trim()).filter(Boolean)
    );

    for (const emp of employees) {
        const empCardId = (emp.cardId || '').trim();
        if (empCardId && alreadySeatedCardIds.has(empCardId)) continue;

        const configuredVehicle = emp.employee?.defaultVehicleId || emp.employee?.defaultVehicleNumber;
        const vehicleId = configuredVehicle || vehiclesByNumber.get(normalizeVehicleKey(emp.vehicleRaw));
        const driver = vehicleId ? driverByVehicle[vehicleId] : null;
        const fareResult = this.resolveFare(emp.fareRaw, emp.employee?.fare);

        // ⚠️ แก้บั๊ก: เดิมแค่เช็คว่ามีเบอร์รถหรือไม่ (vehicleId) แล้วสร้างเที่ยวรถ
        //    + รวมค่าหัวทันที ทั้งที่ยังไม่เช็คว่ามีคนขับสแกนเข้ารถคันนั้นใน
        //    รอบนี้จริงไหม (ตัวแปร driver ถูกคำนวณไว้ข้างบนแต่ไม่เคยถูกใช้
        //    ตัดสินใจเลย) ผลคือพนักงานถูกจับเข้ารถและคิดค่าหัวไปแล้ว ทั้งที่
        //    ไม่มีคนขับคันนั้นสแกนเข้าระบบเลยในรอบนี้ — ตอนนี้ถ้าไม่มีคนขับ
        //    ให้ไปเข้า PayrollUnassignedRiders แทน ไม่สร้างเที่ยว/ไม่คิดเงิน
        //    จนกว่า user จะเลือกรถ/ยืนยันเอง
        if (!vehicleId) {
            unassigned.push({
                operationDate: date,
                shiftTypeId: shift.id,
                employeeId: emp.employee?.id || null,
                cardId: emp.cardId,
                nameSnapshot: emp.employee?.name || emp.name || '',
                expectedVehicleId: vehicleId || null,
                fare: fareResult.fare || 0,
                reason: 'no_vehicle'
            });
            continue;
        }

        if (!driver) {
            unassigned.push({
                operationDate: date,
                shiftTypeId: shift.id,
                employeeId: emp.employee?.id || null,
                cardId: emp.cardId,
                nameSnapshot: emp.employee?.name || emp.name || '',
                expectedVehicleId: vehicleId,
                fare: fareResult.fare || 0,
                reason: 'no_driver_scan'
            });
            continue;
        }

        // ✅ เก็บค่ารถที่ resolve แล้วไว้ที่ตัว emp เอง เผื่อใช้ตอน insert PayrollTripEmployees
        //    (ของเดิมอ่าน emp.resolvedFare แต่ไม่เคยมีใครตั้งค่านี้ เลยได้ 0 เสมอ)
        emp.resolvedFare = fareResult.fare || 0;

        if (!vehicleGroups[vehicleId]) {
            vehicleGroups[vehicleId] = { totalFare: 0, riders: [] };
        }
        vehicleGroups[vehicleId].totalFare += fareResult.fare || 0;
        vehicleGroups[vehicleId].riders.push(emp);
    }

    if (unassigned.length > 0) {
        await this.saveUnassignedRiders(date, shift.id, unassigned);
    }

    // ✅ ============================================================
    // ✅ INSERT ทีละคัน แบบ sequential (เหมือน processFlatByVehicleShift /
    //    processNight20Shift ที่ทำงานถูกอยู่แล้ว) เพราะ query ของ
    //    PayrollTripEmployees ต้องใช้ id ของ PayrollVehicleTrips ที่เพิ่ง
    //    insert เสร็จ — สร้างเป็น query array ไว้ล่วงหน้าแล้วยิงทีเดียว
    //    ทำแบบนั้นไม่ได้ เพราะตอนสร้าง query ยังไม่รู้ id นั้น
    // ✅ ============================================================
    let tripsCreated = 0;

    for (const [vehicleId, group] of Object.entries(vehicleGroups)) {
        if (group.riders.length === 0) continue;

        if (await this.tripExists(date, shift.id, parseInt(vehicleId))) {
            console.warn(`   ⏭️ ข้าม vehicleId=${vehicleId} วันที่ ${date} รอบ ${shift.id} — มีเที่ยวรถอยู่แล้ว (สร้าง/แก้โดยแอดมิน) ไม่สร้างซ้ำ`);
            continue;
        }

        console.log(`   📝 กำลัง INSERT VehicleTrip: date=${date}, vehicleId=${vehicleId}, totalFare=${group.totalFare}, totalRiders=${group.riders.length}`);

        try {
            const tripResult = await executeQuery(`
                INSERT INTO PayrollVehicleTrips (
                    operationDate, shiftTypeId, vehicleId, driverCardId,
                    fareType, fareUsed, totalFare, totalRiders, status, createdBy
                ) OUTPUT INSERTED.id
                VALUES (
                    @date, @shiftTypeId, @vehicleId, @driverCardId,
                    'perHead', 0, @totalFare, @totalRiders, 'draft', 'system'
                )
            `, {
                date,
                shiftTypeId: shift.id,
                vehicleId: parseInt(vehicleId),
                driverCardId: driverByVehicle[vehicleId]?.cardId || null,
                totalFare: group.totalFare,
                totalRiders: group.riders.length
            });

            const tripId = tripResult.recordset[0].id;

            for (const emp of group.riders) {
                await executeQuery(`
                    INSERT INTO PayrollTripEmployees (
                        vehicleTripId, employeeId, cardId, nameSnapshot,
                        department, section, destination, fare, isDriver
                    ) VALUES (
                        @tripId, @empId, @cardId, @name,
                        @department, @section, @destination, @fare, 0
                    )
                `, {
                    tripId,
                    empId: emp.employee?.id || null,
                    cardId: emp.cardId || '',
                    name: emp.employee?.name || emp.name || '',
                    department: emp.employee?.department || '',
                    section: emp.employee?.section || '',
                    destination: emp.employee?.address || '',
                    fare: emp.resolvedFare || 0
                });
            }

            tripsCreated++;
        } catch (error) {
            console.error(`   ❌ INSERT ล้มเหลว สำหรับ vehicleId=${vehicleId}:`, error.message);
            throw error;
        }
    }

    if (tripsCreated === 0) {
        console.log(`   ⏳ ไม่มี queries ที่ต้องประมวลผล`);
    } else {
        console.log(`   ✅ INSERT สำเร็จ! ทั้งหมด ${tripsCreated} เที่ยว`);
    }

    return { vehicleGroups, unassignedCount: unassigned.length, tripsCreated };
}

    // ─── PROCESS FLAT BY VEHICLE SHIFT ───
    static async processFlatByVehicleShift(date, shift, employees, activeDrivers) {
        // ✅ กันข้อมูลซ้ำตอน force-reprocess: ถ้าพนักงานคนนี้ถูกจัดเข้ารถของ
        //    วันที่/รอบนี้ไปแล้วจริง (มีแถวใน PayrollTripEmployees อยู่แล้ว ไม่ว่า
        //    จะรถคันไหน หรือถูกสร้าง/แก้โดยแอดมินเองด้วยมือ ('เพิ่มคนขับ'/'ย้ายรถ')
        //    ก็ตาม) ต้องไม่จับคนคนนี้เข้ารถซ้ำอีกรอบตอนประมวลผลใหม่ — เดิมฟังก์ชันนี้
        //    ไม่เคยเช็คจุดนี้เลย (ต่างจาก processPerHeadShift ที่กันไว้แล้วด้วย
        //    alreadySeatedCardIds) ทำให้รอบ 17:00 (flatByVehicle) เป็นรอบที่เจอ
        //    บั๊กข้อมูลซ้ำสองที่บ่อยที่สุดตอน reprocess
        const alreadySeatedRes = await executeQuery(`
            SELECT te.cardId FROM PayrollTripEmployees te
            INNER JOIN PayrollVehicleTrips vt ON te.vehicleTripId = vt.id
            WHERE vt.operationDate = @date AND vt.shiftTypeId = @shiftTypeId
              AND te.isDriver = 0 AND vt.status != 'deleted'
        `, { date, shiftTypeId: shift.id });
        const alreadySeatedCardIds = new Set(
            alreadySeatedRes.recordset.map(r => (r.cardId || '').trim()).filter(Boolean)
        );
        if (alreadySeatedCardIds.size > 0) {
            employees = employees.filter(emp => {
                const empCardId = (emp.cardId || '').trim();
                return !(empCardId && alreadySeatedCardIds.has(empCardId));
            });
        }

        // ⚠️ แก้บั๊ก: เดิม `if (activeDrivers.length === 0) return;` ตรงนี้
        //    ทำให้พนักงานที่สแกน/ถูกจัดเข้ารอบ 17:00 (flatByVehicle) ทั้งหมด
        //    หายไปเงียบๆ ทันทีถ้าวันนั้นไม่มีคนขับสแกนเข้ารอบนี้เลย — ไม่ถูก
        //    สร้างเที่ยวรถ และไม่ถูกบันทึกลง PayrollUnassignedRiders ด้วย
        //    (ต่างจาก processPerHeadShift ที่ทำแบบเดียวกันแล้วพนักงานไปโผล่
        //    เป็น "รอรถ" ในรอบนั้นแทน) ตอนนี้แก้ให้พฤติกรรมตรงกัน: ถ้าไม่มี
        //    คนขับเลย ให้พนักงานทั้งหมดของรอบนี้ไปเข้า PayrollUnassignedRiders
        //    (reason: 'no_driver_scan') แทนการ return เงียบๆ
        if (activeDrivers.length === 0) {
            if (employees.length > 0) {
                const unassigned = employees.map(emp => ({
                    operationDate: date,
                    shiftTypeId: shift.id,
                    employeeId: emp.employee?.id || null,
                    cardId: emp.cardId,
                    nameSnapshot: emp.employee?.name || emp.name || emp.firstName || '',
                    expectedVehicleId: null,
                    fare: 0,
                    reason: 'no_driver_scan'
                }));
                await this.saveUnassignedRiders(date, shift.id, unassigned);
                console.warn(`   ⏳ รอบ ${shift.shiftCode} (${date}): ไม่มีคนขับสแกนเข้ารอบนี้เลย — พนักงาน ${employees.length} คน ถูกย้ายไป "รอรถ" (PayrollUnassignedRiders) แทน`);
            }
            return;
        }

        const rateResult = await executeQuery(`
            SELECT TOP 1 rate FROM PayrollRateSettings 
            WHERE shiftCode = @shiftCode AND isActive = 1
            ORDER BY effectiveFrom DESC
        `, { shiftCode: shift.shiftCode });

        const flatRate = rateResult.recordset[0]?.rate || 300;

        const vehicleGroups = this.distributeEmployeesEvenly(employees, activeDrivers);

        for (const [driverCardId, group] of Object.entries(vehicleGroups)) {
            const driver = activeDrivers.find(d => d.cardId === driverCardId);
            if (!driver) continue;

            if (await this.tripExists(date, shift.id, driver.vehicleId)) {
                console.warn(`   ⏭️ ข้าม vehicleId=${driver.vehicleId} วันที่ ${date} รอบ ${shift.id} — มีเที่ยวรถอยู่แล้ว (สร้าง/แก้โดยแอดมิน) ไม่สร้างซ้ำ`);
                continue;
            }

            const tripResult = await executeQuery(`
                INSERT INTO PayrollVehicleTrips (
                    operationDate, shiftTypeId, vehicleId, driverCardId,
                    fareType, fareUsed, totalFare, totalRiders, status, createdBy
                ) OUTPUT INSERTED.id
                VALUES (
                    @date, @shiftTypeId, @vehicleId, @driverCardId,
                    'flatByVehicle', @fareUsed, @totalFare, @totalRiders, 'draft', 'system'
                )
            `, {
                date,
                shiftTypeId: shift.id,
                vehicleId: driver.vehicleId,
                driverCardId: driver.cardId,
                fareUsed: flatRate,
                totalFare: flatRate,
                totalRiders: group.employees.length
            });

            const tripId = tripResult.recordset[0].id;

            for (const emp of group.employees) {
                await executeQuery(`
                    INSERT INTO PayrollTripEmployees (
                        vehicleTripId, employeeId, cardId, nameSnapshot,
                        department, section, destination, fare, fareSource, isDriver
                    ) VALUES (
                        @tripId, @empId, @cardId, @name,
                        @department, @section, @destination, 0, 'flat_rate', 0
                    )
                `, {
                    tripId,
                    empId: emp.employee?.id || null,
                    cardId: emp.cardId,
                    name: emp.employee?.name || emp.firstName || '',
                    department: emp.employee?.department || '',
                    section: emp.employee?.section || '',
                    destination: emp.employee?.address || emp.destinationRaw || ''
                });
            }
        }
    }

    // ─── PROCESS NIGHT 20 SHIFT ───
    static async processNight20Shift(date, shift, drivers) {
        const activeDrivers = drivers.filter(d => 
            this.isInTimeRange(d.scanTime, '19:00', '20:59')
        );

        if (activeDrivers.length === 0) {
            console.log(`⚠️ ไม่มีคนขับในรอบ 20:00`);
            return;
        }

        const scansByDriver = {};
        for (const d of activeDrivers) {
            const key = d.cardId || d.driverCardId;
            if (!key) continue;
            if (!scansByDriver[key]) scansByDriver[key] = [];
            scansByDriver[key].push(d);
        }

        for (const [cardId, scans] of Object.entries(scansByDriver)) {
            // ⚠️ แก้บั๊ก: เดิมเรียก findVehicleByDriver(cardId) ซึ่ง join ด้วยชื่อ
            //    (Vehicles.driver = Employees.name) ทำให้คนขับที่ชื่อใน Vehicles
            //    ไม่ตรงกับ Employees เป๊ะๆ หลุดไปเงียบๆ ไม่ถูกสร้าง trip เลย
            //    ตอนนี้ใช้ vehicleId/displayNumber ที่แนบมากับ scan อยู่แล้ว
            //    (มาจาก defaultVehicleId เหมือน driverMap ตอน import)
            const driverInfo = scans[0];
            const vehicleId = driverInfo.vehicleId;
            const vehicleDisplayNumber = driverInfo.vehicleDisplayNumber || driverInfo.plate;

            if (!vehicleId) {
                console.warn(`⚠️ คนขับ ${cardId} ไม่มี defaultVehicleId ในระบบจัดการพนักงาน (ไม่มีรถประจำ)`);
                continue;
            }

            const before20 = scans.filter(s => {
                const t = this.toHHMM(s.scanTime || s.time);
                return t && t < '20:00';
            }).length;
            
            const after20 = scans.filter(s => {
                const t = this.toHHMM(s.scanTime || s.time);
                return t && t >= '20:00';
            }).length;
            
            const tripCount = Math.min(before20, 1) + Math.min(after20, 1);

            if (tripCount === 0) continue;

            // ✅ ป้ายชื่อรอบ 20:00 คำนวณแบบไดนามิก เพราะแถวเดียวกันอาจเป็น
            //    "รับพนักงานเข้า" อย่างเดียว, "รับพนักงานกลับ" อย่างเดียว,
            //    หรือทั้งสองอย่าง (2 เที่ยว) แล้วแต่ว่าคนขับสแกนช่วงไหนบ้าง
            let tripLabel;
            if (before20 > 0 && after20 > 0) {
                tripLabel = 'รับพนักงาน เข้า 20:00 + รับพนักงานกลับ ออก 20:00 (2 เที่ยว)';
            } else if (before20 > 0) {
                tripLabel = 'รับพนักงาน เข้า 20:00';
            } else {
                tripLabel = 'รับพนักงานกลับ ออก 20:00';
            }

            const rate = await this.getVehicleNightRate(vehicleId, tripCount);
            if (rate === null) {
                console.warn(`⚠️ ไม่พบราคารอบ 20:00 สำหรับรถ ${vehicleDisplayNumber || vehicleId} (${tripCount} เที่ยว)`);
                continue;
            }

            if (await this.tripExists(date, shift.id, vehicleId)) {
                console.warn(`   ⏭️ ข้าม vehicleId=${vehicleId} วันที่ ${date} รอบ ${shift.id} — มีเที่ยวรถอยู่แล้ว (สร้าง/แก้โดยแอดมิน) ไม่สร้างซ้ำ`);
                continue;
            }

            await executeQuery(`
                INSERT INTO PayrollVehicleTrips (
                    operationDate, shiftTypeId, vehicleId, driverCardId,
                    fareType, fareUsed, totalFare, totalRiders, tripSeq, note, status, createdBy
                ) VALUES (
                    @date, @shiftTypeId, @vehicleId, @driverCardId,
                    'perTrip', @fareUsed, @totalFare, 1, @tripSeq, @note, 'draft', 'system'
                )
            `, {
                date,
                shiftTypeId: shift.id,
                vehicleId: vehicleId,
                driverCardId: cardId,
                fareUsed: rate,
                totalFare: rate,
                tripSeq: tripCount,
                note: tripLabel
            });

            console.log(`✅ บันทึกเที่ยว 20:00: รถ ${vehicleDisplayNumber || vehicleId} — ${tripLabel} (${tripCount} เที่ยว) = ${rate} บาท`);
        }
    }

    // ─── FIND VEHICLE BY DRIVER CARD ID ───
    static async findVehicleByDriver(cardId) {
        const result = await executeQuery(`
            SELECT v.* FROM Vehicles v
            INNER JOIN Employees e ON v.driver = e.name OR v.backupDriver = e.name
            WHERE e.cardId = @cardId AND v.status = 'active'
        `, { cardId });
        return result.recordset[0] || null;
    }

    // ─── GET VEHICLE NIGHT RATE ───
    static async getVehicleNightRate(vehicleId, tripCount) {
        const result = await executeQuery(`
            SELECT TOP 1 rate FROM PayrollVehicleRates
            WHERE vehicleId = @vehicleId AND shiftCode = 'NIGHT_20'
            AND tripCount = @tripCount AND isActive = 1
            ORDER BY effectiveDate DESC
        `, { vehicleId, tripCount });

        return result.recordset[0]?.rate || null;
    }

  // ─── SAVE UNASSIGNED RIDERS ───
static async saveUnassignedRiders(date, shiftTypeId, unassignedList) {
    if (!unassignedList || unassignedList.length === 0) return;

    // ✅ ลบของเก่าก่อน (กันซ้ำ)
    await executeQuery(`
        DELETE FROM PayrollUnassignedRiders 
        WHERE operationDate = @date AND shiftTypeId = @shiftTypeId
    `, { date, shiftTypeId });

    for (const u of unassignedList) {
        // ✅ ถ้า employeeId เป็น NULL ให้ข้าม
        if (!u.employeeId) {
            console.warn(`⚠️ ข้าม Unassigned: ${u.nameSnapshot} (ไม่มี employeeId)`);
            continue;
        }

        await executeQuery(`
            INSERT INTO PayrollUnassignedRiders (
                operationDate, shiftTypeId, employeeId, cardId, nameSnapshot,
                expectedVehicleId, fare, reason, status
            ) VALUES (
                @operationDate, @shiftTypeId, @employeeId, @cardId, @nameSnapshot,
                @expectedVehicleId, @fare, @reason, 'pending'
            )
        `, {
            operationDate: u.operationDate,
            shiftTypeId: u.shiftTypeId,
            employeeId: u.employeeId,
            cardId: u.cardId || '',
            nameSnapshot: u.nameSnapshot || '',
            expectedVehicleId: u.expectedVehicleId || null,
            fare: u.fare || 0,
            reason: u.reason || 'no_driver_scan'
        });
    }
}

    // ─── จัดคนลงรถอัตโนมัติ (กดเองจากปุ่มในหน้าเว็บ) ───
    //    ใช้ได้เฉพาะรอบ flatByVehicle (17:00) และ perTrip (20:00) เท่านั้น
    //    ห้ามใช้กับรอบ perHead เด็ดขาด เพราะรอบนั้นคิดเงินตามจำนวนคนจริง
    //    ที่พนักงานกรอก/สแกนเข้ารถของตัวเองอยู่แล้ว ไม่ต้องเฉลี่ย
    //
    //    หลักการ: เอาเฉพาะรถที่ถูก "เพิ่มรถเข้ารอบ" ไว้แล้วในระบบ (เรียง
    //    ตามลำดับที่เพิ่มก่อน = vt.id น้อยไปมาก) แล้วดึงพนักงานที่สแกนหน้า
    //    ในช่วงเวลาของรอบนี้ มาเฉลี่ยลงแบบ round-robin ทีละคนตามลำดับรถ
    //    ไม่ให้เกินที่นั่ง (Vehicles.maxPassengers) ของแต่ละคัน ถ้าคนเกิน
    //    ที่นั่งที่มี จะถูกบันทึกลง PayrollUnassignedRiders (reason:
    //    'vehicle_full') ให้แอดมินไปจัดการต่อ — ไม่มีการสร้างเที่ยวรถใหม่
    //    ในฟังก์ชันนี้ (ต้องกด "เพิ่มรอบ" ให้ครบก่อนแล้วค่อยกดจัดคน)
    //
    //    รอบ 20:00 (NIGHT_20): แยกทำ fareSource เป็น 'night_in'/'night_out'
    //    ตามเวลาสแกน (ก่อน/หลัง 20:00) เพื่อให้รายงานแยกแสดงเข้างาน/ออกงาน
    //    ได้ แต่ยังนับรวมเป็นเที่ยวเดียวกัน (ไม่แยกเที่ยวรถ)
    static async assignRidersToTrips(operationDate, shiftTypeId, userId = 'admin') {
        const shiftRes = await executeQuery(`
            SELECT * FROM PayrollShiftTypes WHERE id = @shiftTypeId
        `, { shiftTypeId });
        const shift = shiftRes.recordset[0];
        if (!shift) throw new Error('ไม่พบรอบเวลานี้');

        if (shift.fareType === 'perHead') {
            throw new Error('รอบนี้เป็นรอบคิดค่าหัว (perHead) — ห้ามใช้ระบบจัดคนลงรถอัตโนมัติ ใช้ได้เฉพาะรอบเหมาคัน/เหมาเที่ยวเท่านั้น');
        }

        // ✅ รถที่ถูกเพิ่มเข้ารอบนี้แล้ว เรียงตามลำดับที่เพิ่มก่อน (id น้อยไปมาก)
        const tripsRes = await executeQuery(`
            SELECT vt.id, vt.vehicleId, v.displayNumber, v.maxPassengers
            FROM PayrollVehicleTrips vt
            INNER JOIN Vehicles v ON vt.vehicleId = v.id
            WHERE vt.operationDate = @operationDate AND vt.shiftTypeId = @shiftTypeId AND vt.status != 'deleted'
            ORDER BY vt.id ASC
        `, { operationDate, shiftTypeId });
        const trips = tripsRes.recordset;

        const warnings = [];
        for (const t of trips) {
            const cntRes = await executeQuery(`
                SELECT COUNT(*) as cnt FROM PayrollTripEmployees WHERE vehicleTripId = @tripId AND isDriver = 0
            `, { tripId: t.id });
            t.filled = cntRes.recordset[0]?.cnt || 0;
            const cap = t.maxPassengers || 0;
            t.remaining = Math.max(cap - t.filled, 0);
            if (!cap) {
                warnings.push(`รถเบอร์ ${t.displayNumber || t.vehicleId} ยังไม่ได้ตั้งค่าที่นั่งสูงสุด (maxPassengers) ในหน้าจัดการรถ — จะไม่ถูกจัดคนให้`);
            }
        }

        // ✅ คนที่ถูกจัดลงรถของรอบนี้ วันนี้ไปแล้ว (กันใส่ซ้ำเวลากดปุ่มซ้ำ)
        const assignedRes = await executeQuery(`
            SELECT te.cardId FROM PayrollTripEmployees te
            INNER JOIN PayrollVehicleTrips vt ON te.vehicleTripId = vt.id
            WHERE vt.operationDate = @operationDate AND vt.shiftTypeId = @shiftTypeId AND te.isDriver = 0
        `, { operationDate, shiftTypeId });
        const alreadyAssignedCardIds = new Set(assignedRes.recordset.map(r => (r.cardId || '').trim()));

        // ✅ พนักงานที่สแกนหน้าในวันนี้ (กรองช่วงเวลาของรอบด้วย JS ไม่ใช่ SQL
        //    เพราะ scanTime/startTime-endTime เป็นคนละ data type กัน ทำให้
        //    SQL Server ขึ้น error "time and datetime are incompatible" ถ้า
        //    เทียบตรงๆ ใน WHERE — จุดอื่นในระบบ (isInTimeRange) ก็หลีกเลี่ยง
        //    การเทียบเวลาฝั่ง SQL ด้วยเหตุผลเดียวกัน)
        const scansRes = await executeQuery(`
            SELECT sr.cardId, sr.firstName, sr.lastName, sr.scanTime, sr.matchedEmployeeId,
                   e.name, e.department, e.section, e.address
            FROM PayrollScanRows sr
            INNER JOIN Employees e ON sr.matchedEmployeeId = e.id
            WHERE sr.scanDate = @operationDate
              AND sr.personType = 'employee'
        `, { operationDate });

        const seen = new Set();
        const scannedEmployees = [];
        for (const row of scansRes.recordset
            .filter(r => this.isInTimeRange(r.scanTime, shift.startTime, shift.endTime))
            .sort((a, b) => this.toHHMM(a.scanTime).localeCompare(this.toHHMM(b.scanTime)))) {
            const cardId = (row.cardId || '').trim();
            if (!cardId || seen.has(cardId) || alreadyAssignedCardIds.has(cardId)) continue;
            seen.add(cardId);
            scannedEmployees.push(row);
        }

        if (scannedEmployees.length === 0) {
            return { assigned: 0, unassigned: 0, vehicles: trips.length, warnings, message: 'ไม่พบพนักงานสแกนหน้าในช่วงเวลาของรอบนี้ (หรือถูกจัดรถไปหมดแล้ว)' };
        }

        // ✅ ยังไม่มีรถถูกเพิ่มเข้ารอบนี้เลย — แทนที่จะทิ้งไปเงียบๆ ให้บันทึกทุกคน
        //    ลง PayrollUnassignedRiders (reason: 'no_vehicle_trip') เพื่อให้ขึ้น
        //    โชว์ในหน้า "รอจัดรถ" ของรอบนี้ พอแอดมินกด "เพิ่มรอบ" ใส่รถแล้ว
        //    ค่อยกดปุ่มจัดคนอัตโนมัติซ้ำอีกครั้ง
        if (trips.length === 0) {
            await executeQuery(`
                DELETE FROM PayrollUnassignedRiders
                WHERE operationDate = @operationDate AND shiftTypeId = @shiftTypeId
                  AND reason = 'no_vehicle_trip' AND status = 'pending'
            `, { operationDate, shiftTypeId });

            for (const emp of scannedEmployees) {
                await executeQuery(`
                    INSERT INTO PayrollUnassignedRiders (
                        operationDate, shiftTypeId, employeeId, cardId, nameSnapshot,
                        expectedVehicleId, fare, reason, status
                    ) VALUES (
                        @operationDate, @shiftTypeId, @employeeId, @cardId, @nameSnapshot,
                        NULL, 0, 'no_vehicle_trip', 'pending'
                    )
                `, {
                    operationDate, shiftTypeId,
                    employeeId: emp.matchedEmployeeId,
                    cardId: emp.cardId,
                    nameSnapshot: emp.name || `${emp.firstName || ''} ${emp.lastName || ''}`.trim()
                });
            }

            return {
                assigned: 0,
                unassigned: scannedEmployees.length,
                vehicles: 0,
                warnings,
                message: `ยังไม่มีรถถูกเพิ่มเข้ารอบนี้ — พักพนักงาน ${scannedEmployees.length} คนไว้ในรายการ "รอจัดรถ" ให้แล้ว กรุณา "เพิ่มรอบ" แล้วจัดคนอีกครั้ง`
            };
        }

        // ✅ Round-robin ทีละคน ตามลำดับรถที่เพิ่มก่อน ไม่เกินที่นั่งที่เหลือ
        let assigned = 0;
        const unassignedPeople = [];
        let idx = 0;
        for (const emp of scannedEmployees) {
            let placed = false;
            for (let i = 0; i < trips.length; i++) {
                const t = trips[(idx + i) % trips.length];
                if (t.remaining > 0) {
                    const empScanHHMM = this.toHHMM(emp.scanTime);
                    const fareSource = shift.shiftCode === 'NIGHT_20'
                        ? (empScanHHMM && empScanHHMM < '20:00' ? 'night_in' : 'night_out')
                        : 'flat_rate';

                    await executeQuery(`
                        INSERT INTO PayrollTripEmployees (
                            vehicleTripId, employeeId, cardId, nameSnapshot,
                            department, section, destination, fare, fareSource, isDriver
                        ) VALUES (
                            @tripId, @empId, @cardId, @name,
                            @department, @section, @destination, 0, @fareSource, 0
                        )
                    `, {
                        tripId: t.id,
                        empId: emp.matchedEmployeeId,
                        cardId: emp.cardId,
                        name: emp.name || `${emp.firstName || ''} ${emp.lastName || ''}`.trim(),
                        department: emp.department || '',
                        section: emp.section || '',
                        destination: emp.address || '',
                        fareSource
                    });

                    t.remaining--;
                    t.filled++;
                    assigned++;
                    idx = (idx + i + 1) % trips.length;
                    placed = true;

                    // ✅ เคลียร์ record ค้างใน PayrollUnassignedRiders ของคนคนนี้
                    //    ในรอบ/วันนี้ (ไม่ว่า reason จะเป็น no_vehicle_trip,
                    //    no_driver_scan, vehicle_full เดิม ฯลฯ) เพราะตอนนี้เขา
                    //    ถูกจัดเข้ารถจริงแล้ว ไม่งั้น banner "ยังไม่ถูกจัดขึ้นรถ"
                    //    จะค้างโชว์คนที่จัดรถไปแล้วอยู่ดี
                    await executeQuery(`
                        UPDATE PayrollUnassignedRiders SET status = 'resolved', updatedAt = GETDATE()
                        WHERE operationDate = @operationDate AND shiftTypeId = @shiftTypeId
                          AND cardId = @cardId AND status = 'pending'
                    `, { operationDate, shiftTypeId, cardId: emp.cardId });

                    break;
                }
            }
            if (!placed) unassignedPeople.push(emp);
        }

        // ✅ อัปเดต totalRiders ของแต่ละเที่ยวให้ตรงกับจำนวนคนจริง
        for (const t of trips) {
            await executeQuery(`
                UPDATE PayrollVehicleTrips SET totalRiders = @riders WHERE id = @id
            `, { riders: t.filled, id: t.id });
        }

        // ✅ ล้างรายการ "คนไม่มีรถ (รถเต็ม)" เก่าของรอบนี้ วันนี้ทิ้งก่อน
        //    แล้วค่อยบันทึกรายการล่าสุด กันสะสมซ้ำเวลากดปุ่มหลายครั้ง
        await executeQuery(`
            DELETE FROM PayrollUnassignedRiders
            WHERE operationDate = @operationDate AND shiftTypeId = @shiftTypeId
              AND reason = 'vehicle_full' AND status = 'pending'
        `, { operationDate, shiftTypeId });

        for (const emp of unassignedPeople) {
            await executeQuery(`
                INSERT INTO PayrollUnassignedRiders (
                    operationDate, shiftTypeId, employeeId, cardId, nameSnapshot,
                    expectedVehicleId, fare, reason, status
                ) VALUES (
                    @operationDate, @shiftTypeId, @employeeId, @cardId, @nameSnapshot,
                    NULL, 0, 'vehicle_full', 'pending'
                )
            `, {
                operationDate, shiftTypeId,
                employeeId: emp.matchedEmployeeId,
                cardId: emp.cardId,
                nameSnapshot: emp.name || `${emp.firstName || ''} ${emp.lastName || ''}`.trim()
            });
        }

        await this.logAudit('PayrollVehicleTrips', shiftTypeId, 'autoAssignRiders',
            `assigned=${assigned}, unassigned=${unassignedPeople.length}`, 'UPDATE', userId);

        return {
            assigned,
            unassigned: unassignedPeople.length,
            vehicles: trips.length,
            warnings,
            message: `จัดคนลงรถสำเร็จ ${assigned} คน` + (unassignedPeople.length > 0 ? ` — เหลือ ${unassignedPeople.length} คนไม่มีรถ (รถเต็ม)` : '')
        };
    }

    // ─── DISTRIBUTE EMPLOYEES EVENLY ───
    static distributeEmployeesEvenly(employees, drivers) {
        const result = {};
        const sortedDrivers = drivers.sort((a, b) => (a.cardId || '').localeCompare(b.cardId || ''));

        for (const driver of sortedDrivers) {
            result[driver.cardId || driver.driverName] = { driver, employees: [] };
        }

        const driverKeys = Object.keys(result);
        employees.forEach((emp, index) => {
            const key = driverKeys[index % driverKeys.length];
            result[key].employees.push(emp);
        });

        return result;
    }

    // ─── RESOLVE FARE ───
    // ✅ แก้บั๊ก: เดิมยึดค่ารถจากไฟล์ Excel ที่นำเข้าเป็นหลักเสมอ (ถ้า parse
    //    เป็นตัวเลขได้) ทำให้ราคาที่ตั้งไว้ใน "จัดการพนักงาน" ถูกข้ามไปเงียบๆ
    //    ตอนนี้ยึดค่ารถใน "จัดการพนักงาน" (master) เป็นหลักเสมอถ้ามีค่าตั้งไว้
    //    ค่าจาก Excel ใช้เป็น fallback เฉพาะกรณี master ยังไม่มีค่ารถเท่านั้น
    static resolveFare(fareRaw, employeeFare) {
        const excelFare = this.parseFare(fareRaw);

        if (employeeFare !== null && employeeFare !== undefined && employeeFare > 0) {
            return {
                fare: employeeFare,
                source: 'master',
                needsMasterSync: false,
                // แจ้งเตือนเฉยๆ ถ้าราคาที่ import มาต่างจาก master (ไม่ได้บังคับใช้)
                fareMismatch: excelFare !== null && excelFare !== employeeFare,
                needsAlert: false
            };
        }

        if (excelFare !== null) {
            return {
                fare: excelFare,
                source: 'excel',
                needsMasterSync: true, // เตือนให้ไปตั้งค่ารถของพนักงานคนนี้ใน master ด้วย
                needsAlert: false
            };
        }

        return {
            fare: null,
            source: 'none',
            needsMasterSync: false,
            needsAlert: true
        };
    }

    static parseFare(raw) {
        if (raw == null) return null;
        const str = String(raw).trim().toUpperCase();
        if (str === '' || str === '#N/A' || str === 'N/A' || str === '-' || str === 'NULL') return null;
        const num = parseFloat(str);
        return isNaN(num) ? null : num;
    }

