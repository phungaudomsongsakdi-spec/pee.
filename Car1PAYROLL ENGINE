    //    ปรากฏในทุกรอบที่เขาสแกนจริง — ตอนนี้ dedupe ด้วย cardId+scanTime
    //    แทน เพื่อกันเฉพาะแถวที่ซ้ำกันจริง (จาก newDrivers/existingDrivers
    //    ที่ query ทับกัน) แต่ยังเก็บสแกนคนละเวลาของคนขับคนเดิมไว้ครบ
    const uniqueDrivers = [];
    const seenDriverKeys = new Set();
    for (const d of allDrivers) {
        const key = `${d.cardId}|${this.toHHMM(d.scanTime)}`;
        if (!seenDriverKeys.has(key)) {
            seenDriverKeys.add(key);
            uniqueDrivers.push(d);
        }
    }

    // ✅ เอาพนักงานที่ซ้ำออก (เหตุผลเดียวกับคนขับด้านบน — dedupe ด้วย
    //    cardId+scanTime แทน cardId เฉยๆ เผื่อพนักงานสแกนหลายรอบ/วัน เช่น
    //    เข้า 16:00 + ออก 16:00)
    const uniqueEmployees = [];
    const seenEmployeeKeys = new Set();
    for (const e of allEmployees) {
        const key = `${e.cardId}|${this.toHHMM(e.scanTime)}`;
        if (!seenEmployeeKeys.has(key)) {
            seenEmployeeKeys.add(key);
            uniqueEmployees.push(e);
        }
    }

    console.log(`   📊 รวมทั้งหมด (ไม่ซ้ำ): พนักงาน ${uniqueEmployees.length} คน, คนขับ ${uniqueDrivers.length} คน`);

    await this.getOrCreateOperationDay(date);

    // ✅ ============================================================
    // ✅ IMPORTANT: ให้สร้าง VehicleTrips ทันที只要有พนักงาน (ไม่ต้องรอคนขับ)
    // ⚠️ แก้บั๊ก: เดิมครอบทั้งบล็อกด้วย if (uniqueEmployees.length > 0)
    //    เท่านั้น แปลว่าวันที่มีแต่ไฟล์คนขับ (ไม่มีไฟล์พนักงานเลย) จะไม่มี
    //    การสร้างเที่ยวรถอะไรทั้งสิ้น — ทั้งที่รอบ 17:00 (flatByVehicle)
    //    และ 20:00 (perTrip) ควรคิดเงินจาก "รถ/คนขับสแกน" ล้วนๆ ไม่ต้อง
