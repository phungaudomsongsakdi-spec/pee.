 // ─── PROCESS DAY ───
static async processDay(date, employeeMap, driverMap) {
    const allRows = await executeQuery(`
        SELECT * FROM PayrollScanRows 
        WHERE scanDate = @date 
        AND sourceType IN ('employee_file', 'driver_file')
    `, { date });

    const rowsList = allRows.recordset || [];

    if (rowsList.length === 0) {
        console.log(`⚠️ วันที่ ${date}: ไม่มีข้อมูล`);
        return { matched: 0, unmatched: 0, warnings: ['ไม่มีข้อมูล'] };
    }

    // ⚠️ แก้บั๊ก (คู่กับ processImport ด้านบน): เดิมกรองแค่ 'pending' ทำให้แถวที่
    //    เคยหา cardId ไม่เจอ (processedStatus = 'unmatched') ไม่เคยถูกลองจับคู่
    //    ใหม่อีกเลย ต่อให้พนักงานคนนั้นถูกเพิ่ม/แก้ไขให้ cardId ตรงกันในภายหลัง
    //    ก็ตาม ต้องกด force reprocess (ลบเที่ยวรถทิ้งทั้งวันแล้วสร้างใหม่) เท่านั้น
    //    ตอนนี้รวม 'unmatched' เข้ามาลองจับคู่ใหม่ทุกครั้งที่มีการประมวลผลวันนั้น
    const pendingRows = rowsList.filter(r => r.processedStatus === 'pending' || r.processedStatus === 'unmatched');
    const alreadyProcessed = rowsList.filter(r => r.processedStatus === 'matched');

    console.log(`📅 Processing day: ${date}, ทั้งหมด ${rowsList.length} แถว (pending/unmatched ที่จะลองจับคู่ใหม่: ${pendingRows.length}, matched อยู่แล้ว: ${alreadyProcessed.length})`);

    if (pendingRows.length === 0) {
        console.log(`   ✅ ทุกอย่างถูกประมวลผลแล้ว`);
        return { matched: 0, unmatched: 0, warnings: [] };
    }

    // ✅ Classify pending rows
    const classified = await this.classifyRows(pendingRows, employeeMap, driverMap);

    const newEmployees = classified.employees || [];
    const newDrivers = classified.drivers || [];
    const unmatched = classified.unmatched || [];

    console.log(`   👤 Employees (ใหม่): ${newEmployees.length}`);
    console.log(`   🚗 Drivers (ใหม่): ${newDrivers.length}`);
    console.log(`   ❓ Unmatched: ${unmatched.length}`);

    // ✅ ดึงข้อมูลที่มีอยู่แล้วในวันนี้ (จาก PayrollScanRows ทั้งหมด)
    const allRowsInDate = await executeQuery(`
        SELECT 
            cardId,
            firstName,
            lastName,
            departmentRaw,
            vehicleRaw,
            fareRaw,
            shiftRaw,
            scanTime,
            sourceType,
            processedStatus,
            personType
        FROM PayrollScanRows 
        WHERE scanDate = @date 
        AND sourceType IN ('employee_file', 'driver_file')
    `, { date });

    const existingEmployees = [];
    const existingDrivers = [];

    // ⚠️ แก้บั๊ก: เดิม lookup driverMap[row.cardId] / employeeMap[row.cardId] ตรงนี้
    //    ไม่ trim() ก่อนเลย ทั้งที่ driverMap/employeeMap ถูกสร้างด้วย key ที่ trim()
    //    แล้ว (และ classifyRows() ที่ใช้กับแถวใหม่ก็ trim() ก่อน lookup ทุกครั้ง)
    //    ผลคือถ้า cardId ในฐานข้อมูลมีช่องว่างเกินมาแม้แต่ตัวเดียว แถวนั้นจะ
    //    หลุดจาก existingDrivers/existingEmployees แบบเงียบๆ — ไม่มีผลตอน import
    //    ครั้งแรก (เพราะ newDrivers/newEmployees จาก classifyRows ที่ trim() ถูก
    //    ครอบคลุมทุกคนอยู่แล้ว) แต่พอมีวันที่ import ซ้ำ/แยกไฟล์ (เช่น import
    //    ไฟล์พนักงานซ้ำอีกรอบ โดยไม่มีแถวคนขับใหม่เลยในรอบนั้น) existingDrivers
    //    (ที่พึ่งพา lookup ตัวนี้ล้วนๆ) จะว่างเปล่า ทำให้พนักงานทุกคนที่มีรถแล้ว
    //    แต่หาคนขับไม่เจอ ถูกเหวี่ยงไปกอง "ยังไม่ถูกจัดขึ้นรถ" (no_driver_scan)
    //    ทั้งที่จริงๆ ถูกจัดรถถูกต้องอยู่แล้วจากรอบก่อนหน้า — ตอนนี้ trim() ให้ตรงกัน
    for (const row of allRowsInDate.recordset) {
        const rowCardId = row.cardId ? row.cardId.trim() : '';
        if (row.personType === 'driver' || row.sourceType === 'driver_file') {
            const driverInfo = driverMap[rowCardId];
            if (driverInfo) {
                existingDrivers.push({
                    cardId: row.cardId,
                    name: `${row.firstName} ${row.lastName}`.trim(),
                    scanTime: row.scanTime,
                    vehicleId: driverInfo.vehicleId,
                    vehicleDisplayNumber: driverInfo.displayNumber,
                    plate: driverInfo.plate,
                    personType: 'driver'
                });
            }
        } else if (row.personType === 'employee' || row.sourceType === 'employee_file') {
            const empInfo = employeeMap[rowCardId];
            if (empInfo) {
                existingEmployees.push({
                    cardId: row.cardId,
                    firstName: row.firstName,
                    lastName: row.lastName,
                    scanTime: row.scanTime,
                    fareRaw: row.fareRaw,
                    vehicleRaw: row.vehicleRaw,
