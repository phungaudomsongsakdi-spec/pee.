    const allDrivers = [...newDrivers, ...existingDrivers];

    // ✅ เอาคนขับที่ซ้ำออก
    // ⚠️ แก้บั๊ก: เดิม dedupe ด้วย cardId อย่างเดียว — คนขับ 1 คนที่สแกน
    //    หลายรอบต่อวัน (เช้า + 20:00) จะเหลือแค่ scan แรกที่เจอ แล้ว scan
