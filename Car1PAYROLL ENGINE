    }

    // ─── GET UNMATCHED ───
    // ✅ รวม 3 กลุ่มไว้ในลิสต์เดียวกัน (ไม่แยกแท็บย่อย ตามที่ตกลงกันไว้):
    //    1) 'unmatched'          — คนที่สแกนเข้ามาแต่ไม่มีตัวตนใน Employees เลย (PayrollUnmatchedPersons)
    //    2) 'fare_alert'         — คนที่มีตัวตนแล้วแต่ค่ารถผิดปกติ (PayrollFareAlerts)
    //    3) 'incomplete_employee'— คนที่มีตัวตนใน Employees แล้ว แต่ยังไม่มีค่ารถ (fare=0)
    //                              หรือยังไม่มีรถประจำ (defaultVehicleId ว่าง) — เดิมกลุ่มนี้
    //                              จะขึ้นแค่ "🚐 ไม่ระบุรถ" ในหน้าจัดการวันนี้ แต่ไม่เคยโผล่ตรง
    //                              Unmatched เลย ทั้งที่ต้องจัดการที่เดียวกัน (กรอกค่ารถ/รถประจำ)
    static async getUnmatched(status, page, limit) {
        const offset = (page - 1) * limit;
        
        const query = `
            SELECT 
                id,
                cardId,
                firstName,
                lastName,
                departmentRaw,
                vehicleRaw,
                shiftRaw,
                status,
                'unmatched' as type,
                NULL as reason,
                createdAt
            FROM PayrollUnmatchedPersons
            WHERE 1=1 ${status ? 'AND status = @status' : ''}
            
            UNION ALL
            
            SELECT 
                id,
                cardId,
                nameSnapshot as firstName,
                '' as lastName,
                '' as departmentRaw,
                '' as vehicleRaw,
                '' as shiftRaw,
                status,
                'fare_alert' as type,
                reason,
                createdAt
            FROM PayrollFareAlerts
            WHERE 1=1 ${status ? 'AND status = @status' : ''}
            AND status = 'pending'

            UNION ALL

            SELECT
                id,
                cardId COLLATE DATABASE_DEFAULT as cardId,
                firstName COLLATE DATABASE_DEFAULT as firstName,
                lastName COLLATE DATABASE_DEFAULT as lastName,
                department COLLATE DATABASE_DEFAULT as departmentRaw,
                CAST(defaultVehicleNumber AS NVARCHAR(100)) COLLATE DATABASE_DEFAULT as vehicleRaw,
                '' as shiftRaw,
                'pending' as status,
                'incomplete_employee' as type,
                CASE WHEN ISNULL(fare, 0) = 0 THEN 'ไม่มีค่ารถ'
                     WHEN defaultVehicleId IS NULL THEN 'ไม่มีรถประจำ'
                     ELSE 'ไม่มีค่ารถ/รถประจำ' END as reason,
                createdAt
            FROM Employees
            WHERE status = 'active' AND isDriver = 0
              AND (ISNULL(fare, 0) = 0 OR defaultVehicleId IS NULL)
              ${status && status !== 'pending' ? 'AND 1=0' : ''}
            
            ORDER BY createdAt DESC
            OFFSET @offset ROWS FETCH NEXT @limit ROWS ONLY
        `;

        const params = { offset, limit };
        if (status) params.status = status;

        const result = await executeQuery(query, params);

        const countQuery = `
            SELECT 
                (SELECT COUNT(*) FROM PayrollUnmatchedPersons WHERE 1=1 ${status ? 'AND status = @status' : ''}) +
                (SELECT COUNT(*) FROM PayrollFareAlerts WHERE 1=1 ${status ? 'AND status = @status' : ''} AND status = 'pending') +
                (SELECT COUNT(*) FROM Employees WHERE status = 'active' AND isDriver = 0
                    AND (ISNULL(fare, 0) = 0 OR defaultVehicleId IS NULL)
                    ${status && status !== 'pending' ? 'AND 1=0' : ''})
                as total
        `;
        const countResult = await executeQuery(countQuery, status ? { status } : {});

        return {
            items: result.recordset,
            total: countResult.recordset[0]?.total || 0,
            page,
            limit
        };
    }

    // ─── GET UNMATCHED — รายการเดียว ระบุ type ชัดเจน (id ชนกันได้ข้าม 3 ตาราง) ───
