            //    (ใช้เฉพาะรอบที่คิดเงินแบบ perHead ซึ่งต้องพึ่งเบอร์รถของ
            //    พนักงาน; รอบ perTrip/flatByVehicle ไม่ยุ่งกับ branch นี้
            //    เพราะต้องอิงคนขับที่สแกนจริงในช่วงเวลาของรอบนั้นเท่านั้น)
            if (shiftData.employees.length > 0 && shiftData.drivers.length === 0 && uniqueDrivers.length > 0) {
                shiftData.drivers = uniqueDrivers;
                console.log(`   🔄 ใช้คนขับ ${uniqueDrivers.length} คน สำหรับรอบ ${shiftCode}`);
            }
            await this.processShift(date, shiftCode, shiftData);
