    static async approveDay(date, userId) {
        const result = await executeQuery(`
            UPDATE PayrollOperationDays SET
                status = 'approved',
                approvedBy = @userId,
                approvedAt = GETDATE(),
                updatedAt = GETDATE()
            WHERE operationDate = @date AND status != 'locked'
        `, { date, userId });

        if (result.rowsAffected[0] === 0) {
            throw new Error('ไม่สามารถอนุมัติได้ (อาจถูกล็อกแล้ว)');
        }

        return { date, status: 'approved', approvedBy: userId };
    }

    static async lockDay(date, userId) {
        const result = await executeQuery(`
            UPDATE PayrollOperationDays SET
                status = 'locked',
                lockedBy = @userId,
                lockedAt = GETDATE(),
                updatedAt = GETDATE()
            WHERE operationDate = @date AND status IN ('approved', 'completed')
        `, { date, userId });

        if (result.rowsAffected[0] === 0) {
            throw new Error('ไม่สามารถล็อกได้ (ต้องมีสถานะ approved หรือ completed)');
        }

        await executeQuery(`
            UPDATE PayrollVehicleTrips SET
                status = 'locked',
                updatedAt = GETDATE()
            WHERE operationDate = @date AND status NOT IN ('locked', 'paid')
        `, { date });

        return { date, status: 'locked', lockedBy: userId };
    }

    // ─── AUDIT LOG ───
    static async logAudit(tableName, recordId, fieldName, newValue, action, userId) {
        const validActions = ['INSERT', 'UPDATE', 'DELETE', 'STATUS_CHANGE'];
        if (!validActions.includes(action)) {
            action = 'UPDATE';
        }

        await executeQuery(`
            INSERT INTO PayrollAuditLogs (
                tableName, recordId, fieldName, newValue, action, userId
            ) VALUES (
                @tableName, @recordId, @fieldName, @newValue, @action, @userId
            )
        `, {
            tableName,
            recordId: typeof recordId === 'string' ? 0 : parseInt(recordId) || 0,
            fieldName: fieldName || '',
            newValue: String(newValue || ''),
            action,
            userId: userId || 'system'
        });
    }

    static async getAuditLog(tableName, recordId, limit) {
        let query = `SELECT * FROM PayrollAuditLogs WHERE 1=1`;
        const params = {};
        
        if (tableName) {
            query += ' AND tableName = @tableName';
            params.tableName = tableName;
        }
        if (recordId) {
            query += ' AND recordId = @recordId';
            params.recordId = parseInt(recordId);
        }
        
        query += ` ORDER BY createdAt DESC`;
        if (limit) {
            query += ` OFFSET 0 ROWS FETCH NEXT @limit ROWS ONLY`;
            params.limit = parseInt(limit);
        }

        const result = await executeQuery(query, params);
        return result.recordset;
    }

    static async addVehicleTrip(data) {
        const { operationDate, shiftTypeId, vehicleId, driverCardId, note, createdBy } = data;

        await this.getOrCreateOperationDay(operationDate);

        const shiftType = await executeQuery(`
            SELECT * FROM PayrollShiftTypes WHERE id = @shiftTypeId
        `, { shiftTypeId });

        if (shiftType.recordset.length === 0) {
            throw new Error('ไม่พบ Shift Type');
        }

        // ⚠️ แก้บั๊ก: ฟังก์ชันนี้ไม่เคยเช็คมาก่อนว่ารถคันนี้มีเที่ยวอยู่แล้ว
        //    ในวันที่/รอบเดียวกันหรือไม่ ทำให้ถ้ากด "เพิ่มรถเข้ารอบ" ซ้ำ
        //    (หรือรถถูกสร้างไปแล้วจากการนำเข้าไฟล์สแกน) จะเกิดเที่ยวรถซ้ำ
        //    2 ใบสำหรับรถคันเดียวกัน — การ์ดรถในหน้าเว็บเลยโชว์ซ้ำกัน
        //    ตอนนี้เช็คก่อนด้วย tripExists เหมือนฝั่ง import ทุกจุด
        if (await this.tripExists(operationDate, shiftTypeId, vehicleId)) {
            throw new Error('รถคันนี้ถูกเพิ่มเข้ารอบนี้ในวันนี้ไปแล้ว (มีเที่ยวอยู่แล้ว) ไม่สามารถเพิ่มซ้ำได้');
        }

        const rate = await executeQuery(`
            SELECT TOP 1 rate FROM PayrollRateSettings 
            WHERE shiftCode = @shiftCode AND isActive = 1
            ORDER BY effectiveFrom DESC
        `, { shiftCode: shiftType.recordset[0].shiftCode });

        const fareUsed = rate.recordset[0]?.rate || 0;
        const fareType = shiftType.recordset[0].fareType;

        // ✅ แก้บั๊ก: เดิม totalFare ถูก hardcode เป็น 0 เสมอ ไม่ว่า fareType
        //    จะเป็นอะไร ทำให้รอบ flatByVehicle/perTrip (ราคาคงที่ต่อคัน/ต่อเที่ยว
        //    ไม่ได้สะสมจากค่ารถรายคน) เพิ่มรถเข้ารอบเองแล้วราคาไม่ขึ้นเลย
        //    ตอนนี้ถ้าเป็นราคาคงที่ ให้ตั้ง totalFare = fareUsed ทันทีตอนสร้าง
        //    ส่วน perHead ยังคงเป็น 0 เหมือนเดิม เพราะต้องรอสะสมจากพนักงาน
        //    ที่ถูกเพิ่มเข้ามาทีหลัง (ผ่าน updateTripTotals)
        const initialTotalFare = (fareType === 'flatByVehicle' || fareType === 'perTrip') ? fareUsed : 0;

        const result = await executeQuery(`
            INSERT INTO PayrollVehicleTrips (
                operationDate, shiftTypeId, vehicleId, driverCardId,
                fareType, fareUsed, totalFare, status, note, createdBy
            ) OUTPUT INSERTED.id
            VALUES (
                @operationDate, @shiftTypeId, @vehicleId, @driverCardId,
                @fareType, @fareUsed, @initialTotalFare, 'draft', @note, @createdBy
            )
        `, {
            operationDate,
            shiftTypeId,
            vehicleId,
            driverCardId: driverCardId || null,
            fareType,
            fareUsed,
            initialTotalFare,
            note: note || '',
            createdBy: createdBy || 'system'
        });

        const tripId = result.recordset[0].id;
        await this.updateDaySummary(operationDate);

        return { id: tripId, operationDate, shiftTypeId, vehicleId };
    }

    // ─── REMOVE VEHICLE TRIP ───
    static async removeVehicleTrip(id, userId) {
        const trip = await executeQuery(`
            SELECT * FROM PayrollVehicleTrips WHERE id = @id AND status != 'locked'
        `, { id });

        if (trip.recordset.length === 0) {
            throw new Error('ไม่พบข้อมูล VehicleTrip หรือถูกล็อกแล้ว');
        }

        // The database status constraint has no "deleted" value. Remove the
        // dependent riders first, then remove the trip itself so it vanishes
        // from Daily without changing it to the unrelated "locked" status.
        await executeQuery(`
            DELETE FROM PayrollTripEmployees WHERE vehicleTripId = @id
        `, { id });
        await executeQuery(`DELETE FROM PayrollVehicleTrips WHERE id = @id`, { id });

        await this.logAudit('PayrollVehicleTrips', id, 'status', 'removed', 'DELETE', userId);

        const tripData = trip.recordset[0];
        await this.updateDaySummary(tripData.operationDate);

        return { id, message: 'ลบรถสำเร็จ' };
    }

    // ─── CREATE PAYROLL PERIOD ───
    static async createPayrollPeriod(data) {
        const { startDate, endDate, label, createdBy } = data;

        const check = await executeQuery(`
            SELECT id FROM PayrollPeriod 
            WHERE (startDate <= @endDate AND endDate >= @startDate)
            AND isDeleted = 0
        `, { startDate, endDate });

        if (check.recordset.length > 0) {
            throw new Error('มีช่วงวันที่ซ้อนทับกับงวดจ่ายเงินที่มีอยู่แล้ว');
        }

        const result = await executeQuery(`
            INSERT INTO PayrollPeriod (startDate, endDate, label, status, createdAt)
            OUTPUT INSERTED.id
            VALUES (@startDate, @endDate, @label, 'open', GETDATE())
        `, { startDate, endDate, label });

        const id = result.recordset[0].id;

        await executeQuery(`
            UPDATE PayrollOperationDays SET status = 'locked'
            WHERE operationDate BETWEEN @startDate AND @endDate
            AND status NOT IN ('locked', 'paid')
        `, { startDate, endDate });

        await this.logAudit('PayrollPeriod', id, 'create', label, 'INSERT', createdBy || 'system');

        return { id, startDate, endDate, label, status: 'open' };
    }

    // ─── UPDATE ASSIGNMENT ───
    static async updateAssignment(id, data) {
        const { vehicleId, shiftTypeId, fare, totalRiders, note, driverCardId, tripCount, userId, manualOverride } = data;

        const trip = await executeQuery(`
            SELECT * FROM PayrollVehicleTrips WHERE id = @id AND status != 'locked'
        `, { id });

        if (trip.recordset.length === 0) {
            throw new Error('ไม่พบข้อมูล VehicleTrip หรือถูกล็อกแล้ว');
        }
        const tripData = trip.recordset[0];

        const updates = [];
        const params = { id };

        // ✅ แก้บั๊ก: เดิม modal "แก้ไขเที่ยวรถ" ไม่มีช่องจำนวนเที่ยว (tripSeq) เลย
        //    กรณีคนขับลืมสแกน แล้วแอดมินต้องปรับย้อนหลังจาก 1 เที่ยว → 2 เที่ยว
        //    ทำได้แค่พิมพ์ค่ารถ (fareUsed) เองตรงๆ แต่คอลัมน์ tripSeq ในฐานข้อมูล
        //    ไม่เคยถูกอัปเดตตาม (รายงานสรุปที่นับเที่ยวจาก tripSeq เพี้ยน) และราคา
        //    ก็ไม่ได้ดึงจากตาราง PayrollVehicleRates ที่ตั้งไว้ต่อคัน (500/550 บ.)
        //    ให้อัตโนมัติ ตอนนี้ถ้าส่ง tripCount มา จะอัปเดต tripSeq เสมอ และถ้า
        //    ไม่ได้ส่ง fare มาด้วย (ไม่ได้ตั้งใจพิมพ์ราคาเอง) กับเที่ยวที่เป็น
        //    fareType = 'perTrip' จะดึงราคาจาก PayrollVehicleRates ตาม
        //    (vehicleId, tripCount) มาเติมให้อัตโนมัติ — ยังพิมพ์ราคาเองทับได้ตามปกติ
        //    ถ้าส่ง fare มาด้วยพร้อมกัน
        let resolvedFare = fare;
        if (tripCount !== undefined) {
            updates.push('tripSeq = @tripCount');
            params.tripCount = tripCount;

            if (resolvedFare === undefined && tripData.fareType === 'perTrip') {
                const targetVehicleId = vehicleId !== undefined ? vehicleId : tripData.vehicleId;
                const autoRate = await this.getVehicleNightRate(targetVehicleId, tripCount);
                if (autoRate !== null) {
                    resolvedFare = autoRate;
                } else {
                    console.warn(`⚠️ updateAssignment: ไม่พบราคาที่ตั้งไว้สำหรับรถ vehicleId=${targetVehicleId} (${tripCount} เที่ยว) — ค่ารถเดิมจะไม่ถูกเปลี่ยน กรุณาตั้งราคาใน "จัดการอัตรารถ" ก่อน`);
                }
            }
        }

        if (vehicleId !== undefined) { 
            updates.push('vehicleId = @vehicleId'); 
            params.vehicleId = vehicleId; 
        }
        if (shiftTypeId !== undefined) { 
            updates.push('shiftTypeId = @shiftTypeId'); 
            params.shiftTypeId = shiftTypeId; 
        }
        if (resolvedFare !== undefined) { 
            updates.push('fareUsed = @fare'); 
            params.fare = resolvedFare; 
        }
        if (totalRiders !== undefined) { 
            updates.push('totalRiders = @totalRiders'); 
            params.totalRiders = totalRiders; 
        }
        // ✅ เพิ่ม "ปรับยอดเอง" (isManualOverride) — กรณีรอบรายหัว (perHead) ที่รายชื่อ
        //    พนักงานในระบบไม่ครบ (เช่น พนักงานทำงานเสร็จแล้วออกโดยไม่ได้แตะบัตรสแกน)
        //    เดิมต่อให้พิมพ์ "ค่ารถ"/"จำนวนพนักงาน" เองในหน้าแก้ไข ค่าที่กรอกก็ไม่มีผล
        //    เพราะรอบ perHead จะถูกคำนวณทับจาก SUM(fare)/COUNT(*) ของ PayrollTripEmployees
        //    เสมอ (ดู updateTripTotals ด้านล่าง) ตอนนี้ถ้าแอดมินติ๊ก "ปรับยอดเอง" ในหน้า
        //    แก้ไขเที่ยวรถ ระบบจะยึดค่า fare/totalRiders ที่กรอกเป็นตัวจริง ไม่คำนวณทับ
        //    จากรายชื่อพนักงานอีก แม้จะมีการเพิ่ม/ลบชื่อภายหลังก็ตาม จนกว่าจะติ๊กออก
        if (manualOverride === true) {
            updates.push('isManualOverride = 1');
        } else if (manualOverride === false) {
            updates.push('isManualOverride = 0');
        }
        if (note !== undefined) { 
            updates.push('note = @note'); 
            params.note = note; 
        }
        // ✅ เพิ่มรองรับเปลี่ยนคนขับ (driverCardId) — เดิมไม่มีเลย
        //    ทำให้ปุ่ม "เปลี่ยนคนขับ" ที่ตกลงกันไว้ทำงานจริงไม่ได้
        if (driverCardId !== undefined) {
            updates.push('driverCardId = @driverCardId');
            params.driverCardId = driverCardId || null;
        }
        updates.push('updatedAt = GETDATE()');

        if (updates.length > 1) {
            await executeQuery(`
                UPDATE PayrollVehicleTrips SET ${updates.join(', ')}
                WHERE id = @id
            `, params);

            // ✅ แก้บั๊ก: เดิมคำนวณ totalFare = fareUsed * totalRiders สำหรับรอบ
            //    ที่ไม่ใช่ flatByVehicle/perTrip (เช่น perHead) — แต่รอบ perHead
            //    ไม่เคยเก็บราคาไว้ที่ fareUsed เลย (fareUsed ถูกตั้งเป็น 0 เสมอ
            //    ตอนสร้างเที่ยวรถ เพราะราคาคิดที่รายคนใน PayrollTripEmployees.fare
            //    แทน) ผลคือทุกครั้งที่กด "แก้ไขข้อมูล" แล้วบันทึก (ต่อให้ไม่ได้
            //    ตั้งใจแก้ค่ารถเลย) totalFare จะถูกทับเป็น fareUsed(=0) × totalRiders
            //    = 0 ทันที ทั้งที่พนักงานแต่ละคนมีค่ารถของตัวเองอยู่ครบ
            //    ตอนนี้แยกตรรกะตาม fareType: รอบราคาคงที่ (flatByVehicle/perTrip)
            //    ใช้ fareUsed ตรงๆ ตามเดิม ส่วนรอบ perHead (หรือรอบอื่นที่คิดรายหัว)
            //    ให้รวมยอดจาก SUM(fare) ของพนักงานจริงในเที่ยวรถนั้นแทน เหมือนที่
            //    updateTripTotals() ใช้ ไม่พึ่ง fareUsed ซึ่งไม่เคยถูกตั้งค่าจริง
            // ✅ ถ้าติ๊ก "ปรับยอดเอง" (isManualOverride = 1) ให้ยึด fareUsed/totalRiders
            //    ที่เพิ่งบันทึกไปเป็นตัวจริงตรงๆ ไม่คำนวณทับจากรายชื่อพนักงานอีก
            //    ไม่ว่าจะเป็นรอบราคาคงที่หรือรายหัวก็ตาม
            await executeQuery(`
                UPDATE vt SET
                    vt.totalFare = CASE
                        WHEN vt.isManualOverride = 1 THEN vt.fareUsed
                        WHEN vt.fareType IN ('flatByVehicle', 'perTrip') THEN vt.fareUsed
                        ELSE ISNULL((
                            SELECT SUM(te.fare) FROM PayrollTripEmployees te
                            WHERE te.vehicleTripId = vt.id
                        ), 0)
                    END
                FROM PayrollVehicleTrips vt
                WHERE vt.id = @id
            `, { id });
        }

        // ✅ ถ้าเพิ่งติ๊ก "ปรับยอดเอง" ออก (กลับไปคำนวณอัตโนมัติ) ให้คำนวณยอดใหม่
        //    จากรายชื่อพนักงานจริงในเที่ยวรถทันที แทนที่จะค้างค่าที่เคยพิมพ์เองไว้
        if (manualOverride === false) {
            await this.updateTripTotals(id);
        }

        await this.logAudit('PayrollVehicleTrips', id, 'assignment', 'updated', 'UPDATE', userId || 'system');

        await this.updateDaySummary(tripData.operationDate);

        return { id, message: 'อัปเดตสำเร็จ' };
    }

    // ✅ ลบพนักงานคนเดียวออกจากเที่ยวรถ แล้วคำนวณ totalRiders/totalFare ใหม่
    static async removeTripEmployee(tripEmployeeId, userId) {
        const row = await executeQuery(`
            SELECT te.*, vt.status AS tripStatus
            FROM PayrollTripEmployees te
            INNER JOIN PayrollVehicleTrips vt ON te.vehicleTripId = vt.id
            WHERE te.id = @id
        `, { id: tripEmployeeId });

        if (row.recordset.length === 0) {
            throw new Error('ไม่พบพนักงานในเที่ยวรถนี้');
        }
        const record = row.recordset[0];
        if (record.tripStatus === 'locked') {
            throw new Error('เที่ยวรถนี้ถูกล็อกแล้ว แก้ไขไม่ได้');
        }

        await executeQuery(`DELETE FROM PayrollTripEmployees WHERE id = @id`, { id: tripEmployeeId });
        await this.updateTripTotals(record.vehicleTripId);
        await this.logAudit('PayrollTripEmployees', tripEmployeeId, 'employee', record.cardId, 'DELETE', userId || 'system');

        return { id: tripEmployeeId, vehicleTripId: record.vehicleTripId, message: 'ลบพนักงานออกจากเที่ยวรถสำเร็จ' };
    }

    static async updateTripTotals(tripId) {
        const result = await executeQuery(`
            SELECT 
                COUNT(*) as totalRiders,
                ISNULL(SUM(fare), 0) as totalFare
            FROM PayrollTripEmployees
            WHERE vehicleTripId = @tripId
        `, { tripId });

        const data = result.recordset[0] || { totalRiders: 0, totalFare: 0 };

        // ✅ แก้บั๊ก: ของเดิมคำนวณ totalFare = SUM(fare รายคน) เสมอ ไม่สนใจ
        //    fareType ของเที่ยวรถ แต่รอบ flatByVehicle/perTrip (ราคาคงที่ต่อคัน/
        //    ต่อเที่ยว) บันทึก fare รายคนเป็น 0 เสมอโดยตั้งใจ (ดู
        //    processFlatByVehicleShift) เพราะราคาคิดที่รถ ไม่ใช่รายหัว —
        //    ผลคือทุกครั้งที่มีการเพิ่ม/ลบพนักงานออกจากรถ (ผ่าน addEmployeeToTrip,
        //    removeTripEmployee, resolveUnassignedRider) ฟังก์ชันนี้จะรีเซ็ต
        //    totalFare ของรอบราคาคงที่กลับเป็น 0 ทับราคาที่ถูกต้องอยู่แล้ว
        //    ตอนนี้เช็ค fareType ก่อน ถ้าเป็นราคาคงที่ ให้อัปเดตแค่ totalRiders
        //    และคงค่า totalFare (= fareUsed) เดิมไว้ ไม่คำนวณจาก SUM(fare) ทับ
        const tripResult = await executeQuery(`
            SELECT fareType, fareUsed, isManualOverride FROM PayrollVehicleTrips WHERE id = @tripId
        `, { tripId });
        const trip = tripResult.recordset[0];

        // ✅ ถ้าแอดมินติ๊ก "ปรับยอดเอง" ไว้ (isManualOverride) ห้ามคำนวณทับ แม้จะมี
        //    การเพิ่ม/ลบชื่อพนักงานในเที่ยวรถนี้ภายหลังก็ตาม (เช่น ระบบจับคู่สแกน
        //    เพิ่มชื่อเข้ามาทีหลัง) เพราะยอด ค่ารถ/จำนวนคน ที่ถูกต้องจริงถูกกำหนด
        //    ไว้เองแล้ว ไม่ได้อ้างอิงจากรายชื่อที่สแกนได้ครบหรือไม่ครบ
        if (trip && trip.isManualOverride) {
            return;
        }

        const isFixedPrice = trip && (trip.fareType === 'flatByVehicle' || trip.fareType === 'perTrip');

        if (isFixedPrice) {
            await executeQuery(`
                UPDATE PayrollVehicleTrips SET
                    totalRiders = @totalRiders,
                    updatedAt = GETDATE()
                WHERE id = @tripId
            `, {
                tripId,
                totalRiders: data.totalRiders || 0
            });
            return;
        }

        await executeQuery(`
            UPDATE PayrollVehicleTrips SET
                totalRiders = @totalRiders,
                totalFare = @totalFare,
                updatedAt = GETDATE()
            WHERE id = @tripId
        `, {
            tripId,
            totalRiders: data.totalRiders || 0,
            totalFare: data.totalFare || 0
        });
    }
    // ─── เพิ่มพนักงานจากทะเบียนโดยตรงเข้าเที่ยวรถ ───
    static async addEmployeeToTrip(vehicleTripId, employeeId, userId = 'system') {
        const tripResult = await executeQuery(`
            SELECT id, status FROM PayrollVehicleTrips WHERE id = @vehicleTripId
        `, { vehicleTripId });
        const trip = tripResult.recordset[0];
        if (!trip) throw new Error('ไม่พบเที่ยวรถ');
        if (trip.status === 'locked') throw new Error('เที่ยวรถนี้ถูกล็อกแล้ว');

        const employeeResult = await executeQuery(`
            SELECT id, cardId, name, department, section, address, fare
            FROM Employees WHERE id = @employeeId
        `, { employeeId });
        const employee = employeeResult.recordset[0];
        if (!employee) throw new Error('ไม่พบพนักงาน');
        if (!employee.cardId || !employee.name) throw new Error('ข้อมูลพนักงานไม่สมบูรณ์');

        const duplicateResult = await executeQuery(`
            SELECT COUNT(*) AS cnt FROM PayrollTripEmployees
            WHERE vehicleTripId = @vehicleTripId AND cardId = @cardId
        `, { vehicleTripId, cardId: employee.cardId });
        if (duplicateResult.recordset[0]?.cnt > 0) throw new Error('พนักงานคนนี้อยู่ในรถคันนี้แล้ว');

        const inserted = await executeQuery(`
            INSERT INTO PayrollTripEmployees (
                vehicleTripId, employeeId, cardId, nameSnapshot,
                department, section, destination, fare, isDriver
            )
            OUTPUT INSERTED.*
            VALUES (
                @vehicleTripId, @employeeId, @cardId, @name,
                @department, @section, @destination, @fare, 0
            )
        `, {
            vehicleTripId,
            employeeId: employee.id,
            cardId: employee.cardId,
            name: employee.name,
            department: employee.department || '',
            section: employee.section || '',
            destination: employee.address || '',
            fare: employee.fare || 0
        });

        await this.updateTripTotals(vehicleTripId);
        await this.logAudit('PayrollTripEmployees', inserted.recordset[0].id, 'employee', employee.cardId, 'INSERT', userId);
        return inserted.recordset[0];
    }

    // ─── RESOLVE UNASSIGNED RIDER (เพิ่มพนักงานที่ค้างอยู่ใน PayrollUnassignedRiders เข้ารถที่เลือก) ───
    // ⚠️ เพิ่มใหม่: daily.js เรียก PUT /unassigned-riders/:id/resolve อยู่แล้ว
    //    (ตอนกด "+ เพิ่มพนักงาน" แล้วเลือกคนจากลิสต์ที่ยังไม่มีรถ) แต่ route
    //    นี้ไม่เคยถูกสร้างขึ้นฝั่ง backend เลย ทำให้ได้ 404 ทุกครั้ง
    static async resolveUnassignedRider(unassignedId, vehicleId, userId = 'system') {
        // 1. ดึงแถว PayrollUnassignedRiders ที่จะ resolve
        const urResult = await executeQuery(`
            SELECT * FROM PayrollUnassignedRiders WHERE id = @id AND status = 'pending'
        `, { id: unassignedId });
        const ur = urResult.recordset[0];
        if (!ur) {
            throw new Error('ไม่พบรายการนี้ หรือถูกจัดการไปแล้ว');
        }

        // 2. หา VehicleTrip ปลายทาง (วันเดียวกัน รอบเดียวกัน รถที่เลือก)
        const tripResult = await executeQuery(`
            SELECT * FROM PayrollVehicleTrips
            WHERE operationDate = @date AND shiftTypeId = @shiftTypeId
              AND vehicleId = @vehicleId AND status != 'deleted'
        `, { date: ur.operationDate, shiftTypeId: ur.shiftTypeId, vehicleId });
        const trip = tripResult.recordset[0];
        if (!trip) {
            throw new Error('รถคันนี้ยังไม่มีเที่ยวในรอบนี้ของวันดังกล่าว กรุณาเพิ่มรถเข้ารอบก่อน');
        }

        // 3. ดึงข้อมูลพนักงานปัจจุบัน (เอา department/section/destination สดๆ)
        let emp = {};
        if (ur.employeeId) {
            const empResult = await executeQuery(`SELECT * FROM Employees WHERE id = @id`, { id: ur.employeeId });
            emp = empResult.recordset[0] || {};
        }

        // 4. กันเพิ่มซ้ำ ถ้าคนนี้อยู่ในเที่ยวนี้แล้ว
        const dupCheck = await executeQuery(`
            SELECT COUNT(*) as cnt FROM PayrollTripEmployees
            WHERE vehicleTripId = @tripId AND cardId = @cardId
        `, { tripId: trip.id, cardId: ur.cardId });
        if (dupCheck.recordset[0]?.cnt > 0) {
            throw new Error('พนักงานคนนี้อยู่ในรถคันนี้แล้ว');
        }

        // 5. เพิ่มเข้า PayrollTripEmployees
        await executeQuery(`
            INSERT INTO PayrollTripEmployees (
                vehicleTripId, employeeId, cardId, nameSnapshot,
                department, section, destination, fare, isDriver
            ) VALUES (
                @tripId, @employeeId, @cardId, @name,
                @department, @section, @destination, @fare, 0
            )
        `, {
            tripId: trip.id,
            employeeId: ur.employeeId || null,
            cardId: ur.cardId,
            name: ur.nameSnapshot || emp.name || '',
            department: emp.department || '',
            section: emp.section || '',
            destination: emp.address || '',
            fare: ur.fare || 0
        });

        // 6. ปิดรายการใน PayrollUnassignedRiders
        await executeQuery(`
            UPDATE PayrollUnassignedRiders SET
                status = 'resolved', expectedVehicleId = @vehicleId, updatedAt = GETDATE()
            WHERE id = @id
        `, { id: unassignedId, vehicleId });

        // 7. อัปเดตยอดรวมของเที่ยวรถ
        await this.updateTripTotals(trip.id);

        return { tripId: trip.id, vehicleId };
    }
}

module.exports = PayrollEngine;
