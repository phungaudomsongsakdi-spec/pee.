    static async ensureDefaultShiftTypes() {
        const existing = await executeQuery('SELECT COUNT(*) AS count FROM PayrollShiftTypes');
        if (Number(existing.recordset[0]?.count || 0) > 0) return;

        const defaults = [
            ['D', 'เข้าเช้า', '06:00', '07:59', 'perHead', 0, 1],
            ['N', 'ออกกะ', '08:00', '09:00', 'perHead', 0, 2],
            ['EVENING_IN_16', 'เข้า 16:00', '15:00', '15:59', 'perHead', 0, 3],
            ['EVENING_OUT_16', 'ออก 16:00', '16:00', '16:30', 'perHead', 0, 4],
            ['EVENING_17', '17:00', '16:30', '17:30', 'flatByVehicle', 300, 5],
            ['NIGHT_20', '20:00', '19:00', '20:59', 'perTrip', 0, 6]
        ];

        for (const [shiftCode, shiftName, startTime, endTime, fareType, defaultRate, displayOrder] of defaults) {
            await executeQuery(`
                INSERT INTO PayrollShiftTypes
                    (shiftCode, shiftName, startTime, endTime, fareType, defaultRate, isActive, displayOrder)
                SELECT @shiftCode, @shiftName, @startTime, @endTime, @fareType, @defaultRate, 1, @displayOrder
                WHERE NOT EXISTS (SELECT 1 FROM PayrollShiftTypes WHERE shiftCode = @shiftCode)
            `, { shiftCode, shiftName, startTime, endTime, fareType, defaultRate, displayOrder });
        }
    }
    
