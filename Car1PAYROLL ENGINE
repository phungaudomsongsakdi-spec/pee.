    // ✅ แปลงค่าเวลาให้เป็น string 'HH:MM' เสมอ ไม่ว่าจะเป็น string หรือ Date object
    // (SQL Server TIME column ถูก mssql driver แปลงกลับมาเป็น JS Date object โดยอัตโนมัติ
    //  เช่น 1970-01-01T06:00:00.000Z ไม่ใช่ string "06:00" เหมือนตอนอ่านจาก Excel)
    static toHHMM(value) {
        if (value == null) return null;
        if (value instanceof Date) {
            // mssql driver คืนค่า TIME เป็น Date แบบ UTC (useUTC default = true)
            const h = String(value.getUTCHours()).padStart(2, '0');
            const m = String(value.getUTCMinutes()).padStart(2, '0');
            return `${h}:${m}`;
        }
        return String(value).padStart(5, '0').slice(0, 5);
    }

    static isInTimeRange(time, start, end) {
        if (!time) return false;
        const t = this.toHHMM(time);
        const s = this.toHHMM(start);
        const e = this.toHHMM(end);
        if (t === null || s === null || e === null) return false;
        return t >= s && t <= e;
    }

    static findColumn(headers, keywords) {
        for (const keyword of keywords) {
            const found = headers.find(h => {
                const hStr = String(h).trim().toLowerCase();
                const kStr = String(keyword).toLowerCase();
                return hStr.includes(kStr) || kStr.includes(hStr);
            });
            if (found) return found;
        }
        return null;
    }

    // ─── PARSE DATE ───
    static parseDate(value) {
        if (!value) return null;
        const str = String(value).trim();
        if (!str) return null;
        
        if (str.includes('/')) {
            const parts = str.split('/');
            if (parts.length === 3) {
                let part1 = parts[0].trim();
                let part2 = parts[1].trim();
                let part3 = parts[2].trim();
                
                const p1 = parseInt(part1);
                const p2 = parseInt(part2);
                
                let day, month, year;
                
                if (p1 <= 12 && p2 <= 31) {
                    month = part1.padStart(2, '0');
                    day = part2.padStart(2, '0');
                } else if (p1 > 12 && p2 <= 12) {
                    day = part1.padStart(2, '0');
                    month = part2.padStart(2, '0');
                } else if (part1.length === 4) {
                    year = part1;
                    month = part2.padStart(2, '0');
                    day = part3.padStart(2, '0');
                    if (parseInt(year) > 2400) year = parseInt(year) - 543;
                    return `${year}-${month}-${day}`;
                } else {
                    day = '01';
                    month = '01';
                }
                
                year = part3;
                if (year.length === 2) {
                    year = 2000 + parseInt(year);
                }
                if (year.length === 4 && parseInt(year) > 2400) {
                    year = parseInt(year) - 543;
                }
                
                return `${year}-${month}-${day}`;
            }
        }
        
        if (str.includes('-') && str.includes(':')) {
            const match = str.match(/(\d{4}-\d{2}-\d{2})/);
            if (match) return match[1];
        }
        
        if (str.includes('-') && str.length >= 10) {
            const parts = str.split('-');
            if (parts.length === 3) {
                let year = parts[0];
                let month = parts[1].padStart(2, '0');
                let day = parts[2].padStart(2, '0');
                if (day.length > 2) day = day.substring(0, 2);
                if (parseInt(year) > 2400) year = parseInt(year) - 543;
                return `${year}-${month}-${day}`;
            }
            return str.slice(0, 10);
        }
        
        return null;
    }

    // ─── PARSE TIME ───
    static parseTime(value) {
        if (!value) return null;
        const str = String(value).trim();
        if (!str) return null;
        
        if (str.includes(':')) {
            const parts = str.split(':');
            if (parts.length >= 2) {
                const hour = parts[0].padStart(2, '0');
                const minute = parts[1].padStart(2, '0');
                return `${hour}:${minute}`;
            }
        }
        
        const match = str.match(/(\d{2}:\d{2}):\d{2}/);
        if (match) return match[1];
        
        return null;
    }

    // ─── API FUNCTIONS ───
    static async getDaySummary(date) {
        const opDay = await executeQuery(`
            SELECT * FROM PayrollOperationDays WHERE operationDate = @date
        `, { date });

        if (opDay.recordset.length === 0) {
            return { operationDate: date, status: 'draft', totalVehicles: 0, totalEmployees: 0, totalFare: 0, vehicles: [] };
        }

        const trips = await executeQuery(`
            SELECT vt.*, st.shiftCode, st.shiftName, st.fareType as shiftFareType,
                   v.displayNumber, v.plate,
                   v.driver AS defaultDriverName,
                   de.name AS confirmedDriverName
            FROM PayrollVehicleTrips vt
            INNER JOIN PayrollShiftTypes st ON vt.shiftTypeId = st.id
            INNER JOIN Vehicles v ON vt.vehicleId = v.id
            LEFT JOIN Employees de ON vt.driverCardId COLLATE DATABASE_DEFAULT = de.cardId COLLATE DATABASE_DEFAULT
            WHERE vt.operationDate = @date AND vt.status != 'deleted'
            ORDER BY st.displayOrder, vt.vehicleId
        `, { date });

        const vehicleTrips = [];
        for (const trip of trips.recordset) {
            const employees = await executeQuery(`
                SELECT te.*, e.name
                FROM PayrollTripEmployees te
                INNER JOIN Employees e ON te.employeeId = e.id
                WHERE te.vehicleTripId = @tripId
            `, { tripId: trip.id });

            vehicleTrips.push({
                ...trip,
                employees: employees.recordset
            });
        }

        return {
            operationDay: opDay.recordset[0],
            vehicles: vehicleTrips,
            totalVehicles: vehicleTrips.length,
            totalEmployees: vehicleTrips.reduce((sum, t) => sum + (t.totalRiders || 0), 0),
            totalFare: vehicleTrips.reduce((sum, t) => sum + (t.totalFare || 0), 0)
        };
    }

    static async getMonthSummary(yearMonth) {
        const [year, month] = yearMonth.split('-').map(Number);
        const startDate = `${year}-${String(month).padStart(2, '0')}-01`;
        const endDate = `${year}-${String(month).padStart(2, '0')}-${new Date(year, month, 0).getDate()}`;

        const result = await executeQuery(`
            SELECT 
                od.operationDate,
                od.status,
                od.totalVehicles,
                od.totalEmployees,
                od.totalFare
            FROM PayrollOperationDays od
            WHERE od.operationDate BETWEEN @startDate AND @endDate
            ORDER BY od.operationDate
        `, { startDate, endDate });

