// ✅ ใช้โดยรายงาน "เช็คชื่อมา/ไม่มา รายคัน" — คืนรายการวันที่ทุกวันในช่วง (รวมวันที่ไม่มีข้อมูล)
//    เป็น string 'YYYY-MM-DD' เรียงจากน้อยไปมาก ต่างจาก dateSet ที่ทำจากข้อมูลจริง
//    (ซึ่งจะขาดวันที่ไม่มีเที่ยวรถไปเลย ทั้งที่ตารางเช็คชื่อต้องโชว์ทุกวันในช่วงที่เลือก)
function buildDateRange(startDate, endDate) {
    const dates = [];
    let cur = new Date(`${startDate}T00:00:00`);
    const end = new Date(`${endDate}T00:00:00`);
    while (cur <= end) {
        const y = cur.getFullYear();
        const m = String(cur.getMonth() + 1).padStart(2, '0');
        const dd = String(cur.getDate()).padStart(2, '0');
        dates.push(`${y}-${m}-${dd}`);
        cur.setDate(cur.getDate() + 1);
    }
    return dates;
}
function xlsxUniqueSheetName(workbook, name) {
    // ชื่อชีทห้ามเกิน 31 ตัวอักษร และห้ามมีอักขระ \/?*[]: — กันชื่อซ้ำด้วย
    let safeName = String(name).replace(/[\\/?*[\]:]/g, '-').slice(0, 31);
    let finalName = safeName;
    let n = 2;
    while (workbook.getWorksheet(finalName)) {
        finalName = `${safeName.slice(0, 28)}(${n++})`;
    }
    return finalName;
}

// ⚠️ แก้บั๊ก: emp.vehicleRaw คือข้อความดิบจากไฟล์สแกน (เช่น "12A" ไม่มีขีด
//    ตามที่พบจริงในไฟล์) แต่ Vehicles.displayNumber ในฐานข้อมูลเก็บเป็น
//    "12-A" (มีขีด) การเทียบด้วย String().trim() ตรงๆ แบบเดิมจึงหาไม่เจอ
//    เงียบๆ พนักงานที่ขึ้นรถเบอร์ 12A จะหลุดไป PayrollUnassignedRiders
//    (reason: 'no_vehicle') ทั้งที่จริงมีรถอยู่ — ฟังก์ชันนี้ normalize
//    ทั้งฝั่ง vehicleRaw และฝั่ง displayNumber ให้อยู่รูปแบบเดียวกันก่อนเทียบ
//    (ตัวเลขล้วน -> ตัวเลข, ตัวเลข+ตัวอักษร -> "เลข-ตัวอักษร" ตัวพิมพ์ใหญ่)
function normalizeVehicleKey(value) {
    if (value === null || value === undefined) return '';
    const str = String(value).trim().toUpperCase();
    if (str === '') return '';
    const pureNum = str.match(/^(\d+)(\.0+)?$/);
    if (pureNum) return pureNum[1];
    const numLetter = str.match(/^(\d+)\s*-?\s*([A-Z])$/);
    if (numLetter) return `${numLetter[1]}-${numLetter[2]}`;
    return str;
}

// ⚠️ แก้บั๊ก: หน้า "สร้างพนักงานจาก Unmatched" ส่ง defaultVehicleId มาเป็น
//    ค่าจาก <select> ซึ่งควรจะเป็น id ตัวเลขของ Vehicles เสมอ แต่ในทางปฏิบัติ
//    เจอกรณีค่าที่ส่งมาเป็นเบอร์รถแบบข้อความ (เช่น "12-A") แทน — พอเอาไป
//    เข้าคิวรี่ `WHERE id = @id` ตรงๆ (คอลัมน์ id เป็น int) SQL Server จะ throw
//    'Conversion failed when converting the nvarchar value ... to data type int'
//    ทันที ทำให้ทั้ง endpoint ล่มทั้งที่ควรจะบันทึกได้ปกติ — ฟังก์ชันนี้เช็คก่อนว่า
//    ค่าที่ส่งมาเป็นเลข id ล้วนๆ หรือไม่ ถ้าใช่ค่อย query ด้วย id ตรงๆ (เคสปกติ)
//    ถ้าไม่ใช่ (มีตัวอักษร/ขีด ปนมา) ให้ลอง fallback ไปหาโดยเทียบ displayNumber/
//    vehicleNumber แทน (normalize รูปแบบให้ตรงกันก่อนเทียบ เหมือนที่ทำกับ
//    vehicleRaw ตอน import) เพื่อให้ยังบันทึกรถประจำได้ถูกคัน ไม่ error ทิ้งเฉยๆ
async function resolveVehicleByAnyId(rawValue) {
    if (rawValue === null || rawValue === undefined || rawValue === '') return null;
    console.log('🔧 resolveVehicleByAnyId ได้รับค่า:', JSON.stringify(rawValue), typeof rawValue);

    const isPureInt = /^\d+$/.test(String(rawValue).trim());
    if (isPureInt) {
        try {
            const byId = await executeQuery(`
                SELECT id, displayNumber, vehicleNumber FROM Vehicles WHERE id = @id
            `, { id: parseInt(rawValue, 10) });
            if (byId.recordset.length > 0) return byId.recordset[0];
            return null;
        } catch (err) {
            // 🔧 ถ้า error เกิดตรงนี้จริง ๆ จะเห็นชัดเจนว่ามาจากบล็อก isPureInt
            //    (ซึ่งไม่ควรเกิดขึ้นได้ เพราะ parseInt ให้ตัวเลขล้วนเสมอ)
            console.error('🔧 resolveVehicleByAnyId (isPureInt branch) error, rawValue=', JSON.stringify(rawValue), err.message);
            throw err;
        }
    }

    // ไม่ใช่เลข id ล้วนๆ (เช่น "12-A") — ลองจับคู่จากเบอร์รถแทน
    const targetKey = normalizeVehicleKey(rawValue);
    if (!targetKey) return null;

    try {
        const all = await executeQuery(`SELECT id, displayNumber, vehicleNumber FROM Vehicles`);
        for (const v of all.recordset) {
            if (normalizeVehicleKey(v.displayNumber) === targetKey || normalizeVehicleKey(v.vehicleNumber) === targetKey) {
                return v;
            }
        }
        return null;
    } catch (err) {
        console.error('🔧 resolveVehicleByAnyId (fallback branch) error, rawValue=', JSON.stringify(rawValue), err.message);
        throw err;
    }
}

// ⚠️ แก้บั๊ก: Employees.defaultVehicleNumber เป็นคอลัมน์ INT ในฐานข้อมูล
//    (ตรงกับ Vehicles.vehicleNumber ซึ่งเป็น INT เหมือนกัน) ไม่ใช่
//    Vehicles.displayNumber ซึ่งเป็น NVARCHAR และมีตัวอักษรปนได้ เช่น "12-A"
//    เดิมโค้ดเลือก veh.displayNumber ก่อนเสมอถ้ามีค่า ("12-A" || vehicleNumber)
//    แล้วยัดลง query ตรงๆ ทำให้ SQL Server throw
//    "Conversion failed when converting the nvarchar value '12-A' to data
//    type int." ทันทีที่รถคันนั้นมีเบอร์แสดงผลไม่ใช่ตัวเลขล้วน — ตอนนี้ใช้
//    vehicleNumber (int) เป็นหลักตามชนิดคอลัมน์จริง, fallback ไป displayNumber
//    เฉพาะกรณีบังเอิญเป็นตัวเลขล้วน (เช่น "7") เท่านั้น ถ้าไม่มีทั้งคู่ที่เป็น
//    ตัวเลขได้ (เช่นมีแต่ "12-A") ให้เป็น null แทนที่จะทำให้ทั้ง request ล้มเหลว
//    (defaultVehicleId ที่ resolveVehicleByAnyId คืนมายังคงชี้รถถูกคันเสมอ
//    ไม่ว่า defaultVehicleNumber จะบันทึกได้หรือไม่ก็ตาม)
function safeVehicleNumberForColumn(veh) {
    if (!veh) return null;
    if (veh.vehicleNumber !== null && veh.vehicleNumber !== undefined && veh.vehicleNumber !== '') {
        const n = parseInt(veh.vehicleNumber, 10);
        if (!isNaN(n)) return n;
    }
    if (veh.displayNumber && /^\d+$/.test(String(veh.displayNumber).trim())) {
        return parseInt(veh.displayNumber, 10);
    }
    return null;
}

