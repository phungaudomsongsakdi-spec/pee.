        await this.updateDaySummary(date);

        // ✅ ตรวจของจริงจาก DB ก่อน log ว่าสำเร็จ (ของเดิม print แบบไม่มีเงื่อนไข
        //    ทำให้ดูเหมือนสำเร็จทั้งที่ queries.length === 0 แล้วไม่มีอะไรถูก insert จริง)
        const tripCheck = await executeQuery(`
            SELECT COUNT(*) as cnt FROM PayrollVehicleTrips 
            WHERE operationDate = @date AND status != 'deleted'
        `, { date });
        const tripsCount = tripCheck.recordset[0]?.cnt || 0;

        if (tripsCount > 0) {
            console.log(`   ✅ สร้าง VehicleTrips สำหรับพนักงาน ${uniqueEmployees.length} คน / คนขับ ${uniqueDrivers.length} คน เรียบร้อย! (${tripsCount} เที่ยว)`);
        } else {
            console.warn(`   ⚠️ ประมวลผลจบแล้ว แต่ไม่มี VehicleTrips ถูกสร้างเลย (พนักงาน ${uniqueEmployees.length} คน น่าจะตกไปอยู่ใน PayrollUnassignedRiders ทั้งหมด เพราะไม่มีคนขับจับคู่ในรอบที่ตรงกัน — ตรวจดูตาราง PayrollUnassignedRiders ของวันที่ ${date})`);
