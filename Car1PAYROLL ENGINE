                defaultVehicleNumber = safeVehicleNumberForColumn(veh);
            }
        }

        // ✅ กันสร้างพนักงานซ้ำ: ถ้ามี cardId นี้ใน Employees อยู่แล้ว ใช้ id เดิม ไม่ insert ใหม่
        let employeeId;
        if (cardIdTrimmed) {
            const existingEmp = await executeQuery(`
                SELECT id FROM Employees WHERE cardId = @cardId
            `, { cardId: cardIdTrimmed });
            if (existingEmp.recordset.length > 0) {
                employeeId = existingEmp.recordset[0].id;
                // ✅ ถ้ามีพนักงานอยู่แล้ว (เช่นสร้างไว้ก่อนหน้าแต่ยังไม่ครบข้อมูล) ให้อัปเดต
                //    ค่ารถ/รถประจำที่กรอกรอบนี้ทับเข้าไปด้วย ไม่ใช่แค่จับคู่เฉยๆ
                await executeQuery(`
                    UPDATE Employees SET
                        fare = @fare,
                        defaultVehicleId = @defaultVehicleId,
                        defaultVehicleNumber = @defaultVehicleNumber,
                        updatedAt = GETDATE()
                    WHERE id = @id
                `, {
                    id: employeeId,
                    fare: data.fare || 0,
                    defaultVehicleId: resolvedVehicleId,
                    defaultVehicleNumber
                });
            }
        }

        if (!employeeId) {
            const result = await executeQuery(`
                INSERT INTO Employees (
                    cardId, firstName, lastName, name, department, section, fare,
                    defaultVehicleId, defaultVehicleNumber, status, isDriver
                ) OUTPUT INSERTED.id
                VALUES (
                    @cardId, @firstName, @lastName, @name, @department, @section, @fare,
                    @defaultVehicleId, @defaultVehicleNumber, 'active', 0
                )
            `, {
                cardId: finalCardId,
                firstName: data.firstName || row.firstName || '',
                lastName: data.lastName || row.lastName || '',
                name: `${data.firstName || row.firstName || ''} ${data.lastName || row.lastName || ''}`.trim() || row.cardId,
                department: data.department || row.departmentRaw || 'ไม่ระบุ',
                section: data.section || '',
                fare: data.fare || 0,
                defaultVehicleId: resolvedVehicleId,
                defaultVehicleNumber
            });
            employeeId = result.recordset[0].id;
        }

        // ✅ ปิดทุกแถว pending ใน PayrollUnmatchedPersons ที่เป็น cardId เดียวกัน ไม่ใช่แค่แถวที่กด
        //    (เผื่อยังมี record เก่าที่ insert ซ้ำไว้ก่อนแก้บั๊ก dedupe หรือกรณี cardId ว่างที่ fallback เป็น scanRowId)
        if (cardIdTrimmed) {
            await executeQuery(`
                UPDATE PayrollUnmatchedPersons SET
                    status = 'created',
                    createdEmployeeId = @employeeId,
                    updatedAt = GETDATE()
                WHERE cardId = @cardId AND status = 'pending'
            `, { cardId: cardIdTrimmed, employeeId });
        } else {
            await executeQuery(`
                UPDATE PayrollUnmatchedPersons SET
                    status = 'created',
                    createdEmployeeId = @employeeId,
                    updatedAt = GETDATE()
                WHERE id = @id
            `, { id, employeeId });
        }

        // ✅ จับคู่ย้อนหลังทุกวัน ทุกแถว scan ของ cardId นี้ที่เคยเป็น unmatched (ไม่ใช่แค่ scanRowId เดียว)
        //    ข้อนี้สำคัญที่สุด: ป้องกันไม่ให้วันอื่นๆ ของพนักงานคนนี้หลุดจากการคำนวณค่ารถ
        if (cardIdTrimmed) {
            await executeQuery(`
                UPDATE PayrollScanRows SET
                    matchedEmployeeId = @employeeId,
                    processedStatus = 'matched'
                WHERE cardId = @cardId AND processedStatus = 'unmatched'
            `, { employeeId, cardId: cardIdTrimmed });
        } else {
            await executeQuery(`
                UPDATE PayrollScanRows SET
                    matchedEmployeeId = @employeeId,
                    processedStatus = 'matched'
                WHERE id = @scanRowId
            `, { employeeId, scanRowId: row.scanRowId });
        }

        return { employeeId, name: `${data.firstName || row.firstName || ''} ${data.lastName || row.lastName || ''}`.trim() };
    }

    // ─── ปิดรายการ Unmatched ของ cardId ที่เพิ่งจับคู่เจอ (ใช้ร่วมกันทั้งจาก
    //     classifyRows ตอนประมวลผล/นำเข้าใหม่ และจาก createEmployeeFromUnmatched) ───
    static async closeUnmatchedByCardId(cardId, employeeId) {
        const trimmed = cardId ? String(cardId).trim() : '';
        if (!trimmed) return;
        await executeQuery(`
            UPDATE PayrollUnmatchedPersons SET
                status = 'created',
                createdEmployeeId = @employeeId,
                updatedAt = GETDATE()
            WHERE cardId = @cardId AND status = 'pending'
        `, { cardId: trimmed, employeeId });
    }

    static async ignoreUnmatched(id) {
        await executeQuery(`
            UPDATE PayrollUnmatchedPersons SET status = 'ignored', updatedAt = GETDATE()
            WHERE id = @id AND status = 'pending'
        `, { id });
        return { id, status: 'ignored' };
    }

    // ─── IGNORE UNASSIGNED RIDER (ลบออกจากแบนเนอร์ "ยังไม่ถูกจัดขึ้นรถ" โดยไม่จัดรถให้) ───
    //    ใช้ตอนกดปุ่ม "ลบ" ที่หน้า Daily — คนละเคสกับ resolveUnassignedRider (ที่จัดขึ้นรถจริง)
    //    แค่ mark สถานะเป็น 'ignored' คนนี้จะหายไปจากแบนเนอร์ (filter เอาเฉพาะ 'pending')
    //    แต่ยังอยู่ใน DB เพื่อดูย้อนหลังได้ ไม่ได้ถูกลบทิ้งจริง
    static async ignoreUnassignedRider(id) {
        const result = await executeQuery(`
            UPDATE PayrollUnassignedRiders SET status = 'ignored', updatedAt = GETDATE()
            WHERE id = @id AND status = 'pending'
        `, { id });
        if (result.rowsAffected[0] === 0) {
            throw new Error('ไม่พบรายการนี้ หรือถูกจัดการไปแล้ว');
        }
        return { id, status: 'ignored' };
    }

    // ─── GET SETTINGS ───
    static async getSettings() {
        const shiftTypes = await executeQuery(`
            SELECT * FROM PayrollShiftTypes ORDER BY displayOrder
        `);

        const rates = await executeQuery(`
            SELECT * FROM PayrollRateSettings WHERE isActive = 1 ORDER BY shiftCode
        `);

        return {
            shiftTypes: shiftTypes.recordset,
            rates: rates.recordset
        };
    }

    static async updateRate(shiftCode, rate, effectiveFrom) {
        const effectiveDate = effectiveFrom || new Date().toISOString().split('T')[0];
        
        await executeQuery(`
            UPDATE PayrollRateSettings SET isActive = 0, effectiveTo = DATEADD(day, -1, @effectiveFrom)
            WHERE shiftCode = @shiftCode AND isActive = 1
        `, { shiftCode, effectiveFrom: effectiveDate });

        const result = await executeQuery(`
            INSERT INTO PayrollRateSettings (shiftCode, rateType, rate, effectiveFrom, isActive)
            OUTPUT INSERTED.id
            VALUES (@shiftCode, @rateType, @rate, @effectiveFrom, 1)
        `, {
            shiftCode,
            rateType: 'perTrip',
            rate,
            effectiveFrom: effectiveDate
        });

        return { id: result.recordset[0].id, shiftCode, rate, effectiveFrom: effectiveDate };
    }

    static async getReport(startDate, endDate) {
        const trips = await executeQuery(`
            SELECT 
                vt.id,
                vt.operationDate,
                vt.shiftTypeId,
                vt.vehicleId,
                vt.driverCardId,
                vt.fareType,
                vt.fareUsed,
                vt.totalFare,
                vt.totalRiders,
                vt.isManualOverride,
                vt.tripSeq,
                vt.status,
                vt.note,
                vt.createdBy,
                vt.updatedBy,
                vt.createdAt,
                vt.updatedAt,
                st.shiftCode, 
                st.shiftName,
                st.fareType AS shiftFareType,
                v.displayNumber, 
                v.plate, 
                v.driver,
                COUNT(te.id) as employeeCount,
                ISNULL(SUM(te.fare), 0) as totalEmployeeFare
            FROM PayrollVehicleTrips vt
            INNER JOIN PayrollShiftTypes st ON vt.shiftTypeId = st.id
            INNER JOIN Vehicles v ON vt.vehicleId = v.id
            LEFT JOIN PayrollTripEmployees te ON te.vehicleTripId = vt.id
            WHERE vt.operationDate BETWEEN @startDate AND @endDate
            AND vt.status != 'deleted'
            GROUP BY 
                vt.id, 
                vt.operationDate, 
                vt.shiftTypeId, 
                vt.vehicleId,
                vt.driverCardId, 
                vt.fareType, 
                vt.fareUsed, 
                vt.totalFare,
                vt.totalRiders, 
                vt.isManualOverride,
                vt.tripSeq, 
                vt.status, 
                vt.note,
                vt.createdBy, 
                vt.updatedBy, 
                vt.createdAt, 
                vt.updatedAt,
                st.shiftCode, 
                st.shiftName,
                st.fareType,
                v.displayNumber, 
                v.plate, 
                v.driver
            ORDER BY vt.operationDate, st.shiftCode
        `, { startDate, endDate });

        // ✅ group ตาม "รถ + รอบ (shiftCode)" แยกกัน — ถ้าช่วงวันที่เลือกมีหลายวัน
        //    จะ sum รวมให้อัตโนมัติต่อคู่ (vehicleId, shiftCode) เดียวกัน
        const vehicleSummary = {};
        for (const trip of trips.recordset) {
            const key = `${trip.vehicleId}_${trip.shiftCode}`;
            if (!vehicleSummary[key]) {
                vehicleSummary[key] = {
                    vehicleId: trip.vehicleId,
                    displayNumber: trip.displayNumber,
                    plate: trip.plate,
                    driver: trip.driver,
                    shiftCode: trip.shiftCode,
                    shiftName: trip.shiftName,
                    totalTrips: 0,
                    totalFare: 0,
                    totalRiders: 0
                };
            }
            vehicleSummary[key].totalTrips += 1;
            vehicleSummary[key].totalFare += trip.totalFare || 0;
            vehicleSummary[key].totalRiders += trip.totalRiders || 0;
        }

        // เรียงตามเบอร์รถ แล้วตามรอบ ให้ดูง่ายเวลาแสดงผล/export
        const vehicleSummaryList = Object.values(vehicleSummary).sort((a, b) => {
            const numA = String(a.displayNumber ?? a.vehicleId);
            const numB = String(b.displayNumber ?? b.vehicleId);
            const cmp = numA.localeCompare(numB, 'th', { numeric: true });
            if (cmp !== 0) return cmp;
            return String(a.shiftCode || '').localeCompare(String(b.shiftCode || ''));
        });

        // ✅ group ซ้อนอีกชั้น: รถ -> รอบ (สำหรับตารางหลักแบบ pivot ในหน้ารายงานใหม่)
        //    เช่น รถเบอร์ 2 -> { D: {...}, N: {...} } พร้อมยอดรวมทั้งคัน
        const vehicleMap = {};
        for (const row of vehicleSummaryList) {
            if (!vehicleMap[row.vehicleId]) {
                vehicleMap[row.vehicleId] = {
                    vehicleId: row.vehicleId,
                    displayNumber: row.displayNumber,
                    plate: row.plate,
                    driver: row.driver,
                    shifts: {},
                    totalTrips: 0,
                    totalRiders: 0,
                    totalFare: 0
                };
            }
            const vm = vehicleMap[row.vehicleId];
            vm.shifts[row.shiftCode] = {
                shiftCode: row.shiftCode,
                shiftName: row.shiftName,
                totalTrips: row.totalTrips,
                totalRiders: row.totalRiders,
                totalFare: row.totalFare
            };
            vm.totalTrips += row.totalTrips;
            vm.totalRiders += row.totalRiders;
            vm.totalFare += row.totalFare;
        }
        const vehicles = Object.values(vehicleMap).sort((a, b) =>
            String(a.displayNumber ?? a.vehicleId).localeCompare(String(b.displayNumber ?? b.vehicleId), 'th', { numeric: true })
        );

        // ลำดับคอลัมน์รอบ: D ก่อน, N รองลงมา, ที่เหลือเรียงตามชื่อ (เผื่อมีรอบที่สร้างเองเพิ่ม)
        const shiftPriority = (code) => (code === 'D' ? 0 : code === 'N' ? 1 : 2);
        const shiftColumnMap = {};
        for (const row of vehicleSummaryList) {
            if (!shiftColumnMap[row.shiftCode]) {
                shiftColumnMap[row.shiftCode] = { shiftCode: row.shiftCode, shiftName: row.shiftName };
            }
        }
        const shiftColumns = Object.values(shiftColumnMap).sort((a, b) => {
            const p = shiftPriority(a.shiftCode) - shiftPriority(b.shiftCode);
            if (p !== 0) return p;
            return String(a.shiftCode).localeCompare(String(b.shiftCode));
        });

        // ✅ วันที่ที่มีข้อมูลจริงในช่วงที่เลือก เรียงจากน้อยไปมาก (ใช้ทำชีทแยกรายวัน)
        const dateSet = new Set();
        for (const t of trips.recordset) {
            let d = t.operationDate;
            if (d instanceof Date) {
                d = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            } else {
                d = String(d).slice(0, 10);
            }
            dateSet.add(d);
        }
        const dates = Array.from(dateSet).sort();

        return {
            startDate,
            endDate,
            dates,
            trips: trips.recordset,
            vehicleSummary: vehicleSummaryList,
            vehicles,
            shiftColumns,
            pivotRows: this.buildVehiclePivot(trips.recordset),
            grandTotal: vehicleSummaryList.reduce((s, v) => s + v.totalFare, 0)
        };
    }

    // ─── สร้างตารางรถ x รอบ แบบละเอียด (คอลัมน์ตามที่หน้างานใช้จริง) ───
    //    เข้าเช้า D / ออกกะ N: รายหัว (perHead) — นับ "คน" จาก employeeCount จริง
    //    17:00: เหมาคัน (flatByVehicle) — นับ "คนเลิกงาน" ที่ถูกจัดขึ้นรถ (ไม่ได้เอามาคิดค่าหัว)
    //    20:00: ตามจำนวนเที่ยว (perTrip) — นับ "เที่ยว" จาก tripSeq (ไม่ใช่จำนวนคน)
    //    รอบอื่นๆ ที่เป็น perHead (เช่น 16:00 เข้า/ออก) ที่ไม่มีคอลัมน์ตายตัว จะถูกรวมเข้า
    //    "รวมคน D+N" / "รวมราคา D+N" ด้วย (เพราะคิดค่าหัวเหมือนกัน) แต่ไม่มีคอลัมน์แยกให้ดู
    //    เว้นแต่จะมีรอบนั้นเกิดขึ้นจริงในช่วงวันที่เลือก ถึงจะเพิ่มคอลัมน์แยกให้อัตโนมัติ
    static buildVehiclePivot(tripRows) {
        const byVehicle = {};
        const extraPerHeadShifts = new Set(); // เก็บโค้ดรอบ perHead อื่นๆ ที่เจอ (นอกจาก D/N)

        for (const t of tripRows) {
            const vId = t.vehicleId;
            if (!byVehicle[vId]) {
                byVehicle[vId] = {
                    vehicleId: vId,
                    displayNumber: t.displayNumber,
                    plate: t.plate,
                    driver: t.driver,
                    inD: { riders: 0, fare: 0 },
                    outN: { riders: 0, fare: 0 },
                    flat17: { riders: 0, fare: 0 },
                    night20: { trips: 0, fare: 0 },
                    extraPerHead: {}, // { shiftCode: { shiftName, riders, fare } }
                    grandTotal: 0
                };
            }
            const row = byVehicle[vId];
            // ✅ ถ้าเที่ยวนี้ถูก "ปรับยอดเอง" (isManualOverride) ให้ใช้ totalRiders ที่แอดมิน
            //    กำหนดไว้ตรงๆ แทน employeeCount (นับจากรายชื่อที่สแกนได้จริง) เพราะรายชื่อ
            //    อาจไม่ครบ (เช่น พนักงานออกโดยไม่ได้แตะบัตร) แต่จำนวนที่ถูกต้องจริงถูกระบุไว้แล้ว
            const riders = t.isManualOverride ? (t.totalRiders || 0) : (t.employeeCount || 0);
            const fare = t.totalFare || 0;
            row.grandTotal += fare;

            if (t.shiftCode === 'D') {
                row.inD.riders += riders;
                row.inD.fare += fare;
            } else if (t.shiftCode === 'N') {
                row.outN.riders += riders;
                row.outN.fare += fare;
            } else if (t.shiftCode === 'EVENING_17') {
                row.flat17.riders += riders;
                row.flat17.fare += fare;
            } else if (t.shiftCode === 'NIGHT_20') {
                row.night20.trips += (t.tripSeq || 1);
                row.night20.fare += fare;
            } else if (t.shiftFareType === 'perHead') {
                if (!row.extraPerHead[t.shiftCode]) {
                    row.extraPerHead[t.shiftCode] = { shiftName: t.shiftName || t.shiftCode, riders: 0, fare: 0 };
                }
                row.extraPerHead[t.shiftCode].riders += riders;
                row.extraPerHead[t.shiftCode].fare += fare;
                extraPerHeadShifts.add(t.shiftCode);
            }
        }

        const rows = Object.values(byVehicle).map(row => {
            let perHeadRiders = row.inD.riders + row.outN.riders;
            let perHeadFare = row.inD.fare + row.outN.fare;
            for (const code of Object.keys(row.extraPerHead)) {
                perHeadRiders += row.extraPerHead[code].riders;
                perHeadFare += row.extraPerHead[code].fare;
            }
            // ✅ เปอร์เซ็นต่อหัว = ราคาเฉลี่ยต่อคน (รวมราคา D+N หาร รวมคน D+N) ไม่ใช่ % ของยอดรวมทั้งคัน
            const percentPerHead = perHeadRiders > 0 ? Math.round((perHeadFare / perHeadRiders) * 100) / 100 : 0;
            return { ...row, perHeadRiders, perHeadFare, percentPerHead };
        }).sort((a, b) =>
            String(a.displayNumber ?? a.vehicleId).localeCompare(String(b.displayNumber ?? b.vehicleId), 'th', { numeric: true })
        );

        return { rows, extraPerHeadShiftCodes: Array.from(extraPerHeadShifts) };
    }

    // ─── ดึงรายชื่อ "พนักงานรายคน" ที่ถูกจัดขึ้นรถแล้วในช่วงวันที่ที่เลือก
    //    (ไม่รวมคนขับ — isDriver = 0) พร้อมพยายามจับคู่เวลาสแกนจริง + ชื่อ-นามสกุล
    //    จาก PayrollScanRows กลับมาให้ (เพราะ PayrollTripEmployees เก็บแค่
    //    nameSnapshot รวมกัน ไม่มีคอลัมน์เวลาสแกน) เพื่อให้หน้าตาชีทออกมาใกล้เคียง
    //    ไฟล์สแกนดิบที่สุด ───
    static async getReportEmployeeDetails(startDate, endDate) {
        const rowsResult = await executeQuery(`
            SELECT
                te.id AS tripEmployeeId,
                te.cardId,
                te.nameSnapshot,
                te.department,
                te.fare,
                te.fareSource,
                vt.operationDate,
                st.shiftCode,
                st.shiftName,
                st.startTime,
                st.endTime,
                v.displayNumber,
                v.plate,
                de.name AS confirmedDriverName,
                v.driver AS defaultDriverName
            FROM PayrollTripEmployees te
            INNER JOIN PayrollVehicleTrips vt ON te.vehicleTripId = vt.id
            INNER JOIN PayrollShiftTypes st ON vt.shiftTypeId = st.id
            INNER JOIN Vehicles v ON vt.vehicleId = v.id
            LEFT JOIN Employees de ON vt.driverCardId COLLATE DATABASE_DEFAULT = de.cardId COLLATE DATABASE_DEFAULT
            WHERE vt.operationDate BETWEEN @startDate AND @endDate
              AND vt.status != 'deleted'
              AND te.isDriver = 0
            ORDER BY vt.operationDate, st.displayOrder, v.displayNumber, te.id
        `, { startDate, endDate });

        // ✅ ดึงสแกนหน้าของ "พนักงาน" (ไม่เอาไฟล์คนขับ) ทั้งช่วงวันที่ในคำขอเดียว
        //    เอาไว้จับคู่เวลา + ชื่อ-นามสกุลตัวจริงจากไฟล์สแกน (ไม่ใช่ nameSnapshot)
        const scansResult = await executeQuery(`
            SELECT cardId, scanDate, scanTime, firstName, lastName
            FROM PayrollScanRows
            WHERE scanDate BETWEEN @startDate AND @endDate
              AND personType = 'employee'
        `, { startDate, endDate });

        // key: "cardId|YYYY-MM-DD" -> [{ scanTime, firstName, lastName }, ...] เรียงเวลา
        const scansByKey = {};
        for (const s of scansResult.recordset) {
            let d = s.scanDate;
            if (d instanceof Date) {
                d = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            } else {
                d = String(d).slice(0, 10);
            }
            const key = `${(s.cardId || '').trim()}|${d}`;
            if (!scansByKey[key]) scansByKey[key] = [];
            scansByKey[key].push({
                scanTime: this.toHHMM(s.scanTime),
                firstName: s.firstName || '',
                lastName: s.lastName || ''
            });
        }
        for (const key in scansByKey) {
            scansByKey[key].sort((a, b) => (a.scanTime || '').localeCompare(b.scanTime || ''));
        }

        const details = [];
        for (const row of rowsResult.recordset) {
            let d = row.operationDate;
            if (d instanceof Date) {
                d = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            } else {
                d = String(d).slice(0, 10);
            }
            const key = `${(row.cardId || '').trim()}|${d}`;
            const scans = scansByKey[key] || [];

            // ✅ หาสแกนที่ตรงกับรอบนี้จริงๆ:
            //    - รอบ 20:00 ที่ถูกจัดผ่าน "จัดคนลงรถอัตโนมัติ" จะมี fareSource
            //      เป็น night_in/night_out อยู่แล้ว ใช้แยกก่อน/หลัง 20:00 ได้ตรงๆ
            //    - รอบอื่นๆ ใช้ช่วงเวลาของรอบ (shift.startTime-endTime) หาสแกนที่
            //      ตกอยู่ในช่วงนั้น (isInTimeRange เหมือนที่จุดอื่นในระบบใช้)
            //    - ถ้าหาไม่เจอเลย fallback เอาสแกนแรกของวันนั้นไปก่อน (ยังดีกว่าว่าง)
            let matched = null;
            if (row.fareSource === 'night_in') {
                matched = scans.find(s => s.scanTime && s.scanTime < '20:00');
            } else if (row.fareSource === 'night_out') {
                matched = scans.find(s => s.scanTime && s.scanTime >= '20:00');
            } else {
                matched = scans.find(s => this.isInTimeRange(s.scanTime, row.startTime, row.endTime));
            }
            if (!matched) matched = scans[0] || null;

            // เผื่อไม่เจอสแกนเลย (เช่น ถูกเพิ่มมือผ่าน addEmployeeToTrip โดยไม่มีสแกน)
            // ใช้ nameSnapshot แยกคำแรก/ที่เหลือแทนชื่อ-นามสกุล
            const [snapFirst, ...snapRest] = (row.nameSnapshot || '').split(' ');

            details.push({
                operationDate: d,
                scanTime: matched?.scanTime || '',
                shiftCode: row.shiftCode,
                shiftName: row.shiftName,
                cardId: row.cardId,
                firstName: matched?.firstName || snapFirst || '',
                lastName: matched?.lastName || snapRest.join(' ') || '',
                department: row.department || '',
                displayNumber: row.displayNumber,
                plate: row.plate,
                driver: row.confirmedDriverName || row.defaultDriverName || '',
                fare: row.fare || 0,
                // เข้างาน/ออกงาน — มีความหมายเฉพาะรอบ 20:00 ที่ผ่านการจัดคนอัตโนมัติ
                note: row.fareSource === 'night_in' ? 'เข้างาน'
                    : row.fareSource === 'night_out' ? 'ออกงาน'
                    : ''
            });
        }

        return details;
    }

    // ─── แปลงผลลัพธ์จาก buildVehiclePivot ให้เป็น sheet เดียว (aoa) ───
    //    title/subtitle: ข้อความหัวชีท, ใส่คอลัมน์รอบ perHead พิเศษ (เช่น 16:00) ต่อท้าย
    //    เข้า D / ออก N อัตโนมัติ ถ้ามีข้อมูลจริงในชุดนี้
    // ─── แปลงผลลัพธ์จาก buildVehiclePivot ให้เป็นชีทสี (ExcelJS) ───
    //    หน้าตาให้ตรงกับตาราง Reports บนหน้าเว็บ: หัวตาราง 2 แถว, กลุ่มสีตามรอบ
    //    (D=ฟ้า, N=เขียว, extra=เหลือง, 17:00=ส้ม, 20:00=ชมพู, สรุปค่าหัว=ม่วง),
    //    แถวลายสลับ, แถวรวมตัวหนา, freeze หัวตาราง+3 คอลัมน์แรก
    static addPivotSheet(workbook, pivot, sheetNameRaw, title, subtitleLines = []) {
        const extraCodes = pivot.extraPerHeadShiftCodes || [];
        const extraNames = {};
        for (const row of pivot.rows) {
            for (const code of extraCodes) {
                if (row.extraPerHead[code]) extraNames[code] = row.extraPerHead[code].shiftName;
            }
        }

        const sheetName = xlsxUniqueSheetName(workbook, sheetNameRaw);
        const headRowsBeforeTable = 1 + subtitleLines.length + 1; // title + subtitle + แถวว่าง
        const ws = workbook.addWorksheet(sheetName, {
            views: [{ state: 'frozen', xSplit: 3, ySplit: headRowsBeforeTable + 2 }],
        });

        // ─── หัวเรื่อง + วันที่ ───
        ws.mergeCells(1, 1, 1, 3);
        ws.getCell(1, 1).value = title;
        ws.getCell(1, 1).font = { bold: true, size: 13, color: { argb: 'FF1E293B' } };
        let r = 2;
        for (const line of subtitleLines) {
            ws.getCell(r, 1).value = line;
            ws.getCell(r, 1).font = { size: 10, color: { argb: 'FF64748B' } };
            r++;
        }
        r++; // แถวว่างคั่น

        const headRow1 = r;
        const headRow2 = r + 1;
        const dataStart = r + 2;

        // ─── โครงคอลัมน์ (ต้องเรียงตามตารางบนหน้าเว็บ) ───
        const cols = [
            { label1: 'เบอร์รถ', id: true, width: 10 },
            { label1: 'ทะเบียน', id: true, width: 13 },
            { label1: 'คนขับ', id: true, width: 18 },
            { group: 'd', label1: '🌅 เข้าเช้า (D)', label2: 'คน', width: 9, kind: 'count' },
            { group: 'd', label2: 'รวม(บาท)', width: 13, kind: 'fare' },
            { group: 'n', label1: '🌆 ออกกะ (N)', label2: 'คน', width: 9, kind: 'count' },
            { group: 'n', label2: 'รวม(บาท)', width: 13, kind: 'fare' },
            ...extraCodes.flatMap(code => ([
                { group: 'extra', label1: extraNames[code] || code, label2: 'คน', width: 9, kind: 'count' },
                { group: 'extra', label2: 'รวม(บาท)', width: 13, kind: 'fare' },
            ])),
            { group: 'flat17', label1: '🕔 17:00', label2: 'คนเลิกงาน', width: 11, kind: 'count' },
            { group: 'flat17', label2: 'รวม(บาท)', width: 13, kind: 'fare' },
            { group: 'night20', label1: '🌙 20:00', label2: 'เที่ยว', width: 9, kind: 'count' },
            { group: 'night20', label2: 'รวม(บาท)', width: 13, kind: 'fare' },
            { total: true, label1: 'รวมทั้งหมด', width: 14, kind: 'grand' },
            { group: 'perhead', label1: '📐 สรุปค่าหัว', label2: 'รวมคน D+N', width: 11, kind: 'count' },
            { group: 'perhead', label2: 'รวมราคา D+N', width: 13, kind: 'fare' },
            { group: 'perhead', label2: '฿/หัว', width: 11, kind: 'perhead' },
        ];

        ws.columns = cols.map(c => ({ width: c.width }));

        // ─── วาดหัวตาราง 2 แถว (merge เหมือนหน้าเว็บ) ───
        let ci = 1;
        for (const c of cols) {
            if (c.id || c.total) {
                ws.mergeCells(headRow1, ci, headRow2, ci);
                const cell = ws.getCell(headRow1, ci);
                cell.value = c.label1;
                const palette = c.total ? XLSX_COLORS.total : XLSX_COLORS.id;
                cell.fill = xlsxFill(palette.header);
                cell.font = { bold: true, color: { argb: palette.text } };
                cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                ws.getCell(headRow2, ci).fill = xlsxFill(palette.header);
                ci++;
                continue;
            }
            const palette = XLSX_COLORS[c.group];
            if (c.label1 !== undefined) {
                ws.mergeCells(headRow1, ci, headRow1, ci + 1);
                const cell = ws.getCell(headRow1, ci);
                cell.value = c.label1;
                cell.fill = xlsxFill(palette.header);
                cell.font = { bold: true, color: { argb: palette.text } };
                cell.alignment = { vertical: 'middle', horizontal: 'center' };
                ws.getCell(headRow1, ci + 1).fill = xlsxFill(palette.header);
            }
            const subCell = ws.getCell(headRow2, ci);
            subCell.value = c.label2;
            subCell.fill = xlsxFill(palette.sub || palette.header);
            subCell.font = { bold: true, size: 10, color: { argb: palette.text } };
            subCell.alignment = { vertical: 'middle', horizontal: 'center' };
            ci++;
        }
        for (let col = 1; col <= cols.length; col++) {
            ws.getRow(headRow1).getCell(col).border = XLSX_BORDER_ALL;
            ws.getRow(headRow2).getCell(col).border = XLSX_BORDER_ALL;
        }
        ws.getRow(headRow1).height = 20;
        ws.getRow(headRow2).height = 18;

        // ─── แถวข้อมูล ───
        let rIdx = dataStart;
        for (const row of pivot.rows) {
            const values = [
                row.displayNumber, row.plate, row.driver,
                row.inD.riders || null, row.inD.fare,
                row.outN.riders || null, row.outN.fare,
                ...extraCodes.flatMap(code => [
                    row.extraPerHead[code]?.riders || null,
                    row.extraPerHead[code]?.fare || 0,
                ]),
                row.flat17.riders || null, row.flat17.fare,
                row.night20.trips || null, row.night20.fare,
                row.grandTotal,
                row.perHeadRiders, row.perHeadFare, row.percentPerHead,
            ];
            const excelRow = ws.getRow(rIdx);
            excelRow.values = values;
            const isEven = (rIdx - dataStart) % 2 === 1;
            for (let col = 1; col <= cols.length; col++) {
                const c = cols[col - 1];
                const cell = excelRow.getCell(col);
                cell.border = XLSX_BORDER_ALL;
                cell.alignment = { vertical: 'middle', horizontal: col <= 3 ? 'left' : 'center' };
                if (isEven) cell.fill = xlsxFill('FFFAFBFC');
                if (c.kind === 'fare') { cell.numFmt = '#,##0" บ."'; cell.font = { color: { argb: 'FF0F766E' } }; }
                if (c.kind === 'count') cell.numFmt = '#,##0';
                if (c.kind === 'grand') { cell.numFmt = '#,##0" บ."'; cell.font = { bold: true, color: { argb: 'FF1D4ED8' } }; }
                if (c.kind === 'perhead') { cell.font = { bold: true, color: { argb: 'FF4338CA' } }; }
            }
            rIdx++;
        }

        // ─── แถวรวมท้ายตาราง ───
        const sum = (fn) => pivot.rows.reduce((s, rr) => s + fn(rr), 0);
        const totalPerHeadRiders = sum(rr => rr.perHeadRiders);
        const totalPerHeadFare = sum(rr => rr.perHeadFare);
        const totalPercent = totalPerHeadRiders > 0 ? Math.round((totalPerHeadFare / totalPerHeadRiders) * 100) / 100 : 0;
        const footerValues = [
            'รวมทั้งหมด', '', '',
            sum(rr => rr.inD.riders), sum(rr => rr.inD.fare),
            sum(rr => rr.outN.riders), sum(rr => rr.outN.fare),
            ...extraCodes.flatMap(code => [
                sum(rr => rr.extraPerHead[code]?.riders || 0),
                sum(rr => rr.extraPerHead[code]?.fare || 0),
            ]),
            sum(rr => rr.flat17.riders), sum(rr => rr.flat17.fare),
            sum(rr => rr.night20.trips), sum(rr => rr.night20.fare),
            sum(rr => rr.grandTotal),
            totalPerHeadRiders, totalPerHeadFare, totalPercent,
        ];
        const footerRow = ws.getRow(rIdx);
        footerRow.values = footerValues;
        ws.mergeCells(rIdx, 1, rIdx, 3);
        for (let col = 1; col <= cols.length; col++) {
            const c = cols[col - 1];
            const cell = footerRow.getCell(col);
            cell.border = { top: { style: 'medium', color: { argb: 'FF94A3B8' } }, left: XLSX_THIN_BORDER, bottom: XLSX_THIN_BORDER, right: XLSX_THIN_BORDER };
            cell.fill = xlsxFill('FFF1F5F9');
            cell.font = { bold: true, color: { argb: 'FF1E293B' } };
            cell.alignment = { vertical: 'middle', horizontal: col <= 3 ? 'left' : 'center' };
            if (c && c.kind === 'fare') cell.numFmt = '#,##0" บ."';
            if (c && c.kind === 'grand') cell.numFmt = '#,##0" บ."';
            if (c && c.kind === 'count') cell.numFmt = '#,##0';
        }

        return ws;
    }

    // ─── ชีทแบบตารางเรียบง่าย (หัวตัวหนา + สีพื้น + เส้นขอบ + แถวลายสลับ) ───
    //    ใช้กับชีท "สรุปค่ารถ(เดิม)" และ "รายละเอียด" ที่ไม่ได้มีกลุ่มคอลัมน์สีซับซ้อนแบบ pivot
    static addSimpleSheet(workbook, sheetNameRaw, { title, subtitleLines = [], columns, rows, totalRow = null }) {
        const sheetName = xlsxUniqueSheetName(workbook, sheetNameRaw);
        const ws = workbook.addWorksheet(sheetName);

        ws.mergeCells(1, 1, 1, columns.length);
        ws.getCell(1, 1).value = title;
        ws.getCell(1, 1).font = { bold: true, size: 13, color: { argb: 'FF1E293B' } };
        let r = 2;
        for (const line of subtitleLines) {
            ws.getCell(r, 1).value = line;
            ws.getCell(r, 1).font = { size: 10, color: { argb: 'FF64748B' } };
            r++;
        }
        r++;

        const headerRow = r;
        const dataStart = r + 1;

        ws.columns = columns.map(c => ({ width: c.width || 14 }));
        columns.forEach((c, i) => {
            const cell = ws.getCell(headerRow, i + 1);
            cell.value = c.label;
            cell.fill = xlsxFill('FFF1F5F9');
            cell.font = { bold: true, color: { argb: 'FF334155' } };
            cell.alignment = { vertical: 'middle', horizontal: 'center' };
            cell.border = XLSX_BORDER_ALL;
        });
        ws.getRow(headerRow).height = 20;
        ws.views = [{ state: 'frozen', ySplit: headerRow }];

        let rIdx = dataStart;
        for (const rowValues of rows) {
            const excelRow = ws.getRow(rIdx);
            excelRow.values = rowValues;
            const isEven = (rIdx - dataStart) % 2 === 1;
            columns.forEach((c, i) => {
                const cell = excelRow.getCell(i + 1);
                cell.border = XLSX_BORDER_ALL;
                cell.alignment = { vertical: 'middle', horizontal: c.align || 'center' };
                if (isEven) cell.fill = xlsxFill('FFFAFBFC');
                if (c.currency) { cell.numFmt = '#,##0" บ."'; cell.font = { color: { argb: 'FF0F766E' } }; }
            });
            rIdx++;
        }

        if (totalRow) {
            const excelRow = ws.getRow(rIdx);
            excelRow.values = totalRow;
            columns.forEach((c, i) => {
                const cell = excelRow.getCell(i + 1);
                cell.border = { top: { style: 'medium', color: { argb: 'FF94A3B8' } }, left: XLSX_THIN_BORDER, bottom: XLSX_THIN_BORDER, right: XLSX_THIN_BORDER };
                cell.fill = xlsxFill('FFF1F5F9');
                cell.font = { bold: true, color: { argb: 'FF1E293B' } };
                cell.alignment = { vertical: 'middle', horizontal: c.align || 'center' };
                if (c.currency) cell.numFmt = '#,##0" บ."';
            });
        }

        return ws;
    }

    static async exportExcel(startDate, endDate) {
        const report = await this.getReport(startDate, endDate);
        const employeeDetails = await this.getReportEmployeeDetails(startDate, endDate);

        const wb = new ExcelJS.Workbook();
        wb.creator = 'GA Dashboard';
        wb.created = new Date();

        // ─── ชีท(s) ตารางหลัก: รถ x รอบ แบบละเอียด (สีตามหน้าเว็บ) ───
        //    ถ้าเลือกมากกว่า 1 วัน: ชีทแรก = สรุปรวมทั้งช่วง แล้วตามด้วยชีทแยกรายวัน (1 วัน/ชีท)
        //    ถ้าเลือกวันเดียว: มีชีทเดียวพอ (สรุป = วันนั้นอยู่แล้ว ไม่ต้องซ้ำ)
        const dates = report.dates || [];
        if (dates.length > 1) {
            const summaryPivot = this.buildVehiclePivot(report.trips);
            this.addPivotSheet(
                wb, summaryPivot, 'สรุปทั้งหมด',
                '🚐 สรุปรวมค่ารถ (ทุกวันที่เลือก)',
                [`ช่วงวันที่: ${startDate} ถึง ${endDate}`]
            );

            for (const d of dates) {
                const dayTrips = report.trips.filter(t => {
                    let td = t.operationDate;
                    if (td instanceof Date) td = `${td.getFullYear()}-${String(td.getMonth() + 1).padStart(2, '0')}-${String(td.getDate()).padStart(2, '0')}`;
                    else td = String(td).slice(0, 10);
                    return td === d;
                });
                const dayPivot = this.buildVehiclePivot(dayTrips);
                this.addPivotSheet(wb, dayPivot, d, `🚐 ค่ารถวันที่ ${d}`, [`วันที่: ${d}`]);
            }
        } else {
            const pivot = this.buildVehiclePivot(report.trips);
            const label = dates[0] || `${startDate} - ${endDate}`;
            this.addPivotSheet(wb, pivot, 'รายงาน', `🚐 ค่ารถวันที่ ${label}`, [`วันที่: ${label}`]);
        }

        // ─── ชีท: สรุปค่ารถ (รายแถวต่อ รถ+รอบ) ───
        this.addSimpleSheet(wb, 'สรุปค่ารถ(เดิม)', {
            title: '🚐 สรุปค่ารถ',
            subtitleLines: [`ช่วงวันที่: ${startDate} - ${endDate}`],
            columns: [
                { label: 'เบอร์รถ', width: 10 },
                { label: 'รอบ', width: 14 },
                { label: 'ทะเบียน', width: 13 },
                { label: 'คนขับ', width: 18, align: 'left' },
                { label: 'เที่ยว', width: 9 },
                { label: 'พนักงาน', width: 10 },
                { label: 'ค่ารถ', width: 14, currency: true },
            ],
            rows: report.vehicleSummary.map(v => [
                v.displayNumber, v.shiftName || v.shiftCode, v.plate, v.driver, v.totalTrips, v.totalRiders, v.totalFare
            ]),
            totalRow: ['รวม', '', '', '', '', '', report.grandTotal],
        });

        // ─── ชีท: รายละเอียดพนักงานรายคน ───
        this.addSimpleSheet(wb, 'รายละเอียด', {
            title: '📋 รายละเอียดพนักงานรายคน',
            subtitleLines: [`ช่วงวันที่: ${startDate} - ${endDate}`],
            columns: [
                { label: 'วันที่', width: 12 },
                { label: 'เวลาสแกน', width: 10 },
                { label: 'รอบ', width: 14 },
                { label: 'รหัสบัตร', width: 12 },
                { label: 'ชื่อ', width: 14, align: 'left' },
                { label: 'นามสกุล', width: 16, align: 'left' },
                { label: 'แผนก', width: 14, align: 'left' },
                { label: 'เบอร์รถ', width: 10 },
                { label: 'ทะเบียน', width: 13 },
                { label: 'คนขับ', width: 18, align: 'left' },
                { label: 'ค่ารถ', width: 12, currency: true },
                { label: 'หมายเหตุ', width: 12 },
            ],
            rows: employeeDetails.map(d => [
                d.operationDate, d.scanTime, d.shiftName || d.shiftCode, d.cardId,
                d.firstName, d.lastName, d.department, d.displayNumber, d.plate, d.driver, d.fare, d.note
            ]),
        });

        return await wb.xlsx.writeBuffer();
    }

    // ─── สร้างชีท "รายชื่อพนักงานที่นั่งรถแต่ละคัน" สไตล์ Pivot Table ───
    //    (ตามหน้าตาไฟล์ตัวอย่างที่โรงงานใช้อยู่: รถ(เบอร์+คนขับ) -> รอบ (D/N/...) -> รายชื่อพนักงานทีละคน
    //    แต่ละแถวกลุ่ม (รถ / รอบ) โชว์ยอดรวม "จำนวนคน" + "ค่ารถ" กำกับไว้เหมือนต้นฉบับ)
    static addEmployeeListByVehicleSheet(workbook, employeeDetails, sheetNameRaw, title, subtitleLines = []) {
        const shiftPriority = (code) => (code === 'D' ? 0 : code === 'N' ? 1 : 2);

        // จัดกลุ่ม: เบอร์รถ+คนขับ -> รอบ -> [พนักงาน]
        const vehicleMap = new Map();
        for (const d of employeeDetails) {
            const vKey = `${d.displayNumber ?? ''}||${d.driver ?? ''}`;
            if (!vehicleMap.has(vKey)) {
                vehicleMap.set(vKey, {
                    displayNumber: d.displayNumber,
                    driver: d.driver,
                    plate: d.plate,
                    totalRiders: 0,
                    totalFare: 0,
                    shifts: new Map(),
                });
            }
            const v = vehicleMap.get(vKey);
            v.totalRiders += 1;
            v.totalFare += d.fare || 0;

            const sKey = d.shiftCode || d.shiftName || '-';
            if (!v.shifts.has(sKey)) {
                v.shifts.set(sKey, {
                    shiftCode: d.shiftCode,
                    shiftName: d.shiftName || d.shiftCode || '-',
                    riders: 0,
                    fare: 0,
                    employees: [],
                });
            }
            const s = v.shifts.get(sKey);
            s.riders += 1;
            s.fare += d.fare || 0;
            s.employees.push(d);
        }

        // เรียงรถตามเบอร์รถ (เหมือนตารางอื่นๆ ในระบบ)
        const vehicles = Array.from(vehicleMap.values()).sort((a, b) =>
            String(a.displayNumber ?? '').localeCompare(String(b.displayNumber ?? ''), 'th', { numeric: true })
        );

        const sheetName = xlsxUniqueSheetName(workbook, sheetNameRaw);
        const ws = workbook.addWorksheet(sheetName);
        ws.columns = [{ width: 34 }, { width: 16 }, { width: 20 }];

        ws.mergeCells(1, 1, 1, 3);
        ws.getCell(1, 1).value = title;
        ws.getCell(1, 1).font = { bold: true, size: 13, color: { argb: 'FF1E293B' } };
        let r = 2;
        for (const line of subtitleLines) {
            ws.getCell(r, 1).value = line;
            ws.getCell(r, 1).font = { size: 10, color: { argb: 'FF64748B' } };
            r++;
        }
        r++; // แถวว่างคั่น

        // หัวตาราง (หน้าตาแบบ Pivot Table เดิม: "Row Labels" / "Values" แล้วตามด้วยชื่อคอลัมน์จริง)
        ws.getCell(r, 1).value = 'Row Labels';
        ws.getCell(r, 1).font = { bold: true, color: { argb: 'FF334155' } };
        r++;
        ws.getCell(r, 1).value = null;
        ws.getCell(r, 2).value = 'Sum of Qty จำนวนคน';
        ws.getCell(r, 3).value = 'Sum of ค่ารถ (จำนวนเงิน)';
        [1, 2, 3].forEach(c => {
            const cell = ws.getCell(r, c);
            cell.font = { bold: true, color: { argb: 'FF334155' } };
            cell.fill = xlsxFill('FFF1F5F9');
            cell.alignment = { horizontal: c === 1 ? 'left' : 'center' };
            cell.border = XLSX_BORDER_ALL;
        });
        r++;
        ws.views = [{ state: 'frozen', ySplit: r - 1 }];

        let grandRiders = 0, grandFare = 0;
        for (const v of vehicles) {
            // ── แถวรถ (ระดับบนสุด) ──
            const vLabel = `${v.displayNumber ?? ''} ${v.driver ?? ''}`.trim() || '-';
            ws.getCell(r, 1).value = vLabel;
            ws.getCell(r, 2).value = v.totalRiders;
            ws.getCell(r, 3).value = v.totalFare;
            [1, 2, 3].forEach(c => {
                const cell = ws.getCell(r, c);
                cell.font = { bold: true, color: { argb: 'FF1E293B' } };
                cell.fill = xlsxFill('FFE2E8F0');
                cell.border = XLSX_BORDER_ALL;
                cell.alignment = { horizontal: c === 1 ? 'left' : 'center' };
            });
            ws.getCell(r, 3).numFmt = '#,##0" บ."';
            r++;
            grandRiders += v.totalRiders;
            grandFare += v.totalFare;

            // เรียงรอบ D ก่อน, N รองลงมา, ที่เหลือเรียงตามชื่อ
            const shifts = Array.from(v.shifts.values()).sort((a, b) => {
                const p = shiftPriority(a.shiftCode) - shiftPriority(b.shiftCode);
                if (p !== 0) return p;
                return String(a.shiftName).localeCompare(String(b.shiftName));
            });

            for (const s of shifts) {
                // ── แถวรอบ (ระดับกลาง) ──
                ws.getCell(r, 1).value = s.shiftName;
                ws.getCell(r, 2).value = s.riders;
                ws.getCell(r, 3).value = s.fare;
                [1, 2, 3].forEach(c => {
                    const cell = ws.getCell(r, c);
                    cell.font = { bold: true, color: { argb: 'FF334155' } };
                    cell.fill = xlsxFill('FFF8FAFC');
                    cell.border = XLSX_BORDER_ALL;
                    cell.alignment = { horizontal: c === 1 ? 'left' : 'center', indent: c === 1 ? 1 : 0 };
                });
                ws.getCell(r, 3).numFmt = '#,##0" บ."';
                r++;

                // เรียงชื่อพนักงาน ก-ฮ ให้หาง่าย เหมือนไฟล์ตัวอย่าง
                const emps = [...s.employees].sort((a, b) =>
                    `${a.firstName}${a.lastName}`.localeCompare(`${b.firstName}${b.lastName}`, 'th')
                );
                for (const e of emps) {
                    const name = `${e.firstName || ''} ${e.lastName || ''}`.trim() || e.cardId || '-';
                    ws.getCell(r, 1).value = name;
                    ws.getCell(r, 2).value = 1;
                    ws.getCell(r, 3).value = e.fare || 0;
                    [1, 2, 3].forEach(c => {
                        const cell = ws.getCell(r, c);
                        cell.border = XLSX_BORDER_ALL;
                        cell.alignment = { horizontal: c === 1 ? 'left' : 'center', indent: c === 1 ? 2 : 0 };
                    });
                    ws.getCell(r, 3).numFmt = '#,##0" บ."';
                    ws.getCell(r, 3).font = { color: { argb: 'FF0F766E' } };
                    r++;
                }
            }
        }

        // ── แถวรวมทั้งหมด ──
        if (vehicles.length > 0) {
            ws.getCell(r, 1).value = 'รวมทั้งหมด';
            ws.getCell(r, 2).value = grandRiders;
            ws.getCell(r, 3).value = grandFare;
            [1, 2, 3].forEach(c => {
                const cell = ws.getCell(r, c);
                cell.font = { bold: true, color: { argb: 'FF1D4ED8' } };
                cell.fill = xlsxFill('FFF1F5F9');
                cell.border = { top: { style: 'medium', color: { argb: 'FF94A3B8' } }, left: XLSX_THIN_BORDER, bottom: XLSX_THIN_BORDER, right: XLSX_THIN_BORDER };
                cell.alignment = { horizontal: c === 1 ? 'left' : 'center' };
            });
            ws.getCell(r, 3).numFmt = '#,##0" บ."';
        } else {
            ws.getCell(r, 1).value = 'ไม่มีข้อมูล';
            ws.getCell(r, 1).font = { color: { argb: 'FF94A3B8' } };
        }

        return ws;
    }

    // ✅ Export Excel: รายชื่อพนักงานที่นั่งรถแต่ละคัน (ปุ่มแยกต่างหากในหน้ารายงาน)
    //    รูปแบบตามไฟล์ Pivot Table ที่โรงงานใช้อยู่เดิม (รถ -> รอบ -> รายชื่อทีละคน)
    //    แยกชีทต่อวัน ถ้าเลือกช่วงมากกว่า 1 วัน (ชีทแรกเป็นสรุปรวม), ถ้าวันเดียวมีชีทเดียวพอ
    static async exportEmployeeListByVehicle(startDate, endDate) {
        const employeeDetails = await this.getReportEmployeeDetails(startDate, endDate);

        const wb = new ExcelJS.Workbook();
        wb.creator = 'GA Dashboard';
        wb.created = new Date();

        const dateSet = new Set(employeeDetails.map(d => d.operationDate));
        const dates = Array.from(dateSet).sort();

        if (dates.length > 1) {
            this.addEmployeeListByVehicleSheet(
                wb, employeeDetails, 'สรุปทั้งหมด',
                '👥 รายชื่อพนักงานที่นั่งรถแต่ละคัน (สรุปรวมทุกวันที่เลือก)',
                [`ช่วงวันที่: ${startDate} ถึง ${endDate}`]
            );
            for (const d of dates) {
                const dayDetails = employeeDetails.filter(x => x.operationDate === d);
                this.addEmployeeListByVehicleSheet(
                    wb, dayDetails, `ค่ารถวันที่ ${d}`,
                    `👥 รายชื่อพนักงานที่นั่งรถแต่ละคัน — วันที่ ${d}`,
                    [`วันที่: ${d}`]
                );
            }
        } else {
            const label = dates[0] || `${startDate} - ${endDate}`;
            this.addEmployeeListByVehicleSheet(
                wb, employeeDetails, `ค่ารถวันที่ ${label}`,
                `👥 รายชื่อพนักงานที่นั่งรถแต่ละคัน — วันที่ ${label}`,
                [`วันที่: ${label}`]
            );
        }

        return await wb.xlsx.writeBuffer();
    }

    // ✅ Export Excel: เช็คชื่อ มา/ไม่มา รายคัน (ให้คนขับถือเช็คกับตัวจริง)
    //    ชีทแรก = พนักงานที่มีข้อมูลสแกนในช่วงที่เลือก แต่ยังไม่ถูกจัดรถ/ราคา (PayrollUnassignedRiders)
    //    ชีทถัดไป = 1 ชีทต่อ 1 คัน ตาราง: ซ้ายสุด=ชื่อพนักงาน, บนสุด=วันที่ทุกวันในช่วง,
    //    ช่อง = ✓ ถ้าพนักงานคนนั้นอยู่ใน vehicleTripEmployees ของคันนี้วันนั้น ไม่งั้น ✗
    //    ท้ายแถว = สรุปมา/ขาดต่อคน, ท้ายตาราง = รวมคนมาต่อวัน
    static async exportAttendanceChecklistByVehicle(startDate, endDate) {
        const employeeDetails = await this.getReportEmployeeDetails(startDate, endDate);
        const dateRange = buildDateRange(startDate, endDate);

        const wb = new ExcelJS.Workbook();
        wb.creator = 'GA Dashboard';
        wb.created = new Date();

        // ── ชีทแรก: คนที่มีข้อมูล (สแกนเข้าระบบ) ในช่วงนี้ แต่ยังไม่มีรถ/ราคา ──
        const pendingResult = await executeQuery(`
            SELECT ur.operationDate, ur.cardId, ur.nameSnapshot, ur.reason,
                   e.name AS employeeName, e.department,
                   st.shiftName
            FROM PayrollUnassignedRiders ur
            LEFT JOIN Employees e ON ur.employeeId = e.id
            LEFT JOIN PayrollShiftTypes st ON ur.shiftTypeId = st.id
            WHERE ur.operationDate BETWEEN @startDate AND @endDate
              AND ur.status = 'pending'
            ORDER BY ur.operationDate, e.name
        `, { startDate, endDate });

        const reasonLabel = (reason) => ({
            no_driver_scan: 'ยังไม่มีคนขับสแกนเข้ารอบนี้',
            vehicle_full: 'รถเต็ม (เกินที่นั่ง)',
            no_vehicle: 'ไม่พบรถที่ตรงกับที่แจ้ง',
            no_vehicle_trip: 'ยังไม่มีเที่ยวรถของรอบนี้',
        }[reason] || reason || '-');

        this.addSimpleSheet(wb, 'ยังไม่มีรถ-ราคา', {
            title: '⏳ พนักงานที่มีข้อมูลในช่วงนี้ แต่ยังไม่มีรถ/ราคา',
            subtitleLines: [
                `ช่วงวันที่: ${startDate} ถึง ${endDate}`,
                'รายชื่อเหล่านี้สแกนเข้าระบบแล้ว แต่ยังไม่ถูกจัดลงรถ/คิดราคา — ไม่ได้อยู่ในตารางเช็คชื่อรายคันด้านหลัง',
            ],
            columns: [
                { label: 'วันที่', width: 12 },
                { label: 'ชื่อ-สกุล', width: 26, align: 'left' },
                { label: 'รหัสบัตร', width: 14 },
                { label: 'แผนก', width: 16 },
                { label: 'รอบ', width: 14 },
                { label: 'สาเหตุ', width: 28, align: 'left' },
            ],
            rows: pendingResult.recordset.map(p => {
                let d = p.operationDate;
                if (d instanceof Date) d = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
                else d = String(d).slice(0, 10);
                return [d, p.employeeName || p.nameSnapshot || '-', p.cardId || '-', p.department || '-', p.shiftName || '-', reasonLabel(p.reason)];
            }),
        });

        // ── จัดกลุ่มพนักงาน (ที่มีรถแล้ว) ตามเบอร์รถ -> รอบ (เข้าเช้า/ออกกะ/อื่นๆ) -> พนักงาน ──
        //    รวมมาจาก "รายชื่อพนักงานที่นั่งรถแต่ละคัน" เดิม (โชว์ราคา) + ตารางเช็คชื่อ (โชว์ ✓/✗ ต่อวัน)
        //    ให้เป็นชีทเดียวกัน แยกเป็นกลุ่มตามรอบ เพราะคนขึ้นรถรอบเช้ากับรอบเย็นอาจเป็นคนละกลุ่ม/ราคาคนละแบบ
        const vehicleMap = new Map();
        for (const d of employeeDetails) {
            const vKey = d.displayNumber ?? '-';
            if (!vehicleMap.has(vKey)) {
                vehicleMap.set(vKey, {
                    displayNumber: d.displayNumber,
                    plate: d.plate,
                    drivers: new Set(),
                    shifts: new Map(), // shiftKey -> { shiftCode, shiftName, employees: Map }
                });
            }
            const v = vehicleMap.get(vKey);
            if (d.driver) v.drivers.add(d.driver);

            const shiftKey = d.shiftCode || d.shiftName || '-';
            if (!v.shifts.has(shiftKey)) {
                v.shifts.set(shiftKey, {
                    shiftCode: d.shiftCode,
                    shiftName: d.shiftName || d.shiftCode || '-',
                    employees: new Map(), // empKey -> { name, cardId, datesPresent: Set, fareByDate: Map }
                });
            }
            const shiftGroup = v.shifts.get(shiftKey);

            const empKey = (d.cardId || `${d.firstName}${d.lastName}`).trim() || `${d.firstName}${d.lastName}`;
            if (!shiftGroup.employees.has(empKey)) {
                shiftGroup.employees.set(empKey, {
                    name: `${d.firstName || ''} ${d.lastName || ''}`.trim() || d.cardId || '-',
                    cardId: d.cardId || '-',
                    datesPresent: new Set(),
                    fareByDate: new Map(),
                    scanTimeByDate: new Map(), // ✅ เพิ่ม: เวลาที่สแกนหน้าของวันนั้นๆ (ใช้แสดงในตารางเช็คชื่อแทน ✓)
                });
            }
            const emp = shiftGroup.employees.get(empKey);
            emp.datesPresent.add(d.operationDate);
            emp.fareByDate.set(d.operationDate, d.fare || 0);
            emp.scanTimeByDate.set(d.operationDate, d.scanTime || '');
        }

        const vehicles = Array.from(vehicleMap.values()).sort((a, b) =>
            String(a.displayNumber ?? '').localeCompare(String(b.displayNumber ?? ''), 'th', { numeric: true })
        );

        for (const v of vehicles) {
            this.addAttendanceChecklistSheet(wb, v, dateRange, startDate, endDate);
        }

        return await wb.xlsx.writeBuffer();
    }

    // ─── ชีทเช็คชื่อ+ราคา ของรถ 1 คัน — จัดกลุ่มตามรอบ (เข้าเช้า D / ออกกะ N / อื่นๆ) ───
    //    ซ้ายสุด = ชื่อพนักงาน, บนสุด = วันที่ทุกวันในช่วง, ช่อง = ✓/✗
    //    ท้ายแถว = มา/ขาด(วัน) + รวมค่ารถ(บาท) ของคนนั้น, แถวหัวรอบ = สรุปคน/ราคารวมของรอบนั้น
    static addAttendanceChecklistSheet(workbook, vehicleData, dateRange, startDate, endDate) {
        const { displayNumber, plate, drivers, shifts } = vehicleData;
        const sheetName = xlsxUniqueSheetName(workbook, `เบอร์ ${displayNumber ?? '-'}`);
        const ws = workbook.addWorksheet(sheetName);

        const presentCol = 3 + dateRange.length;
        const absentCol = presentCol + 1;
        const fareCol = absentCol + 1;
        const totalCols = fareCol;

        ws.columns = [
            { width: 26 },
            { width: 12 },
            ...dateRange.map(() => ({ width: 5 })),
            { width: 9 },
            { width: 9 },
            { width: 14 },
        ];

        ws.mergeCells(1, 1, 1, totalCols);
        ws.getCell(1, 1).value = `🚐 เช็คชื่อ + ราคารถ รายวัน — เบอร์ ${displayNumber ?? '-'}${plate ? ' (' + plate + ')' : ''}`;
        ws.getCell(1, 1).font = { bold: true, size: 13, color: { argb: 'FF1E293B' } };

        ws.mergeCells(2, 1, 2, totalCols);
        ws.getCell(2, 1).value = `คนขับ: ${Array.from(drivers).join(', ') || '-'}  •  ช่วงวันที่: ${startDate} ถึง ${endDate}  •  ช่องวันที่ = เวลาสแกนหน้า (ว่าง/✗ = ไม่มีข้อมูลว่ามา) • แถว "ราคา(บาท)" ใต้แต่ละรอบ = ราคารวมของรอบนั้นในวันนั้น`;
        ws.getCell(2, 1).font = { size: 10, color: { argb: 'FF64748B' } };

        const headerRow = 4;
        ws.getCell(headerRow, 1).value = 'ชื่อ-สกุล';
        ws.getCell(headerRow, 2).value = 'รหัสบัตร';
        dateRange.forEach((d, i) => { ws.getCell(headerRow, 3 + i).value = d.slice(8, 10); });
        ws.getCell(headerRow, presentCol).value = 'มา(วัน)';
        ws.getCell(headerRow, absentCol).value = 'ขาด(วัน)';
        ws.getCell(headerRow, fareCol).value = 'รวมค่ารถ(บาท)';
        for (let c = 1; c <= totalCols; c++) {
            const cell = ws.getCell(headerRow, c);
            cell.font = { bold: true, color: { argb: 'FF334155' } };
            cell.fill = xlsxFill('FFF1F5F9');
            cell.alignment = { horizontal: c === 1 ? 'left' : 'center', vertical: 'middle' };
            cell.border = XLSX_BORDER_ALL;
        }
        ws.getRow(headerRow).height = 20;
        ws.views = [{ state: 'frozen', xSplit: 2, ySplit: headerRow }];

        // เรียงรอบ: D (เข้าเช้า) ก่อน, N (ออกกะ) รองลงมา, ที่เหลือเรียงตามชื่อ
        const shiftPriority = (code) => (code === 'D' ? 0 : code === 'N' ? 1 : 2);
        const shiftGroups = Array.from(shifts.values()).sort((a, b) => {
            const p = shiftPriority(a.shiftCode) - shiftPriority(b.shiftCode);
            if (p !== 0) return p;
            return String(a.shiftName).localeCompare(String(b.shiftName));
        });

        let r = headerRow + 1;
        const vehicleDayTotals = new Array(dateRange.length).fill(0);
        const vehicleDayFareTotals = new Array(dateRange.length).fill(0);
        let grandRiderRows = 0, grandFare = 0;

        for (const shiftGroup of shiftGroups) {
            const empList = Array.from(shiftGroup.employees.values()).sort((a, b) => a.name.localeCompare(b.name, 'th'));
            const shiftDayTotals = new Array(dateRange.length).fill(0);
            const shiftDayFareTotals = new Array(dateRange.length).fill(0); // ✅ ราคารวมของรอบนี้ แยกต่อวัน
            let shiftFare = 0;
            for (const emp of empList) {
                dateRange.forEach((d, i) => {
                    if (emp.datesPresent.has(d)) {
                        shiftDayTotals[i]++;
                        const fareOnDate = emp.fareByDate.get(d) || 0;
                        shiftDayFareTotals[i] += fareOnDate;
                    }
                });
                for (const f of emp.fareByDate.values()) shiftFare += f;
            }

            // ── แถวหัวรอบ (เช้า/ออกกะ/อื่นๆ) — จำนวนคนต่อวัน + สรุปรวมทั้งช่วง ──
            const shiftColor = shiftGroup.shiftCode === 'D' ? 'FFEFF6FF' : shiftGroup.shiftCode === 'N' ? 'FFF0FDF4' : 'FFFEFCE8';
            ws.getCell(r, 1).value = `${shiftGroup.shiftName} (คน)`;
            dateRange.forEach((d, i) => { ws.getCell(r, 3 + i).value = shiftDayTotals[i] || ''; });
            ws.getCell(r, presentCol).value = empList.length;
            ws.getCell(r, fareCol).value = shiftFare;
            for (let c = 1; c <= totalCols; c++) {
                const cell = ws.getCell(r, c);
                cell.font = { bold: true, color: { argb: 'FF1E293B' } };
                cell.fill = xlsxFill(shiftColor);
                cell.border = XLSX_BORDER_ALL;
                cell.alignment = { horizontal: c === 1 ? 'left' : 'center', vertical: 'middle' };
            }
            ws.getCell(r, fareCol).numFmt = '#,##0" บ."';
            r++;

            // ── แถว "ราคา(บาท)" ของรอบนี้ แยกต่อวัน — เช่น วันที่ 16 เช้า 300 บ. ──
            //    (รอบ 20:00/perTrip ไม่มีราคาต่อคนโดยตรง แต่ยังโชว์ยอดรวมของรอบ/วันนั้นได้ตามปกติ)
            ws.getCell(r, 1).value = `${shiftGroup.shiftName} (ราคา บ.)`;
            dateRange.forEach((d, i) => {
                const cell = ws.getCell(r, 3 + i);
                if (shiftDayTotals[i] > 0) {
                    cell.value = shiftDayFareTotals[i];
                    cell.numFmt = '#,##0';
                }
            });
            ws.getCell(r, presentCol).value = '';
            ws.getCell(r, fareCol).value = shiftFare;
            for (let c = 1; c <= totalCols; c++) {
                const cell = ws.getCell(r, c);
                cell.font = { italic: true, color: { argb: 'FF0F766E' } };
                cell.fill = xlsxFill(shiftColor);
                cell.border = XLSX_BORDER_ALL;
                cell.alignment = { horizontal: c === 1 ? 'left' : 'center', vertical: 'middle' };
            }
            ws.getCell(r, fareCol).numFmt = '#,##0" บ."';
            r++;

            for (const emp of empList) {
                let presentCount = 0;
                let empFare = 0;
                ws.getCell(r, 1).value = emp.name;
                ws.getCell(r, 1).alignment = { horizontal: 'left', vertical: 'middle', indent: 1 };
                ws.getCell(r, 2).value = emp.cardId;
                dateRange.forEach((d, i) => {
                    const present = emp.datesPresent.has(d);
                    const cell = ws.getCell(r, 3 + i);
                    // ✅ ดึงเวลาที่สแกนหน้ามาแสดงแทน ✓ เฉยๆ — ถ้ามาแต่ไม่มีเวลาสแกน (เช่น เพิ่มมือ) ให้โชว์ ✓ แทน
                    const scanTime = emp.scanTimeByDate ? emp.scanTimeByDate.get(d) : '';
                    cell.value = present ? (scanTime || '✓') : '✗';
                    cell.font = { bold: true, color: { argb: present ? 'FF15803D' : 'FFB91C1C' } };
                    cell.fill = xlsxFill(present ? 'FFDCFCE7' : 'FFFEE2E2');
                    cell.alignment = { horizontal: 'center', vertical: 'middle' };
                    cell.border = XLSX_BORDER_ALL;
                    if (present) {
                        presentCount++;
                        const fareOnDate = emp.fareByDate.get(d) || 0;
                        empFare += fareOnDate;
                        vehicleDayTotals[i]++;
                        vehicleDayFareTotals[i] += fareOnDate;
                    }
                });
                ws.getCell(r, presentCol).value = presentCount;
                ws.getCell(r, absentCol).value = dateRange.length - presentCount;
                ws.getCell(r, fareCol).value = empFare;
                [1, 2, presentCol, absentCol, fareCol].forEach(c => {
                    const cell = ws.getCell(r, c);
                    cell.border = XLSX_BORDER_ALL;
                    if (c !== 1) cell.alignment = { horizontal: 'center', vertical: 'middle' };
                });
                ws.getCell(r, presentCol).font = { bold: true, color: { argb: 'FF15803D' } };
                ws.getCell(r, absentCol).font = { bold: true, color: { argb: 'FFB91C1C' } };
                ws.getCell(r, fareCol).font = { color: { argb: 'FF0F766E' } };
                ws.getCell(r, fareCol).numFmt = '#,##0" บ."';
                r++;

                grandRiderRows++;
                grandFare += empFare;
            }
        }

        // ── แถวรวมท้ายตาราง: จำนวนคนมาต่อวัน (รวมทุกรอบ) ──
        if (grandRiderRows > 0) {
            ws.getCell(r, 1).value = 'รวมคนมาทั้งคัน (คน/วัน)';
            dateRange.forEach((d, i) => { ws.getCell(r, 3 + i).value = vehicleDayTotals[i]; });
            ws.getCell(r, presentCol).value = '';
            ws.getCell(r, absentCol).value = '';
            ws.getCell(r, fareCol).value = grandFare;
            for (let c = 1; c <= totalCols; c++) {
                const cell = ws.getCell(r, c);
                cell.font = { bold: true, color: { argb: 'FF1D4ED8' } };
                cell.fill = xlsxFill('FFF1F5F9');
                cell.border = { top: { style: 'medium', color: { argb: 'FF94A3B8' } }, left: XLSX_THIN_BORDER, bottom: XLSX_THIN_BORDER, right: XLSX_THIN_BORDER };
                cell.alignment = { horizontal: c === 1 ? 'left' : 'center', vertical: 'middle' };
            }
            ws.getCell(r, fareCol).numFmt = '#,##0" บ."';
            r++;

            // ── แถวรวมราคาทั้งคันต่อวัน (ทุกรอบรวมกัน) ──
            ws.getCell(r, 1).value = 'รวมค่ารถทั้งคัน (บาท/วัน)';
            dateRange.forEach((d, i) => {
                const cell = ws.getCell(r, 3 + i);
                if (vehicleDayFareTotals[i] > 0) {
                    cell.value = vehicleDayFareTotals[i];
                    cell.numFmt = '#,##0';
                }
            });
            ws.getCell(r, presentCol).value = '';
            ws.getCell(r, absentCol).value = '';
            ws.getCell(r, fareCol).value = grandFare;
            for (let c = 1; c <= totalCols; c++) {
                const cell = ws.getCell(r, c);
                cell.font = { bold: true, italic: true, color: { argb: 'FF1D4ED8' } };
                cell.fill = xlsxFill('FFF1F5F9');
                cell.border = { left: XLSX_THIN_BORDER, bottom: { style: 'medium', color: { argb: 'FF94A3B8' } }, right: XLSX_THIN_BORDER };
                cell.alignment = { horizontal: c === 1 ? 'left' : 'center', vertical: 'middle' };
            }
            ws.getCell(r, fareCol).numFmt = '#,##0" บ."';
        } else {
            ws.getCell(r, 1).value = 'ไม่มีข้อมูล';
            ws.getCell(r, 1).font = { color: { argb: 'FF94A3B8' } };
        }

        return ws;
    }

    // ✅ Export Excel: "รายชื่อพนักงานที่นั่งรถแต่ละคัน" — เอากลับมาตามที่ขอ
    //    ต่างจาก exportAttendanceChecklistByVehicle (ตาราง ✓/✗ ไล่ตามวันที่) ตรงที่รายงานนี้
    //    เป็นรายการดิบ 1 แถวต่อ 1 คน/1 วัน/1 รอบ (เหมือนชีท "รายละเอียด" ใน exportExcel) แต่แยก
    //    เป็น 1 ชีทต่อ 1 คัน อ่านง่ายเวลาจะดูว่าคันไหนมีใครนั่งบ้างในแต่ละวัน พร้อมเวลาสแกนหน้า + ราคา
    static async exportRidersByVehicle(startDate, endDate) {
        const employeeDetails = await this.getReportEmployeeDetails(startDate, endDate);

        const wb = new ExcelJS.Workbook();
        wb.creator = 'GA Dashboard';
        wb.created = new Date();

        // ── จัดกลุ่มตามเบอร์รถ ──
        const vehicleMap = new Map();
        for (const d of employeeDetails) {
            const vKey = d.displayNumber ?? '-';
            if (!vehicleMap.has(vKey)) {
                vehicleMap.set(vKey, {
                    displayNumber: d.displayNumber,
                    plate: d.plate,
                    drivers: new Set(),
                    rows: [],
                });
            }
            const v = vehicleMap.get(vKey);
            if (d.driver) v.drivers.add(d.driver);
            v.rows.push(d);
        }

        const vehicles = Array.from(vehicleMap.values()).sort((a, b) =>
            String(a.displayNumber ?? '').localeCompare(String(b.displayNumber ?? ''), 'th', { numeric: true })
        );

        if (vehicles.length === 0) {
            this.addSimpleSheet(wb, 'ไม่มีข้อมูล', {
                title: '🧑‍🤝‍🧑 รายชื่อพนักงานที่นั่งรถแต่ละคัน',
                subtitleLines: [`ช่วงวันที่: ${startDate} ถึง ${endDate}`, 'ไม่พบข้อมูลในช่วงวันที่ที่เลือก'],
                columns: [{ label: '-', width: 20 }],
                rows: [],
            });
            return await wb.xlsx.writeBuffer();
        }

        for (const v of vehicles) {
            // เรียงตามวันที่ → รอบ → ชื่อ ให้อ่านง่าย
            const rows = v.rows.slice().sort((a, b) =>
                String(a.operationDate).localeCompare(String(b.operationDate)) ||
                String(a.shiftCode || '').localeCompare(String(b.shiftCode || '')) ||
                String(a.firstName || '').localeCompare(String(b.firstName || ''), 'th')
            );
            const totalFare = rows.reduce((s, r) => s + (r.fare || 0), 0);

            this.addSimpleSheet(wb, `เบอร์ ${v.displayNumber ?? '-'}`, {
                title: `🧑‍🤝‍🧑 รายชื่อพนักงานที่นั่งรถ — เบอร์ ${v.displayNumber ?? '-'}${v.plate ? ' (' + v.plate + ')' : ''}`,
                subtitleLines: [
                    `คนขับ: ${Array.from(v.drivers).join(', ') || '-'}`,
                    `ช่วงวันที่: ${startDate} ถึง ${endDate}  •  ทั้งหมด ${rows.length} รายการ (นับซ้ำได้ถ้าคนเดิมนั่งหลายวัน/หลายรอบ)`,
                ],
                columns: [
                    { label: 'วันที่', width: 12 },
                    { label: 'รอบ', width: 14 },
                    { label: 'เวลาสแกน', width: 10 },
                    { label: 'รหัสบัตร', width: 12 },
                    { label: 'ชื่อ', width: 14, align: 'left' },
                    { label: 'นามสกุล', width: 16, align: 'left' },
                    { label: 'แผนก', width: 14, align: 'left' },
                    { label: 'ค่ารถ', width: 12, currency: true },
                    { label: 'หมายเหตุ', width: 12 },
                ],
                rows: rows.map(d => [
                    d.operationDate, d.shiftName || d.shiftCode, d.scanTime || '-',
                    d.cardId, d.firstName, d.lastName, d.department, d.fare || 0, d.note
                ]),
                totalRow: ['รวมทั้งหมด', '', '', '', '', '', '', totalFare, ''],
            });
        }

        return await wb.xlsx.writeBuffer();
    }

    // ✅ Export Excel เฉพาะรถคันเดียว — ใช้ตอนกดดูรายละเอียดรถแล้วอยากได้ไฟล์แยกของคันนั้น
    //    ใช้ตารางคอลัมน์แบบเดียวกับ exportExcel (IN D / OUT N / 17:00 / 20:00) แต่กรองเหลือรถคันเดียว
    //    และแยกชีทรายวันเหมือนกันถ้าเลือกมากกว่า 1 วัน
    static async exportVehicleExcel(vehicleId, startDate, endDate) {
        const report = await this.getReport(startDate, endDate);
        const vId = Number(vehicleId);
        const vehicle = report.vehicles.find(v => v.vehicleId === vId);
        const vehicleTrips = report.trips
            .filter(t => t.vehicleId === vId)
            .sort((a, b) => String(a.operationDate).localeCompare(String(b.operationDate)) || String(a.shiftCode).localeCompare(String(b.shiftCode)));

        const displayNumber = vehicle?.displayNumber ?? vehicleId;
        const plate = vehicle?.plate ?? '-';
        const driver = vehicle?.driver ?? '-';

        const wb = new ExcelJS.Workbook();
        wb.creator = 'GA Dashboard';
        wb.created = new Date();

        const dates = Array.from(new Set(vehicleTrips.map(t => {
            let d = t.operationDate;
            if (d instanceof Date) d = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            else d = String(d).slice(0, 10);
            return d;
        }))).sort();

        if (dates.length > 1) {
            const summaryPivot = this.buildVehiclePivot(vehicleTrips);
            this.addPivotSheet(
                wb, summaryPivot, 'สรุปทั้งหมด',
                `🚐 สรุปค่ารถ — เบอร์ ${displayNumber} (${plate})`,
                [`คนขับหลัก: ${driver}`, `ช่วงวันที่: ${startDate} ถึง ${endDate}`]
            );

            for (const d of dates) {
                const dayTrips = vehicleTrips.filter(t => {
                    let td = t.operationDate;
                    if (td instanceof Date) td = `${td.getFullYear()}-${String(td.getMonth() + 1).padStart(2, '0')}-${String(td.getDate()).padStart(2, '0')}`;
                    else td = String(td).slice(0, 10);
                    return td === d;
                });
                const dayPivot = this.buildVehiclePivot(dayTrips);
                this.addPivotSheet(wb, dayPivot, d, `🚐 เบอร์ ${displayNumber} วันที่ ${d}`, [`วันที่: ${d}`]);
            }
        } else {
            const pivot = this.buildVehiclePivot(vehicleTrips);
            const label = dates[0] || `${startDate} - ${endDate}`;
            this.addPivotSheet(
                wb, pivot, 'รายงาน',
                `🚐 เบอร์ ${displayNumber} (${plate}) — วันที่ ${label}`,
                [`คนขับหลัก: ${driver}`, `วันที่: ${label}`]
            );
        }

        // ─── ชีทท้าย: รายละเอียดรายเที่ยว (ดิบ) ของคันนี้ ───
        this.addSimpleSheet(wb, 'รายละเอียด', {
            title: `📋 รายละเอียดการเดินรถ — เบอร์ ${displayNumber}`,
            subtitleLines: [`ช่วงวันที่: ${startDate} - ${endDate}`],
            columns: [
                { label: 'วันที่', width: 12 },
                { label: 'รอบ', width: 14 },
                { label: 'คนขับ (บัตร)', width: 14 },
                { label: 'ราคา/เที่ยว', width: 12, currency: true },
                { label: 'พนักงาน', width: 10 },
                { label: 'ค่ารวม', width: 14, currency: true },
            ],
            rows: vehicleTrips.map(t => [
                t.operationDate, t.shiftName || t.shiftCode, t.driverCardId || '-',
                t.fareUsed || 0, t.totalRiders || 0, t.totalFare || 0
            ]),
            totalRow: ['รวมทั้งหมด', '', '', '', '', vehicle?.totalFare || 0],
        });

        return await wb.xlsx.writeBuffer();
    }


