    static async importExcel(filePath, filename, importedBy, sourceType = 'employee_file') {
        const workbook = xlsx.readFile(filePath);
        const sheetName = workbook.SheetNames[0];
        const sheet = workbook.Sheets[sheetName];
        const rawData = xlsx.utils.sheet_to_json(sheet, { defval: '', raw: false });

        if (!rawData || rawData.length === 0) {
            throw new Error('ไฟล์ว่างเปล่า');
        }

        const headers = Object.keys(rawData[0]);
        console.log('📋 Headers:', headers);

        if (sourceType === 'driver_file') {
            const required = ['วันที่', 'เวลา', 'รหัสบัตรรูด', 'ชื่อ', 'นามสกุล'];
            const missing = required.filter(r => !headers.some(h => h.includes(r) || r.includes(h)));
            if (missing.length > 0) {
                throw new Error(`ไฟล์คนขับไม่ถูกต้อง: ขาดคอลัมน์ ${missing.join(', ')}`);
            }
            return await this.importDriverFile(rawData, filename, importedBy);
        }

        const colMap = {
            date: this.findColumn(headers, ['วันที่', 'Date', 'date']),
            time: this.findColumn(headers, ['เวลา', 'Time', 'time']),
            cardId: this.findColumn(headers, ['รหัสบัตร', 'รหัสบัตรรูด', 'cardId', 'Card ID']),
            name: this.findColumn(headers, ['ชื่อ', 'ชื่อ-นามสกุล', 'Full Name', 'Name']),
            lastName: this.findColumn(headers, ['นามสกุล', 'Last Name', 'LastName']),
            department: this.findColumn(headers, ['แผนก', 'Department', 'ส่วน']),
            vehicle: this.findColumn(headers, ['สายรถ', 'เบอร์รถ', 'รถ', 'Route', 'vehicle']),
            fare: this.findColumn(headers, ['ค่ารถ', 'Fare', 'ค่าโดยสาร']),
            shift: this.findColumn(headers, ['กะงาน', 'shift', 'รอบ']),
            destination: this.findColumn(headers, ['จุดหมาย', 'สถานที่', 'Address', 'destination']),
        };

        if (!colMap.cardId) {
            throw new Error('ไม่พบคอลัมน์รหัสบัตร (cardId)');
        }

        const importResult = await executeQuery(`
            INSERT INTO PayrollScanImports (filename, importedBy, totalRows, status, sourceType)
            OUTPUT INSERTED.id
            VALUES (@filename, @importedBy, @totalRows, 'pending', @sourceType)
        `, {
            filename,
            importedBy: importedBy || 'system',
            totalRows: rawData.length,
            sourceType: sourceType || 'employee_file'
        });

        const importId = importResult.recordset[0].id;

        let rowIndex = 0;
        for (const row of rawData) {
            rowIndex++;
            const cardId = colMap.cardId ? String(row[colMap.cardId] || '').trim() : '';
            if (!cardId) continue;

            const scanDate = this.parseDate(colMap.date ? row[colMap.date] : null);
            const scanTime = this.parseTime(colMap.time ? row[colMap.time] : null);
            const fareRaw = colMap.fare ? String(row[colMap.fare] || '').trim() : '';
            const shiftRaw = colMap.shift ? String(row[colMap.shift] || '').trim() : '';

            await executeQuery(`
                INSERT INTO PayrollScanRows (
                    importId, rowIndex, scanDate, scanTime, cardId,
                    firstName, lastName, departmentRaw, vehicleRaw,
                    fareRaw, shiftRaw, destinationRaw, 
                    sourceType, processedStatus
                ) VALUES (
                    @importId, @rowIndex, @scanDate, @scanTime, @cardId,
                    @firstName, @lastName, @departmentRaw, @vehicleRaw,
                    @fareRaw, @shiftRaw, @destinationRaw,
                    @sourceType, 'pending'
                )
            `, {
                importId,
                rowIndex,
                scanDate,
                scanTime,
                cardId,
                firstName: colMap.name ? String(row[colMap.name] || '').trim() : '',
                lastName: colMap.lastName ? String(row[colMap.lastName] || '').trim() : '',
                departmentRaw: colMap.department ? String(row[colMap.department] || '').trim() : '',
                vehicleRaw: colMap.vehicle ? String(row[colMap.vehicle] || '').trim() : '',
                fareRaw,
                shiftRaw,
                destinationRaw: colMap.destination ? String(row[colMap.destination] || '').trim() : '',
                sourceType: sourceType || 'employee_file'
            });
        }

        return { importId, totalRows: rawData.length, status: 'pending' };
    }

    // ─── IMPORT DRIVER FILE ───
    static async importDriverFile(fileRows, filename, importedBy) {
        const importResult = await executeQuery(`
            INSERT INTO PayrollScanImports (filename, importedBy, totalRows, status, sourceType)
            OUTPUT INSERTED.id
            VALUES (@filename, @importedBy, @totalRows, 'pending', 'driver_file')
        `, {
            filename,
            importedBy: importedBy || 'system',
            totalRows: fileRows.length
        });

        const importId = importResult.recordset[0].id;

        for (const row of fileRows) {
            const scanDate = this.parseDate(row['วันที่']);
            const scanTime = row['เวลา'] ? this.parseTime(row['เวลา']) : null;
            const cardId = String(row['รหัสบัตรรูด'] || '').trim();
            if (!cardId) continue;

            await executeQuery(`
                INSERT INTO PayrollScanRows (
                    importId, scanDate, scanTime, cardId, 
                    firstName, lastName, terminalRaw,
                    sourceType, processedStatus
                ) VALUES (
                    @importId, @scanDate, @scanTime, @cardId,
                    @firstName, @lastName, @terminalRaw,
                    'driver_file', 'pending'
                )
            `, {
                importId,
                scanDate,
                scanTime,
                cardId,
                firstName: row['ชื่อ'] || '',
                lastName: row['นามสกุล'] || '',
                terminalRaw: row['ชื่อเครื่อง'] || null
            });
        }

        return { importId, totalRows: fileRows.length, status: 'pending' };
    }

